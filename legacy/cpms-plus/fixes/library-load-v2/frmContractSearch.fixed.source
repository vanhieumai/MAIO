'================================================================
' EXPORT BUTTON
'
' [PERFORMANCE FIX]:
'   - Them Application.Calculation = xlCalculationManual truoc khi bat dau
'   - Them Application.EnableEvents = False truoc khi bat dau
'   - Them error handler CLEANUP_EXPORT dam bao Excel luon duoc khoi phuc
'     khi xay ra loi bat ky (tranh Excel bi treo vinh vien)
'================================================================
Private Sub btnExportRP_Click()

    On Error Resume Next
    If defaultWorkbook Is Nothing Then Set defaultWorkbook = GetUserWorkbook()
    If defaultWorkbook Is Nothing Then
        ShowMsgCenter "No user workbook detected. Please open a workbook first."
        Exit Sub
    End If
    
    Dim hasContent As Boolean
    hasContent = chkContractInfo.value Or chkDocTracking.value Or chkPayment.value _
             Or chkConsolidatedReport.value
    On Error GoTo 0

    If Not hasContent Then
        ShowMsgCenter "Please select at least one content type to export!" & vbCrLf & _
                      "(Contract Information / Document Tracking / Payment Report)"
        Exit Sub
    End If

    Dim contractList() As String
    Dim cCount As Long

    On Error Resume Next
    Dim useAll As Boolean
    useAll = chkSelectAll.value
    Dim useManual As Boolean
    useManual = chkSelectManual.value
    Dim inclCancel As Boolean
    inclCancel = chkIncludeCancel.value
    On Error GoTo 0

    ' --- Doc bo loc category de kiem soat B-CPB ---
    Dim expFilterCat As String: expFilterCat = ""
    On Error Resume Next
    If cboCategories.ListIndex > 0 Then expFilterCat = Trim$(cboCategories.value)
    On Error GoTo 0

    If useAll Then
        ReDim contractList(0 To lstResult.ListCount)
        cCount = 0
        Dim uiEx As Long
        For uiEx = 0 To lstResult.ListCount - 1
            Dim cExID As String
            cExID = Trim(CStr(lstResult.List(uiEx, 0)))
            If cExID <> "" And cExID <> "0" Then
                Dim keepEx As Boolean
                keepEx = True
                
                If Not inclCancel Then
                    On Error Resume Next
                    If Not gDictContract Is Nothing Then
                        If gDictContract.exists(cExID) Then
                            Dim rExRow As Long
                            rExRow = gDictContract(cExID)
                            If UCase(Trim(CStr(gArrContract(rExRow, 6)))) = "CANCEL" Then keepEx = False
                        End If
                    End If
                    On Error GoTo 0
                End If
                ' --- Chi xuat B-CPB khi cboCategories la All ---
                If expFilterCat <> "" Then
                    If Left$(UCase$(cExID), 5) = "B-CPB" Then keepEx = False
                End If
                If keepEx Then
                
                    contractList(cCount) = cExID
                    cCount = cCount + 1
                End If
            End If
        Next uiEx
    ElseIf useManual Then
        ReDim contractList(0 To lstResult.ListCount)
        cCount = 0
        Dim mRow As Long
        For mRow = 0 To lstResult.ListCount - 1
            If lstResult.Selected(mRow) Then
                Dim mID As String
                mID = Trim(CStr(lstResult.List(mRow, 0)))
                If mID <> "" And mID <> "0" Then
                    contractList(cCount) = mID
                    cCount = cCount + 1
                End If
            End If
        Next mRow
        If cCount = 0 Then
            ShowMsgCenter "No contracts selected!" & vbCrLf & "Please select one or more contracts in the list."
            Exit Sub
        End If
    Else
        If gCurrentContractID = "" Then
            ShowMsgCenter "No contract selected!"
            Exit Sub
        End If
        ReDim contractList(0 To 0)
        contractList(0) = gCurrentContractID
        cCount = 1
    End If

    If cCount = 0 Then
        ShowMsgCenter "No contracts match the selected criteria!"
        Exit Sub
    End If

    Dim filterMode  As String
    Dim filterMonth As Long
    Dim filterYear  As Long

    filterMode = "all"
    filterMonth = 0
    filterYear = 0

    On Error Resume Next
    If optMonthly.value Then
        filterMode = "monthly"
        filterMonth = mExpMonth
        filterYear = mExpYear
    ElseIf optYearly.value Then
        filterMode = "yearly"
        filterYear = mExpYear
    End If
    On Error GoTo 0

    If useAll And filterMode <> "all" Then
        Dim byPayment As Boolean
        byPayment = chkPayment.value
        If byPayment Then
            FilterListByPayment contractList, cCount, filterMode, filterMonth, filterYear, inclCancel
        Else
            FilterListBySigningDate contractList, cCount, filterMode, filterMonth, filterYear
        End If
        If cCount = 0 Then
            Me.MousePointer = fmMousePointerDefault
            ShowMsgCenter "No contracts found for the selected period!"
            Exit Sub
        End If
    End If

    On Error Resume Next
    'tabMain.value = 3
    On Error GoTo 0

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False
    Me.MousePointer = fmMousePointerHourGlass

    On Error GoTo CLEANUP_EXPORT

    ' -------------------------------------------------------
    ' Xac dinh co can tao sheet chi tiet khong
    ' (chi tao khi co it nhat 1 trong 3 muc nay duoc chon)
    ' -------------------------------------------------------
    Dim hasDetailContent As Boolean
    hasDetailContent = chkContractInfo.value Or chkDocTracking.value Or chkPayment.value

    Dim sheetOut As Worksheet
    Dim sheetLabel As String
    sheetLabel = ""

    If hasDetailContent Then
        If cCount = 1 Then
            sheetLabel = contractList(0)
        Else
            sheetLabel = "All"
        End If

        Select Case filterMode
            Case "monthly": sheetLabel = sheetLabel & "_T" & Format(filterMonth, "00") & "_" & filterYear
            Case "yearly":  sheetLabel = sheetLabel & "_" & filterYear
            Case Else:      sheetLabel = sheetLabel & "_" & Format(Now, "yyyymmdd")
        End Select

        If Len(sheetLabel) > 31 Then sheetLabel = Left$(sheetLabel, 31)

        On Error Resume Next
        Application.DisplayAlerts = False
        defaultWorkbook.sheets(sheetLabel).Delete
        Application.DisplayAlerts = True
        On Error GoTo CLEANUP_EXPORT
        Set sheetOut = defaultWorkbook.sheets.Add( _
            After:=defaultWorkbook.sheets(defaultWorkbook.sheets.count))
            
        sheetOut.Name = sheetLabel

        Dim NextRow As Long
        NextRow = 1

        '----------
        Dim sProjName As String: sProjName = ""
        Dim sLocation     As String: sLocation = ""
        Dim sContType As String: sContType = ""
        
        GetProjectInfo sProjName, sLocation
        ' --- Hang 1: Du an ---
        'sheetOut.Range(sheetOut.Cells(nextRow, 1), sheetOut.sheetOut(nextRow, 12)).UnMerge
        'sheetOut.Range(sheetOut.Cells(nextRow, 1), sheetOut.sheetOut(nextRow, 12)).Merge
        With sheetOut.Cells(NextRow, 1)
            .value = "Project: " & sProjName
            .Font.Bold = True
            .Font.Size = 12
            .HorizontalAlignment = xlLeft
            .VerticalAlignment = xlVAlignCenter
        End With
        sheetOut.rows(NextRow).RowHeight = 18
        NextRow = NextRow + 1
    
        ' --- Hang 2: Dia chi ---
        'sheetOut.Range(wsOut.Cells(nextRow, 1), sheetOut.Cells(nextRow, 12)).UnMerge
        'sheetOut.Range(wsOut.Cells(nextRow, 1), sheetOut.Cells(nextRow, 12)).Merge
        With sheetOut.Cells(NextRow, 1)
            .value = "Location: " & sLocation
            .Font.Size = 11
            .HorizontalAlignment = xlLeft
            .VerticalAlignment = xlVAlignCenter
        End With
        sheetOut.rows(NextRow).RowHeight = 16
        NextRow = NextRow + 1
    
    
        '--------------
        sheetOut.Range(sheetOut.Cells(NextRow, 1), sheetOut.Cells(NextRow, 12)).UnMerge
        sheetOut.Range(sheetOut.Cells(NextRow, 1), sheetOut.Cells(NextRow, 12)).Merge
        Dim titleStr As String
        If cCount = 1 Then
            titleStr = "REPORT: " & contractList(0)
        Else
            titleStr = "CONSOLIDATED REPORT (" & cCount & " CONTRACT(S))"
        End If

        Select Case filterMode
            Case "monthly": titleStr = titleStr & "  -  Month " & filterMonth & "/" & filterYear
            Case "yearly":  titleStr = titleStr & "  -  Year " & filterYear
        End Select

        With sheetOut.Cells(NextRow, 1)
            .value = titleStr
            .HorizontalAlignment = xlCenter
            .Font.Bold = True
            .Font.Size = 14
            .Font.Color = RGB(31, 73, 125)
        End With
        NextRow = NextRow + 1
        sheetOut.Cells(NextRow, 12).value = "Exported: " & Format(Now, "dd/mm/yyyy hh:mm")
        sheetOut.Cells(NextRow, 12).HorizontalAlignment = xlRight
        sheetOut.Cells(NextRow, 12).Font.Color = RGB(128, 128, 128)
        NextRow = NextRow + 1

        ' Khoi tao cot shadow truoc khi xuat bang
        SetupShadowCols sheetOut, cCount

        If chkContractInfo.value Then
            NextRow = ExportContractInfoSection(sheetOut, NextRow, contractList, cCount)
            NextRow = NextRow + 1
        End If

        If chkDocTracking.value Then
            NextRow = ExportDocTrackingSection(sheetOut, NextRow, contractList, cCount, _
                                               filterMode, filterMonth, filterYear)
            NextRow = NextRow + 1
        End If

        If chkPayment.value Then
            NextRow = ExportPaymentSection(sheetOut, NextRow, contractList, cCount, _
                                           filterMode, filterMonth, filterYear, inclCancel)
        End If

        sheetOut.UsedRange.EntireRow.AutoFit  ' AutoFit chieu cao dong dua tren cot shadow
        ClearShadowCols sheetOut              ' Xoa cot shadow sau khi AutoFit xong
        defaultWorkbook.Activate
        sheetOut.Activate
        ActiveWindow.DisplayGridlines = False
    End If

    Dim consSheetName As String
    consSheetName = ""
    If chkConsolidatedReport.value Then
        Dim sheetCons As Worksheet
        consSheetName = "Consolidated_" & Format(Now, "yyyymmdd_hhmmss")
        If Len(consSheetName) > 31 Then consSheetName = Left$(consSheetName, 31)
        On Error Resume Next
        Application.DisplayAlerts = False
        defaultWorkbook.sheets(consSheetName).Delete
        Application.DisplayAlerts = True
        On Error GoTo CLEANUP_EXPORT
        Set sheetCons = defaultWorkbook.sheets.Add( _
            After:=defaultWorkbook.sheets(defaultWorkbook.sheets.count))
            
        sheetCons.Name = consSheetName
        ExportConsolidatedSummary sheetCons, contractList, cCount
        'sheetCons.Columns.AutoFit
        defaultWorkbook.Activate       ' ? 1. activate workbook
        sheetCons.Activate             ' ? 2. activate sheet
        sheetCons.Cells(1, 1).Select
        sheetCons.Activate
        ActiveWindow.DisplayGridlines = False
    End If
    
    'sheetOut.Activate
    'ActiveWindow.DisplayGridlines = False
    Application.EnableEvents = True
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Me.MousePointer = fmMousePointerDefault

    Dim doneMsg As String
    doneMsg = "Export completed!"
    If sheetLabel <> "" Then doneMsg = doneMsg & vbCrLf & "Sheet: " & sheetLabel
    If consSheetName <> "" Then doneMsg = doneMsg & vbCrLf & "Consolidated: " & consSheetName
    ShowMsgCenter doneMsg

    Exit Sub

CLEANUP_EXPORT:
    Dim errNum As Long: errNum = Err.Number
    Dim errDesc As String: errDesc = Err.Description
    On Error Resume Next
    Application.EnableEvents = True
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Me.MousePointer = fmMousePointerDefault
    On Error GoTo 0
    If errNum <> 0 Then
        ShowMsgCenter "Export error: " & errDesc
    End If

End Sub


'================================================================
' BUILD FULL CONTRACT LIST BY CONDITION
'================================================================
Private Sub BuildAllContractList(contractList() As String, _
                                  ByRef cCount As Long, _
                                  ByVal inclCancel As Boolean, _
                                  Optional ByVal filterCat As String = "")
    cCount = 0
    If IsEmpty(gArrContract) Then Exit Sub

    ReDim contractList(0 To UBound(gArrContract, 1) + 200)

    Dim i As Long
    For i = 1 To UBound(gArrContract, 1)
        Dim cid As String
        cid = Trim$(CStr(gArrContract(i, 1)))
        If cid = "" Or cid = "GROUP-A" Or cid = "GROUP-B" Then GoTo NEXT_BLD
        If Not inclCancel Then
            If UCase$(Trim$(CStr(gArrContract(i, 6)))) = "CANCEL" Then GoTo NEXT_BLD
        End If
        contractList(cCount) = cid
        cCount = cCount + 1
NEXT_BLD:
    Next i

    If Not IsEmpty(gArrPayment) Then
        Dim dSeen As Object
        Set dSeen = CreateObject("Scripting.Dictionary")
        Dim j As Long
        For j = 0 To cCount - 1
            dSeen(contractList(j)) = 1
        Next j
        ' Chi them B-CPB tu payment ledger khi filterCat = "" (All)
        If filterCat = "" Then
            For i = 1 To UBound(gArrPayment, 1)
                Dim pCID As String
                pCID = Trim$(CStr(gArrPayment(i, 3)))
                If (Left$(pCID, 2) = "A-" Or Left$(pCID, 2) = "B-") _
                And Trim$(CStr(gArrPayment(i, 2))) = "" _
                And Not dSeen.exists(pCID) Then
                    If gDictContract Is Nothing _
                    Or Not gDictContract.exists(pCID) Then
                        If cCount > UBound(contractList) Then
                            ReDim Preserve contractList(0 To UBound(contractList) + 100)
                        End If
                        contractList(cCount) = pCID
                        dSeen(pCID) = 1
                        cCount = cCount + 1
                    End If
                End If
            Next i
        End If
        Set dSeen = Nothing
    End If
    
End Sub

'================================================================
' INIT FAST
'================================================================
Public Sub InitFast()
    If isLoading Then Exit Sub

    On Error GoTo SAFE_EXIT

    isLoading = True

    ' *** FIX: N?u d?i project thì force rebuild, dù flag còn True ***
    Dim curPID As String
    curPID = Trim$(ReadCurrentProjectValue("ProjectID"))
    If curPID <> gCacheProjectID Then
        ' Reset flags — DataSession dã open (OpenSession ch?y trong UserForm_Initialize r?i)
        gContractLoaded = False
        gPaymentLoaded = False
        gPaymentEntryLoaded = False
        gBCPBLoaded = False
        gDocLoaded = False
    End If

    If Not gContractLoaded Then
        BuildGlobalContractCache
    End If

    DoEvents

    LoadContractList

SAFE_EXIT:
    isLoading = False
    ' Ghi nh? project c?a cache v?a build
    gCacheProjectID = Trim$(ReadCurrentProjectValue("ProjectID"))

    ' ---- M?I: sau khi load xong toàn b?, dua con tr? vào ô tìm ki?m ----
    On Error Resume Next
    Me.txtKeyword.SetFocus
    On Error GoTo 0

End Sub

'================================================================
' LOAD CONTRACT LIST
'================================================================
Public Sub LoadContractList(Optional ByVal keyword As String = "")

    On Error GoTo ERR_HANDLER

    Dim kw As String
    Dim filterCat As String
    Dim i As Long
    Dim total As Long
    Dim arrFinal() As Variant
    Dim r1 As Long
    Dim r2 As Long
    Dim c As Long
    Dim tmp(0 To 5) As Variant

    Me.MousePointer = fmMousePointerHourGlass

    lstResult.Clear

    ' *** Clear panel ngay l?p t?c — n?u có contract s? du?c fill l?i sau ***
    ClearInfoDetail
    gCurrentContractID = ""
    On Error Resume Next
    'lblDetailContractNo.Caption = ""
    'lblDetailBankAcc.Caption = ""
    'lblDetailBankName.Caption = ""
    btnSummary.Caption = ""
    'txtSummary.Text = ""
    lstDocument.Clear
    ClearDocDetail
    On Error GoTo ERR_HANDLER

    If IsEmpty(gArrContract) Then GoTo SAFE_EXIT

    kw = LCase(VN_NoSign(keyword))

    ' Doc bo loc category tu cboCategories
    filterCat = ""
    On Error Resume Next
    If cboCategories.ListIndex > 0 Then
        filterCat = Trim$(cboCategories.value)
    End If
    On Error GoTo 0

    ReDim arrFinal(0 To UBound(gArrContract, 1), 0 To 5)

    total = 0

    For i = 1 To UBound(gArrContract, 1)

        If Trim$(CStr(gArrContract(i, 1))) <> "GROUP-A" _
        And Trim$(CStr(gArrContract(i, 1))) <> "GROUP-B" Then

            If (filterCat = "" Or Trim$(CStr(gArrContract(i, 18))) = filterCat) _
            And (kw = "" _
            Or InStr(LCase(VN_NoSign(CStr(gArrContract(i, 1)))), kw) > 0 _
            Or InStr(LCase(VN_NoSign(CStr(gArrContract(i, 2)))), kw) > 0 _
            Or InStr(LCase(VN_NoSign(CStr(gArrContract(i, 7)))), kw) > 0 _
            Or InStr(LCase(VN_NoSign(CStr(gArrContract(i, 8)))), kw) > 0 _
            Or InStr(LCase(VN_NoSign(CStr(gArrContract(i, 11)))), kw) > 0) Then

                arrFinal(total, 0) = Trim$(CStr(gArrContract(i, 1)))

                Dim sttText As String
                sttText = Trim$(CStr(gArrContract(i, 24)))

                If UCase$(Trim$(CStr(gArrContract(i, 6)))) = "CANCEL" Then
                    sttText = sttText & "(x)"
                End If

                arrFinal(total, 1) = sttText
                arrFinal(total, 2) = Trim$(CStr(gArrContract(i, 2)))
                arrFinal(total, 3) = FastVN(gArrContract(i, 15))
                arrFinal(total, 4) = Trim$(CStr(gArrContract(i, 6)))
                arrFinal(total, 5) = CLng(val(gArrContract(i, 25)))

                total = total + 1

            End If

        End If

    Next i

    If total <= 0 Then GoTo SAFE_EXIT

    For r1 = 0 To total - 2
        For r2 = r1 + 1 To total - 1
            If CLng(arrFinal(r2, 5)) < CLng(arrFinal(r1, 5)) Then
                For c = 0 To 5
                    tmp(c) = arrFinal(r1, c)
                    arrFinal(r1, c) = arrFinal(r2, c)
                    arrFinal(r2, c) = tmp(c)
                Next c
            End If
        Next r2
    Next r1

    Dim lastGroup As String
    Dim currentGroup As String
    Dim displayArr() As Variant
    Dim outRow As Long

    ReDim displayArr(0 To total * 2, 0 To 5)

    lastGroup = ""
    outRow = 0

    For r1 = 0 To total - 1

        If Left$(CStr(arrFinal(r1, 1)), 2) = "A-" Then
            currentGroup = "A"
        Else
            currentGroup = "B"
        End If

        If lastGroup <> "" And currentGroup <> lastGroup Then
            displayArr(outRow, 0) = "0"
            displayArr(outRow, 1) = "++++++"
            displayArr(outRow, 2) = "++++++++++++++++++++++++++++"
            displayArr(outRow, 3) = "++++++++++++++++"
            displayArr(outRow, 4) = "++++++++++++++++"
            displayArr(outRow, 5) = 0
            outRow = outRow + 1
        End If

        lastGroup = currentGroup

        For c = 0 To 5
            displayArr(outRow, c) = arrFinal(r1, c)
        Next c

        outRow = outRow + 1

    Next r1

    Dim finalArr() As Variant
    Dim rr As Long
    Dim cc As Long

    ReDim finalArr(0 To outRow - 1, 0 To 5)

    For rr = 0 To outRow - 1
        For cc = 0 To 5
            finalArr(rr, cc) = displayArr(rr, cc)
        Next cc
    Next rr

    lstResult.List = finalArr

    If lstResult.ListCount > 0 Then
        suppressListClick = True

        ' Bo qua group header (contractID = "0"), chon dong hop dong dau tien thuc su
        Dim autoContractID As String: autoContractID = ""
        Dim autoRowIdx As Long: autoRowIdx = -1
        Dim ri As Long
        For ri = 0 To lstResult.ListCount - 1
            Dim tmpCID As String
            tmpCID = Trim$(CStr(lstResult.List(ri, 0)))
            If tmpCID <> "" And tmpCID <> "0" Then
                autoRowIdx = ri
                autoContractID = tmpCID
                Exit For
            End If
        Next ri

        If autoRowIdx >= 0 Then
            lstResult.ListIndex = autoRowIdx
        Else
            lstResult.ListIndex = 0
        End If

        suppressListClick = False

        ' FIX: lstResult_Click khong fire khi suppressListClick=True hoac chi 1 ket qua
        ' -> cap nhat thu cong tab dang hien thi, giong cach da fix cho Document tab
        If autoContractID <> "" Then
            LoadContractDetail autoContractID
            If tabMain.value = 1 Then LoadDocumentList autoContractID
        End If
    End If

SAFE_EXIT:

    ' [NEW] Khi không có contract nào ? hi?n th? dòng g?i ý chu?t ph?i
    If lstResult.ListCount = 0 Then
        Dim ph(0 To 0, 0 To 5) As Variant
        ph(0, 0) = ""                                               ' contractID (hidden)
        ph(0, 1) = ""                                               ' STT
        ph(0, 2) = "  >> Right-click here to add a Contract <<"    ' Description column
        ph(0, 3) = ""
        ph(0, 4) = ""
        ph(0, 5) = 0
        lstResult.List = ph
    End If

    If tabMain.value = 4 Then LoadProgressTab      ' ? THÊM: refresh sau search
    Me.MousePointer = fmMousePointerDefault
    Exit Sub

ERR_HANDLER:
    ShowMsgCenter "Export error (line " & Erl & "): " & Err.Description
    Resume SAFE_EXIT

End Sub
Private Sub lstResult_MouseDown( _
    ByVal Button As Integer, _
    ByVal Shift As Integer, _
    ByVal X As Single, _
    ByVal Y As Single)

    On Error GoTo ERRH   ' <-- B?T BU?C: không có cái này l?i s? close h?t form

    If Button <> 2 Then Exit Sub   ' Ch? x? lý chu?t ph?i

    ' ---- MOI: gia lap 1 cu click chuot TRAI ngay tai vi tri hien tai ----
    ' De Windows tu chon dung dong y het nhu bam chuot trai that,
    ' khong can tu tinh toan dong nao nua.
    mouse_event MOUSEEVENTF_LEFTDOWN, 0, 0, 0, 0
    mouse_event MOUSEEVENTF_LEFTUP, 0, 0, 0, 0

    DoEvents   ' cho Windows xu ly xong cu click gia (lstResult_Click se
               ' tu chay va cap nhat dung ListIndex + LoadContractDetail)

    Dim idx As Long
    idx = lstResult.ListIndex

    Dim contractID As String
    contractID = ""

    If idx >= 0 Then
        Dim cid As String
        On Error Resume Next
        cid = Trim$(CStr(lstResult.List(idx, 0)))
        On Error GoTo ERRH
        If cid <> "" And cid <> "0" Then contractID = cid
    End If

    ' -- CASE 1: Có contract ? m? d? xem/s?a --------------------
    If contractID <> "" Then
        Dim fEdit As New frmContractEdit
        fEdit.SetSearchRef Me
        fEdit.LoadContractFromSearch contractID
        fEdit.Show vbModeless
        Exit Sub
    End If

    ' -- CASE 2: Placeholder / header ? h?i Group r?i Add m?i ---
    '   PH?I dùng MsgBox g?c (KHÔNG dùng MsgCenter/frmMsg2)
    '   Vì g?i modal UserForm t? modeless form event s? close h?t form
    Dim userChoice As VbMsgBoxResult
    userChoice = MsgBox( _
        "Which type of contract do you want to create?" & vbCrLf & vbCrLf & _
        "YES  —  Contract with INVESTOR (Group A)" & vbCrLf & _
        "NO   —  Contract with SUBCONTRACTOR (Group B)", _
        vbYesNoCancel + vbQuestion, "Select Contract Type")

    If userChoice = vbCancel Then Exit Sub

    Dim fNew As New frmContractEdit
    fNew.SetSearchRef Me
    fNew.OpenInAddMode (userChoice = vbYes)
    fNew.Show vbModeless

    Exit Sub

ERRH:
    MsgBox "Right-click error: " & Err.Description & vbCrLf & _
           "(Line: " & Erl & ")", vbCritical, "Error"

End Sub


'================================================================
' LOAD CONTRACT DETAIL (Tab Contract)
'================================================================
Private Sub LoadContractDetail(ByVal contractID As String, _
                               Optional ByVal refreshActiveTab As Boolean = True)
    gCurrentContractID = contractID
    LoadSummaryBox ""

    Dim r As Long
    If gDictContract Is Nothing Then Exit Sub
    If Not gDictContract.exists(contractID) Then Exit Sub
    r = gDictContract(contractID)

    ClearInfoDetail
    DrawInfoDetail r
    LoadSummaryBox contractID

    ' A payment-row click must not rebuild its own ListBox.
    If Not refreshActiveTab Then Exit Sub

    ' Actual page order: Information, Document, Library, Payment,
    ' Progress, Export. MultiPage indexes start at zero.
    Select Case tabMain.value
        Case 2
            LoadLibraryPage
        Case 3
            LoadPaymentTab contractID
        Case 5
            UpdateExportPreview
    End Select
End Sub


Private Sub ClearInfoDetail()
    On Error Resume Next
    Dim ctrl As MSForms.Control
    Dim toDel() As String
    ReDim toDel(0 To fraInfoDetail.Controls.count)
    Dim nDel As Long: nDel = 0
    For Each ctrl In fraInfoDetail.Controls
        If Left$(ctrl.Name, 7) = "DYN_ID_" Then
            toDel(nDel) = ctrl.Name
            nDel = nDel + 1
        End If
    Next ctrl
    Dim j As Long
    For j = 0 To nDel - 1
        fraInfoDetail.Controls.Remove toDel(j)
    Next j
    fraInfoDetail.ScrollHeight = fraInfoDetail.Height
    On Error GoTo 0
End Sub


'================================================================
' DrawInfoDetail — V? n?i dung contract lên fraInfoDetail
' G?i sau khi dã xác d?nh row r trong gArrContract
'================================================================
Private Sub DrawInfoDetail(ByVal r As Long)

    On Error GoTo ERR_DRAW_ID
    ClearInfoDetail

    Dim frm As MSForms.Frame
    Set frm = fraInfoDetail
    frm.ScrollTop = 0
    
    Dim sFontName As String
    sFontName = frm.Font.Name
    
    Dim wTotal As Single
    wTotal = frm.InsideWidth - 4
    If wTotal < 80 Then wTotal = 80
    frm.ScrollHeight = 2000
    
    '---- Layout constants --------------------------------------
    Const ID_ROW_H  As Single = 14    ' chi?u cao 1 dòng
    Const ID_HDR_H  As Single = 9    ' chi?u cao section header
    Const ID_W_LBL  As Single = 72    ' d? r?ng c?t nhãn
    Const ID_GAP    As Single = 1     ' kho?ng cách gi?a các dòng
    Const ID_GAP_S  As Single = 1     ' kho?ng cách sau section header

    Dim wVal As Single
    wVal = wTotal - ID_W_LBL

    Dim Y As Single: Y = 1

    '---- Ð?c d? li?u -------------------------------------------
    Dim contractNo  As String: contractNo = Trim(CStr(gArrContract(r, 2)))
    Dim category    As String: category = Trim(CStr(gArrContract(r, 18)))
    Dim scopeW      As String: scopeW = Trim(CStr(gArrContract(r, 11)))
    Dim partyA      As String: partyA = Trim(CStr(gArrContract(r, 7)))
    Dim partyB      As String
    If Trim(CStr(gArrContract(r, 9))) <> "" Then
        partyB = Trim(CStr(gArrContract(r, 8))) & " | " & Trim(CStr(gArrContract(r, 9)))
    Else
        partyB = Trim(CStr(gArrContract(r, 8)))
    End If
    Dim repA        As String: repA = Trim(CStr(gArrContract(r, 16)))
    Dim repB        As String
    If Trim(CStr(gArrContract(r, 10))) <> "" Then
        repB = Trim(CStr(gArrContract(r, 17))) & " | " & Trim(CStr(gArrContract(r, 10)))
    Else
        repB = Trim(CStr(gArrContract(r, 17)))
    End If
    Dim contactB    As String: contactB = Trim(CStr(gArrContract(r, 22)))
    Dim sigDate     As String: sigDate = ""
    Dim endDate     As String: endDate = ""
    If IsDate(gArrContract(r, 4)) Then sigDate = Format(gArrContract(r, 4), "dd/mm/yyyy")
    If IsDate(gArrContract(r, 5)) Then endDate = Format(gArrContract(r, 5), "dd/mm/yyyy")
    Dim giaTri      As String: giaTri = FastVN(gArrContract(r, 15))
    Dim statusVal   As String: statusVal = Trim(CStr(gArrContract(r, 6)))
    Dim payee       As String: payee = Trim(CStr(gArrContract(r, 19)))
    Dim bankAcc     As String: bankAcc = Trim(CStr(gArrContract(r, 20)))
    Dim bankName    As String: bankName = Trim(CStr(gArrContract(r, 21)))

    '---- Màu s?c theo status -----------------------------------
    Dim clrHdr  As Long, clrHdrTxt As Long
    Dim clrRow1 As Long, clrRow2   As Long
    Select Case UCase(Trim(statusVal))
        Case "ACTIVE"
            clrHdr = RGB(31, 73, 125):         clrHdrTxt = RGB(255, 255, 255)
            clrRow1 = RGB(220, 235, 255):      clrRow2 = RGB(205, 224, 255)
        Case "COMPLETED"
            clrHdr = RGB(13, 120, 54):         clrHdrTxt = RGB(255, 255, 255)
            clrRow1 = RGB(229, 245, 229):      clrRow2 = RGB(210, 235, 210)
        Case "CANCEL"
            clrHdr = RGB(192, 0, 0):           clrHdrTxt = RGB(255, 255, 255)
            clrRow1 = RGB(255, 220, 220):      clrRow2 = RGB(255, 200, 200)
        Case Else
            clrHdr = RGB(80, 80, 80):          clrHdrTxt = RGB(255, 255, 255)
            clrRow1 = RGB(240, 240, 240):      clrRow2 = RGB(228, 228, 228)
    End Select

    '---- Helper n?i tuy?n: thêm 1 dòng Label + TextBox --------
    ' (dùng bi?n d?m toàn c?c cho tên unique)
    Dim idxRow  As Long: idxRow = 0
    Dim useClr  As Long

    '==============================================================
    ' SECTION 1: CONTRACT INFO
    '==============================================================
    Call ID_AddSectionHeader(frm, "DYN_ID_S0", "CONTRACT", _
                             Y, wTotal, ID_HDR_H, clrHdr, clrHdrTxt, sFontName)
    Y = Y + ID_HDR_H + ID_GAP_S

    ' --- Build displayNo: dùng col 24 (X) có d?ng "A-1.2" ---
    Dim displayNo   As String: displayNo = contractNo
    Dim cidSeq      As String: cidSeq = Trim(CStr(gArrContract(r, 24)))
    Dim rootNo      As String: rootNo = ""
    Dim anChain     As String: anChain = ""

    ' Xây dict ngu?c: seq (col 24) -> row index
    Dim dictSeq As Object
    Set dictSeq = CreateObject("Scripting.Dictionary")
    Dim iSeq As Long
    For iSeq = 1 To UBound(gArrContract, 1)
        Dim seqK As String: seqK = Trim(CStr(gArrContract(iSeq, 24)))
        If seqK <> "" Then dictSeq(seqK) = iSeq
    Next iSeq

    If InStr(cidSeq, ".") > 0 Then
        Dim tmpSeq  As String: tmpSeq = cidSeq
        Do While InStr(tmpSeq, ".") > 0
            Dim ldp As Long: ldp = 0
            Dim kk  As Long
            For kk = Len(tmpSeq) To 1 Step -1
                If mID(tmpSeq, kk, 1) = "." Then ldp = kk: Exit For
            Next kk
            If ldp = 0 Then Exit Do
            tmpSeq = Left(tmpSeq, ldp - 1)
            If InStr(tmpSeq, ".") > 0 Then
                ' Ancestor trung gian (e.g. APP-06)
                If dictSeq.exists(tmpSeq) Then
                    Dim anR As Long:   anR = dictSeq(tmpSeq)
                    Dim anN As String: anN = Trim(CStr(gArrContract(anR, 2)))
                    If anN <> "" Then
                        If anChain = "" Then anChain = anN _
                        Else anChain = anChain & "." & anN
                    End If
                End If
            Else
                ' Root ancestor (e.g. 68/2022/HDKT/CHC1/VEC)
                If dictSeq.exists(tmpSeq) Then
                    Dim rootR As Long: rootR = dictSeq(tmpSeq)
                    rootNo = Trim(CStr(gArrContract(rootR, 2)))
                End If
            End If
        Loop
    End If

    If anChain <> "" Then displayNo = contractNo & " (" & anChain & ")"
    Dim isAPPorPKG As Boolean
    isAPPorPKG = (UCase(Left(contractNo, 4)) = "APP-" Or UCase(Left(contractNo, 4)) = "PKG-")
    If isAPPorPKG And rootNo <> "" Then displayNo = displayNo & "  —  " & rootNo

    If contractNo <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Number", displayNo, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If


    If category <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Category", category, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If

    If scopeW <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Dim scopeH As Single: scopeH = ID_ROW_H * 2.2  ' Scope thu?ng dài
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Scope of Work", scopeW, _
                       Y, ID_W_LBL, wVal, scopeH, useClr, sFontName)
        Y = Y + scopeH + ID_GAP: idxRow = idxRow + 1
    End If

    '==============================================================
    ' SECTION 2: PARTIES
    '==============================================================
    Y = Y + ID_GAP_S
    Call ID_AddSectionHeader(frm, "DYN_ID_S1", "PARTIES", _
                             Y, wTotal, ID_HDR_H, clrHdr, clrHdrTxt, sFontName)
    Y = Y + ID_HDR_H + ID_GAP_S

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                   " Party A", partyA, _
                   Y, ID_W_LBL, wVal, ID_ROW_H * 1.5, useClr, sFontName)
    Y = Y + ID_ROW_H * 1.5 + ID_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                   " Party B", partyB, _
                   Y, ID_W_LBL, wVal, ID_ROW_H * 1.5, useClr, sFontName)
    Y = Y + ID_ROW_H * 1.5 + ID_GAP: idxRow = idxRow + 1

    If repA <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Rep A", repA, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If

    If repB <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Rep B", repB, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If

    If contactB <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Contact B", contactB, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If

    '==============================================================
    ' SECTION 3: DATES / VALUE / STATUS
    '==============================================================
    Y = Y + ID_GAP_S
    Call ID_AddSectionHeader(frm, "DYN_ID_S2", "DATES & VALUE", _
                             Y, wTotal, ID_HDR_H, clrHdr, clrHdrTxt, sFontName)
    Y = Y + ID_HDR_H + ID_GAP_S

    If sigDate <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Sign Date", sigDate, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If

    If endDate <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " End Date", endDate, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If

    If giaTri <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Value", giaTri, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If

    If statusVal <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                       " Status", statusVal, _
                       Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
        Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
    End If

    '==============================================================
    ' SECTION 4: BANKING (ch? v? n?u có ít nh?t 1 field)
    '==============================================================
    If payee <> "" Or bankAcc <> "" Or bankName <> "" Then

        Y = Y + ID_GAP_S
        Call ID_AddSectionHeader(frm, "DYN_ID_S3", "BANKING", _
                                 Y, wTotal, ID_HDR_H, clrHdr, clrHdrTxt, sFontName)
        Y = Y + ID_HDR_H + ID_GAP_S

        If payee <> "" Then
            useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
            Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                           " Payee", payee, _
                           Y, ID_W_LBL, wVal, ID_ROW_H * 1.5, useClr, sFontName)
            Y = Y + ID_ROW_H * 1.5 + ID_GAP: idxRow = idxRow + 1
        End If

        If bankAcc <> "" Then
            useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
            Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                           " Account No", bankAcc, _
                           Y, ID_W_LBL, wVal, ID_ROW_H, useClr, sFontName)
            Y = Y + ID_ROW_H + ID_GAP: idxRow = idxRow + 1
        End If

        If bankName <> "" Then
            useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
            Call ID_AddRow(frm, "DYN_ID_R" & idxRow, _
                           " Bank", bankName, _
                           Y, ID_W_LBL, wVal, ID_ROW_H * 2, useClr, sFontName)
            Y = Y + ID_ROW_H * 1.5 + ID_GAP: idxRow = idxRow + 1
        End If

    End If

    frm.ScrollHeight = Y + 4
    Exit Sub

ERR_DRAW_ID:
    ShowMsgCenter "DrawInfoDetail Error: " & Err.Description
End Sub


'================================================================
' HELPER: Thêm 1 section header label vào frame
'================================================================
Private Sub ID_AddSectionHeader( _
    ByVal frm As MSForms.Frame, _
    ByVal ctrlName As String, _
    ByVal Caption As String, _
    ByVal Y As Single, _
    ByVal w As Single, _
    ByVal h As Single, _
    ByVal backClr As Long, _
    ByVal foreClr As Long, _
    ByVal sFontName As String)        ' ? THÊM PARAM NÀY

    Dim lHdr As MSForms.Label
    Set lHdr = frm.Controls.Add("Forms.Label.1", ctrlName)
    With lHdr
        .Caption = "  " & Caption
        .Left = 1:  .Top = Y:  .Width = w:  .Height = h
        .Font.Name = sFontName        ' ? dùng cached string, không dùng frm.Font.Name
        .Font.Bold = True
        .Font.Size = 7
        .ForeColor = foreClr
        .BackColor = backClr:   .BackStyle = 1
        .TextAlign = fmTextAlignLeft
    End With
End Sub


'================================================================
' HELPER: Thêm 1 dòng Label (trái, bold) + TextBox (ph?i, locked)
'================================================================
Private Sub ID_AddRow( _
    ByVal frm As MSForms.Frame, _
    ByVal baseName As String, _
    ByVal labelText As String, _
    ByVal valueText As String, _
    ByVal Y As Single, _
    ByVal wLbl As Single, _
    ByVal wVal As Single, _
    ByVal rowH As Single, _
    ByVal backClr As Long, _
    ByVal sFontName As String, _
    Optional sFontSize As Single = 8.5) ' font size (default 8.5)

    ' --- Label trái ---
    Dim lLbl As MSForms.Label
    Set lLbl = frm.Controls.Add("Forms.Label.1", baseName & "_L")
    With lLbl
        .Caption = labelText
        .Left = 1:  .Top = Y:  .Width = wLbl:  .Height = rowH
        .Font.Name = sFontName        ' ? cached string
        .Font.Bold = True
        .Font.Size = sFontSize
        .ForeColor = RGB(50, 50, 50)
        .BackColor = backClr:   .BackStyle = 1
        .TextAlign = fmTextAlignLeft
    End With

    ' --- TextBox ph?i ---
    Dim lVal As MSForms.TextBox
    Set lVal = frm.Controls.Add("Forms.TextBox.1", baseName & "_V")
    With lVal
        .Text = valueText
        .Left = wLbl + 2:  .Top = Y:  .Width = wVal:  .Height = rowH
        .Font.Name = sFontName        ' ? cached string
        .Font.Bold = False            ' ? explicit, không ph? thu?c default
        .Font.Size = sFontSize
        .ForeColor = RGB(30, 30, 30)
        .BackColor = backClr
        .BorderStyle = fmBorderStyleNone
        .SpecialEffect = fmSpecialEffectFlat
        .MultiLine = True
        .WordWrap = True
        .Locked = True
        .TabStop = False
        .ScrollBars = fmScrollBarsNone
        .EnterKeyBehavior = False
    End With

End Sub

Private Function BuildInfoText(ByVal r As Long) As String

    Dim s As String
    s = ""

    Dim sep As String
    sep = "  " & String(42, "-") & vbCrLf

    ' -- CONTRACT / CATEGORY -----------------------------------
    Dim contractNo As String
    contractNo = Trim(CStr(gArrContract(r, 2)))
    If contractNo <> "" Then s = s & InfoRow("Contract", contractNo)

    Dim loai As String
    loai = Trim(CStr(gArrContract(r, 18)))          ' col R
    If loai <> "" Then s = s & InfoRow("Category", loai)
    Dim scope As String
    scope = Trim(CStr(gArrContract(r, 11)))
    If scope <> "" Then s = s & InfoRow("Scope of Work", scope)

    s = s & sep

    ' -- PARTY A / PARTY B ------------------------------------
    s = s & InfoRow("Party A", Trim(CStr(gArrContract(r, 7))))
    If Trim(CStr(gArrContract(r, 9))) <> "" Then
        s = s & InfoRow("Party B", Trim(CStr(gArrContract(r, 8))) & " | " & Trim(CStr(gArrContract(r, 9))))
    Else
        s = s & InfoRow("Party B", Trim(CStr(gArrContract(r, 8))))
    End If
    's = s & vbCrLf

    ' -- REP A / REP B / CONTACT B ----------------------------
    Dim repA As String, repB As String, hdpsB As String
    repA = Trim(CStr(gArrContract(r, 16)))          ' col P
    If Trim(CStr(gArrContract(r, 10))) <> "" Then
        repB = Trim(CStr(gArrContract(r, 17)) & " | " & Trim(CStr(gArrContract(r, 10))))         ' col Q
    Else
        repB = Trim(CStr(gArrContract(r, 17)))
    End If
    hdpsB = Trim(CStr(gArrContract(r, 22)))         ' col V

    If repA <> "" Then s = s & InfoRow("Rep A", repA)
    If repB <> "" Then s = s & InfoRow("Rep B", repB)
    If hdpsB <> "" Then s = s & InfoRow("Contact B", hdpsB)

    s = s & sep

    ' -- DATES / VALUE / STATUS -------------------------------
    Dim sigDate As String, endDate As String
    sigDate = ""
    endDate = ""
    If IsDate(gArrContract(r, 4)) Then sigDate = Format(gArrContract(r, 4), "dd/mm/yyyy")
    If IsDate(gArrContract(r, 5)) Then endDate = Format(gArrContract(r, 5), "dd/mm/yyyy")

    s = s & InfoRow("Sign Date", sigDate)
    If endDate <> "" Then s = s & InfoRow("End Date", endDate)

    Dim giaTri As String
    giaTri = FastVN(gArrContract(r, 15))
    If giaTri <> "" Then s = s & InfoRow("Value", giaTri)

    Dim status As String
    status = Trim(CStr(gArrContract(r, 6)))
    If status <> "" Then s = s & InfoRow("Status", status)

    s = s & sep

    ' -- BANKING ----------------------------------------------
    Dim payee As String, bankAcc As String, bankName As String
    payee = Trim(CStr(gArrContract(r, 19)))
    bankAcc = Trim(CStr(gArrContract(r, 20)))
    bankName = Trim(CStr(gArrContract(r, 21)))

    If payee <> "" Or bankAcc <> "" Or bankName <> "" Then
        's = s & "  BANKING" & vbCrLf
        If payee <> "" Then s = s & InfoRow("Payee", payee)
        If bankAcc <> "" Then s = s & InfoRow("Account No", bankAcc)
        If bankName <> "" Then s = s & InfoRow("Bank", bankName)
        's = s & sep
    End If

    BuildInfoText = s

End Function



'================================================================
'================================================================
' ClearDocDetail — Xoa toan bo controls DYN_DD_* trong fraDocDetail
'================================================================
Private Sub ClearDocDetail()
    On Error Resume Next
    Dim ctrl As MSForms.Control
    Dim toDel() As String
    ReDim toDel(0 To fraDocDetail.Controls.count)
    Dim nDel As Long: nDel = 0
    For Each ctrl In fraDocDetail.Controls
        If Left$(ctrl.Name, 7) = "DYN_DD_" Then
            toDel(nDel) = ctrl.Name
            nDel = nDel + 1
        End If
    Next ctrl
    Dim j As Long
    For j = 0 To nDel - 1
        fraDocDetail.Controls.Remove toDel(j)
    Next j
    fraDocDetail.ScrollHeight = fraDocDetail.Height
    On Error GoTo 0
End Sub

'================================================================
' DrawDocDetail — Ve noi dung chi tiet document len fraDocDetail
'================================================================
Private Sub DrawDocDetail( _
    ByVal docType As String, _
    ByVal docName As String, _
    ByVal docNo As String, _
    ByVal statusVal As String, _
    ByVal dateLabel1 As String, _
    ByVal date1 As String, _
    ByVal dateLabel2 As String, _
    ByVal date2 As String, _
    ByVal sendTo As String, _
    ByVal version As String, _
    ByVal attachments As String, _
    ByVal lnk As String, _
    ByVal noteVal As String)

    On Error GoTo ERR_DRAW_DD
    ClearDocDetail

    Dim frm As MSForms.Frame
    Set frm = fraDocDetail

    Dim sFontName As String
    sFontName = frm.Font.Name
    
    '---- Layout ----
    Const DD_ROW_H  As Single = 14   ' chieu cao toi thieu moi dong
    Const DD_HDR_H  As Single = 15   ' chieu cao header
    Const DD_W_LBL  As Single = 72   ' do rong cot nhan
    Const DD_GAP    As Single = 1    ' khoang cach giua cac dong
    Const DD_SB_W   As Single = 0    ' scrollbar margin

    Dim wTotal As Single
    wTotal = frm.InsideWidth - 2 - DD_SB_W
    If wTotal < 80 Then wTotal = 80

    Dim wVal As Single
    wVal = wTotal - DD_W_LBL - 2

    Dim Y As Single: Y = 1

    '---- Zero-pad so document neu la so nguyen ----
    Dim displayNo As String
    If IsNumeric(docNo) And InStr(docNo, ".") = 0 Then
        displayNo = Format(CLng(docNo), "00")
    Else
        displayNo = docNo
    End If

    '---- Mau sac theo status ----
    Dim clrHdr  As Long, clrHdrTxt As Long
    Dim clrRow1 As Long, clrRow2   As Long
    Select Case UCase(Trim(statusVal))
        Case "COMPLETED", "ACCEPTED"
            clrHdr = RGB(0, 112, 0):       clrHdrTxt = RGB(255, 255, 255)
            clrRow1 = RGB(229, 245, 229):  clrRow2 = RGB(210, 235, 210)
        Case "IN PROGRESS", "PROCESSING"
            clrHdr = RGB(31, 73, 125):     clrHdrTxt = RGB(255, 255, 255)
            clrRow1 = RGB(220, 235, 255):  clrRow2 = RGB(205, 224, 255)
        Case "PENDING", "WAITING"
            clrHdr = RGB(153, 102, 0):     clrHdrTxt = RGB(255, 255, 255)
            clrRow1 = RGB(255, 245, 210):  clrRow2 = RGB(255, 235, 185)
        Case Else
            clrHdr = RGB(80, 80, 80):      clrHdrTxt = RGB(255, 255, 255)
            clrRow1 = RGB(240, 240, 240):  clrRow2 = RGB(228, 228, 228)
    End Select

    '==================================================================
    '  HEADER: Type & Doc No. (zero-padded)
    '==================================================================
    Dim lHdr As MSForms.Label
    Set lHdr = frm.Controls.Add("Forms.Label.1", "DYN_DD_HDR")
    With lHdr
        .Caption = "  " & docType & "  " & displayNo
        .Left = 1: .Top = Y: .Width = wTotal: .Height = DD_HDR_H
        ' FIX: Bold truoc Size, khong set Font.Name (tranh MSForms reset)
        .Font.Name = sFontName
        .Font.Bold = True
        .Font.Size = 8.5
        .ForeColor = clrHdrTxt
        .BackColor = clrHdr: .BackStyle = 1
        .TextAlign = fmTextAlignLeft
    End With
    Y = Y + DD_HDR_H + DD_GAP

    '==================================================================
    '  STATUS badge
    '==================================================================
    Dim lSt As MSForms.Label
    Set lSt = frm.Controls.Add("Forms.Label.1", "DYN_DD_STATUS")
    With lSt
        .Caption = "  Status: " & statusVal
        .Left = 1: .Top = Y: .Width = wTotal: .Height = DD_ROW_H
        ' FIX: Bold truoc Size
        .Font.Name = sFontName
        .Font.Bold = True
        .Font.Size = 8.5
        .ForeColor = clrHdrTxt
        .BackColor = clrHdr: .BackStyle = 1
        .TextAlign = fmTextAlignLeft
    End With
    Y = Y + DD_ROW_H + DD_GAP * 3

    '==================================================================
    '  ROWS: nhan (Label trai) + gia tri (TextBox phai, wrap + copy)
    '  Chieu cao co dinh theo loai field -- tranh uoc tinh sai
    '  Field co noi dung dai: scrollbar doc
    '==================================================================
    Dim ddLabels(0 To 8) As String
    Dim ddValues(0 To 8) As String
    ddLabels(0) = " Name":        ddValues(0) = docName
    ddLabels(1) = " Doc No.":     ddValues(1) = displayNo
    ddLabels(2) = " " & dateLabel1:    ddValues(2) = date1
    ddLabels(3) = " " & dateLabel2:    ddValues(3) = date2
    ddLabels(4) = " Send To":     ddValues(4) = sendTo
    ddLabels(5) = " Version":     ddValues(5) = version
    ddLabels(6) = " Attachments": ddValues(6) = attachments
    ddLabels(7) = " Link":        ddValues(7) = lnk
    ddLabels(8) = " Note":        ddValues(8) = noteVal

    ' --- Chieu cao co dinh (diem) theo tung loai field ---
    ' fi: 0=Name 1=DocNo 2=Date1 3=Date2 4=SendTo 5=Ver 6=Att 7=Link 8=Note
    Dim ddRowH(0 To 8) As Single
    ddRowH(0) = DD_ROW_H * 1.5   ' Name  -- 2 dong, giam font neu qua dai
    ddRowH(1) = DD_ROW_H       ' Doc No.
    ddRowH(2) = DD_ROW_H       ' Date 1
    ddRowH(3) = DD_ROW_H       ' Date 2
    ddRowH(4) = DD_ROW_H       ' Send To
    ddRowH(5) = DD_ROW_H       ' Version
    ddRowH(6) = DD_ROW_H       ' Attachments
    ddRowH(7) = DD_ROW_H * 2.5   ' Link  -- co the dai (2 dong)
    ddRowH(8) = DD_ROW_H * 2.3   ' Note  -- co the dai (2 dong)

    ' --- Field nao co scrollbar doc (de xem khi noi dung vuot chieu cao) ---
    ' 0=Name, 7=Link, 8=Note
    Dim ddScroll(0 To 8) As Long
    ddScroll(0) = fmScrollBarsVertical
    ddScroll(7) = fmScrollBarsVertical
    ddScroll(8) = fmScrollBarsVertical

    Dim fi As Long
    For fi = 0 To 8
        Dim useClr As Long
        If fi Mod 2 = 0 Then useClr = clrRow1 Else useClr = clrRow2

        Dim rowH As Single: rowH = ddRowH(fi)

        ' --- Nhan (trai, Label, bold) ---
        Dim lLbl As MSForms.Label
        Set lLbl = frm.Controls.Add("Forms.Label.1", "DYN_DD_L" & fi)
        With lLbl
            .Caption = ddLabels(fi)
            .Left = 1: .Top = Y: .Width = DD_W_LBL: .Height = rowH
            ' FIX: Bold truoc Size
            .Font.Name = sFontName
            .Font.Bold = True
            .Font.Size = 8.5
            .ForeColor = RGB(50, 50, 50)
            .BackColor = useClr: .BackStyle = 1
            .TextAlign = fmTextAlignLeft
        End With
                  
        ' --- Gia tri (phai, TextBox -- WordWrap + Copy) ---
        Dim lVal As MSForms.TextBox
        Set lVal = frm.Controls.Add("Forms.TextBox.1", "DYN_DD_V" & fi)
        With lVal
            .Text = ddValues(fi)
            .Left = DD_W_LBL + 2: .Top = Y: .Width = wVal: .Height = rowH
            ' FIX: Chi set Size (Bold=False da la default TextBox)
            ' Name (fi=0): giam font neu text dai
            .Font.Name = frm.Font.Name
            .Font.Name = sFontName
            .Font.Bold = False          ' ? explicit, không ph? thu?c vào inherited state
            If fi = 0 And Len(ddValues(fi)) > 38 Then
                .Font.Size = 7
            Else
                .Font.Size = 8.5
            End If
            .ForeColor = RGB(30, 30, 30)
            .BackColor = useClr
            .BorderStyle = fmBorderStyleNone
            .SpecialEffect = fmSpecialEffectFlat
            .MultiLine = True
            .WordWrap = True
            .Locked = True
            .TabStop = False
            .ScrollBars = ddScroll(fi)
            .EnterKeyBehavior = False
        End With

        Y = Y + rowH + DD_GAP
    Next fi

    frm.ScrollHeight = Y + 4
    Exit Sub

ERR_DRAW_DD:
    ShowMsgCenter "DrawDocDetail Error: " & Err.Description
End Sub
' HELPER: dinh dang hang cho txtDocDetail (LW=22)
'================================================================
Private Function DocRow(ByVal lbl As String, ByVal val As String) As String
    Const LW As Integer = 12
    Dim padded As String
    If Len(lbl) >= LW Then
        padded = Left$(lbl, LW)
    Else
        padded = lbl & Space$(LW - Len(lbl))
    End If
    DocRow = padded & Chr(9) & ": " & val & vbCrLf
End Function
'================================================================
' LOAD DOCUMENT LIST
'================================================================
Public Sub LoadDocumentList(ByVal contractID As String, _
                            Optional ByVal selectDocID As String = "")

    On Error GoTo ERR_HANDLER

    gCurrentContractID = contractID

    lstDocument.Clear
    ClearDocDetail

    ' --- Doc trang thai bo loc ---
    Dim showOnlyIPC    As Boolean
    Dim showOnlyOther  As Boolean
    Dim showSpecific   As Boolean
    Dim filterSpecific As String
    showOnlyIPC = False
    showOnlyOther = False
    showSpecific = False
    filterSpecific = ""

    On Error Resume Next
    If optIPC.value = True Then
        showOnlyIPC = True
        cboDocType.Enabled = False
    ElseIf optPDR.value = True Then
        showOnlyOther = True
        cboDocType.Enabled = True
        If cboDocType.ListIndex >= 0 Then
            filterSpecific = UCase(Trim$(CStr(cboDocType.value)))
            If filterSpecific <> "" Then showSpecific = True
        End If
    Else
        cboDocType.Enabled = False
    End If
    On Error GoTo ERR_HANDLER

    Dim ws As Worksheet
    On Error Resume Next
    Set ws = GetDataSheet("DOCUMENT_TRACKER")
    On Error GoTo ERR_HANDLER

    If ws Is Nothing Then
        ShowMsgCenter "Sheet DOCUMENT_TRACKER not found!"
        Exit Sub
    End If

    Dim lastRow As Long
    lastRow = ws.Cells(ws.rows.count, "A").End(xlUp).Row
    If lastRow < 2 Then GoTo SAFE_EXIT

    ' --- 1 VONG LAP DUY NHAT: fill thang vao buffer dong ---
    ' Pre-allocate du lon, se trim sau
    Dim raw() As Variant
    ReDim raw(0 To lastRow - 2, 0 To 6)   ' toi da = so dong data

    Dim idx As Long
    idx = 0
    Dim i As Long
    Dim dTyp As String
    Dim sNhan As String, sTra As String

    For i = 2 To lastRow
        If UCase(Trim$(CStr(ws.Cells(i, "B").value))) = _
           UCase(Trim$(contractID)) Then

            dTyp = UCase(Trim$(CStr(ws.Cells(i, "C").value)))

            ' Ap dung filter
            Dim passFilter As Boolean
            If showOnlyIPC Then
                passFilter = (dTyp = "IPC")
            ElseIf showSpecific Then
                passFilter = (dTyp = filterSpecific)
            ElseIf showOnlyOther Then
                passFilter = (dTyp <> "IPC")
            Else
                passFilter = True
            End If

            If passFilter Then
                If IsDate(ws.Cells(i, "I").value) Then
                    sNhan = Format(ws.Cells(i, "I").value, "dd/mm/yy")
                Else
                    sNhan = Trim$(CStr(ws.Cells(i, "I").value))
                End If
                If IsDate(ws.Cells(i, "J").value) Then
                    sTra = Format(ws.Cells(i, "J").value, "dd/mm/yy")
                Else
                    sTra = Trim$(CStr(ws.Cells(i, "J").value))
                End If

                raw(idx, 0) = Trim$(CStr(ws.Cells(i, "C").value))   ' doc type
                raw(idx, 1) = Trim$(CStr(ws.Cells(i, "D").value))   ' doc number (raw)
                raw(idx, 2) = sNhan                                   ' received date
                raw(idx, 3) = sTra                                    ' returned date
                raw(idx, 4) = Trim$(CStr(ws.Cells(i, "O").value))   ' status
                raw(idx, 5) = Trim$(CStr(ws.Cells(i, "N").value))   ' version
                raw(idx, 6) = Trim$(CStr(ws.Cells(i, "A").value))   ' docID (hidden)
                idx = idx + 1
            End If
        End If
    Next i

    If idx = 0 Then GoTo SAFE_EXIT

    ' --- Sap xep bang bubble sort (dung idx, khong phai total) ---
    Dim r1 As Long, r2 As Long, c As Long
    Dim tmp(0 To 6) As Variant
    Dim g1 As Long, g2 As Long
    Dim doSwap As Boolean

    For r1 = 0 To idx - 2
        For r2 = r1 + 1 To idx - 1
            g1 = DocHoSoGroup(CStr(raw(r1, 0)))
            g2 = DocHoSoGroup(CStr(raw(r2, 0)))
            doSwap = False
            If g2 < g1 Then
                doSwap = True
            ElseIf g1 = g2 Then
                If ExtractFirstNumber(CStr(raw(r2, 1))) < _
                   ExtractFirstNumber(CStr(raw(r1, 1))) Then
                    doSwap = True
                End If
            End If
            If doSwap Then
                For c = 0 To 6
                    tmp(c) = raw(r1, c)
                    raw(r1, c) = raw(r2, c)
                    raw(r2, c) = tmp(c)
                Next c
            End If
        Next r2
    Next r1

    ' --- Xay dung arr hien thi (dung idx) ---
    Dim arr() As Variant
    ReDim arr(0 To idx - 1, 0 To 7)

    Dim sttCounter As Long
    sttCounter = 0

    For i = 0 To idx - 1
        sttCounter = sttCounter + 1
        arr(i, 0) = CStr(sttCounter)
        arr(i, 1) = raw(i, 0)                                        ' doc type
        arr(i, 2) = FormatDocListNumber(CStr(raw(i, 0)), CStr(raw(i, 1))) ' so hien thi
        arr(i, 3) = raw(i, 2)                                        ' received
        arr(i, 4) = raw(i, 3)                                        ' returned
        arr(i, 5) = raw(i, 4)                                        ' status
        arr(i, 6) = raw(i, 5)                                        ' version
        arr(i, 7) = raw(i, 6)                                        ' docID (hidden)
    Next i

    lstDocument.List = arr

    If lstDocument.ListCount > 0 Then
        Dim selIdx As Long
        selIdx = lstDocument.ListCount - 1

        If selectDocID <> "" Then
            Dim si As Long
            For si = 0 To lstDocument.ListCount - 1
                If CStr(lstDocument.List(si, 7)) = selectDocID Then
                    selIdx = si
                    Exit For
                End If
            Next si
        End If

        lstDocument.ListIndex = selIdx
        LoadDocumentDetail CStr(lstDocument.List(selIdx, 7))
    End If

SAFE_EXIT:
    Exit Sub

ERR_HANDLER:
    ShowMsgCenter "LoadDocumentList Error: " & Err.Description
    Resume SAFE_EXIT

End Sub


Private Function DocHoSoGroup(ByVal hoSo As String) As Long
    Dim h As String
    h = UCase(Trim(hoSo))
    Select Case h
        Case "HD", "CON":       DocHoSoGroup = 1
        Case "PLHD", "APP":                  DocHoSoGroup = 2
        Case "IPC", "THANH TOAN":    DocHoSoGroup = 3
        Case Else:                    DocHoSoGroup = 4
    End Select
End Function

Private Function ExtractFirstNumber(ByVal s As String) As Double
    Dim result As String
    Dim i As Long
    Dim ch As String
    result = ""
    For i = 1 To Len(s)
        ch = mID(s, i, 1)
        If ch >= "0" And ch <= "9" Then
            result = result & ch
        ElseIf result <> "" Then
            Exit For
        End If
    Next i
    If result = "" Then
        ExtractFirstNumber = 0
    Else
        ExtractFirstNumber = CDbl(result)
    End If
End Function

'================================================================
' LOAD DOCUMENT DETAIL
' Nhom A: Type, Name, Document Number, Status,
'         Processed, Completed, Send To, Version,
'         Supporting Documents, Link, Note
' Nhom B: Type, Name, Document Number, Status,
'         Received, Returned/Completed, Send To, Version,
'         Supporting Documents, Link, Note
'================================================================
Public Sub LoadDocumentDetail(ByVal documentID As String)

    On Error GoTo ERR_HANDLER

    ClearDocDetail

    If Trim(documentID) = "" Then Exit Sub

    Dim ws As Worksheet
    On Error Resume Next
    Set ws = GetDataSheet("DOCUMENT_TRACKER")
    On Error GoTo ERR_HANDLER

    If ws Is Nothing Then Exit Sub

    Dim lastRow As Long
    lastRow = ws.Cells(ws.rows.count, "A").End(xlUp).Row

    Dim i As Long

    For i = 2 To lastRow

        If Trim(CStr(ws.Cells(i, "A").value)) = Trim(documentID) Then

            ' ---- Date fields ----
            Dim nhanNgay As String
            Dim traNgay As String

            If IsDate(ws.Cells(i, "I").value) Then
                nhanNgay = Format(ws.Cells(i, "I").value, "dd/mm/yyyy")
            Else
                nhanNgay = Trim(CStr(ws.Cells(i, "I").value))
            End If

            If IsDate(ws.Cells(i, "J").value) Then
                traNgay = Format(ws.Cells(i, "J").value, "dd/mm/yyyy")
            Else
                traNgay = Trim(CStr(ws.Cells(i, "J").value))
            End If

            ' ---- Status ----
            Dim tinhTrang As String
            tinhTrang = Trim(CStr(ws.Cells(i, "O").value))

            ' ---- Detect Group A or B from current contract ID ----
            Dim grp As String
            grp = "B"   ' default
            Dim cidUpper As String
            cidUpper = UCase(Trim(gCurrentContractID))
            If Left$(cidUpper, 2) = "A-" Then
                grp = "A"
            ElseIf Left$(cidUpper, 2) = "B-" Then
                grp = "B"
            Else
                On Error Resume Next
                Dim tmpGrp As String
                tmpGrp = GetGroupFromContractArr(gCurrentContractID)
                If Err.Number = 0 And tmpGrp <> "" Then grp = UCase(tmpGrp)
                Err.Clear
                On Error GoTo ERR_HANDLER
            End If

            ' ---- Xac dinh label ngay theo nhom ----
            Dim dLabel1 As String, dLabel2 As String
            If grp = "A" Then
                dLabel1 = "Processed"
                dLabel2 = "Completed"
            Else
                dLabel1 = "Received"
                If UCase(tinhTrang) = "COMPLETED" Then
                    dLabel2 = "Completed"
                Else
                    dLabel2 = "Returned"
                End If
            End If

            DrawDocDetail _
                Trim(CStr(ws.Cells(i, "C").value)), _
                Trim(CStr(ws.Cells(i, "E").value)), _
                Trim(CStr(ws.Cells(i, "D").value)), _
                tinhTrang, _
                dLabel1, nhanNgay, _
                dLabel2, traNgay, _
                Trim(CStr(ws.Cells(i, "K").value)), _
                Trim(CStr(ws.Cells(i, "N").value)), _
                Trim(CStr(ws.Cells(i, "M").value)), _
                Trim(CStr(ws.Cells(i, "F").value)), _
                Trim(CStr(ws.Cells(i, "P").value))

            Exit For

        End If

    Next i

    Exit Sub

ERR_HANDLER:
    ShowMsgCenter "LoadDocumentDetail Error: " & Err.Description

End Sub



