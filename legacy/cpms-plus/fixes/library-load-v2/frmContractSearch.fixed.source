'================================================================
' PH?N 1 — Thay do?n lstResult_DblClick trong frmContractSearch
'
' Tìm do?n cu:
'
'   Private Sub lstResult_DblClick(ByVal Cancel As MSForms.ReturnBoolean)
'       ...
'       LinkKL.LoadContractFromSearch contractID
'       Me.Hide
'   End Sub
'
' Thay b?ng do?n du?i dây:
'================================================================

Private Sub lstResult_DblClick(ByVal Cancel As MSForms.ReturnBoolean)

    Dim idx As Long
    idx = lstResult.ListIndex
    If idx < 0 Then Exit Sub

    '-- b? qua dòng group header ------------------------------
    If CStr(lstResult.List(idx, 0)) = "0" Or _
       Trim(CStr(lstResult.List(idx, 0))) = "" Then
        ShowMsgCenter "Please select a contract item, not a group header."
        Cancel = True
        Exit Sub
    End If

    Dim contractID As String
    contractID = Trim(CStr(lstResult.List(idx, 0)))
    If contractID = "" Then Exit Sub

    '-- m? frmPaymentSummary va chon dung contract -------------
    '   (giong het logic cua btnPaymentSummary_Click)
    Unload frmPaymentSummary
    Set frmPaymentSummary = Nothing

    frmPaymentSummary.Show vbModeless
    frmPaymentSummary.InitFast
    DoEvents

    frmPaymentSummary.SelectContract contractID

End Sub


Private Sub lstResult_Click()
    If mLibMetaEditing Or mLibraryLoading Or mResultClickBusy Then Exit Sub
    If suppressListClick Then Exit Sub
    mResultClickBusy = True
    On Error GoTo ClickFailed
    LibraryTrace "lstResult_Click: begin"
    Dim contractID As String
    If lstResult.ListIndex < 0 Then GoTo SAFE_EXIT
    contractID = CStr(lstResult.List(lstResult.ListIndex, 0))
    If contractID = "0" Then
        LoadSummaryBox ""
        GoTo SAFE_EXIT
    End If
    gCurrentContractID = contractID
    LibraryTrace "lstResult_Click: detail begin"
    LoadContractDetail contractID, False
    LibraryTrace "lstResult_Click: detail done"
    'If tabMain.value = 1 Then
    '    If optPDR.value Then LoadDocTypeComboCS contractID
    '    LoadDocumentList contractID
    'End If
    'If tabMain.value = 2 Then
    '    RefreshLibraryMeta          ' [FIX] cap nhat Subcontractor khi doi contract
    '    RefreshAllLibraryLabels
    'End If
    If tabMain.value = 1 Then

        If gCurrentContractID <> "" Then
            LoadDocumentList gCurrentContractID
        ElseIf lstResult.ListIndex >= 0 Then
            Dim cid As String
            cid = CStr(lstResult.List(lstResult.ListIndex, 0))
            If cid <> "0" Then
                LoadDocumentList cid
            End If
        End If

    End If
    If tabMain.value = 2 Then LoadLibraryPage 'InitPaymentTab
    If tabMain.value = 3 Then InitPaymentTab 'InitExportTab
    If tabMain.value = 4 Then LoadProgressTab
    If tabMain.value = 5 Then InitExportTab 'LoadLibraryPage
    
SAFE_EXIT:
    mResultClickBusy = False
    LibraryTrace "lstResult_Click: complete"
    Exit Sub
ClickFailed:
    LibraryTrace "lstResult_Click ERROR " & Err.Number & ": " & Err.Description
    MsgBox "Cannot display the selected contract: " & Err.Description, vbExclamation, "CPMS"
    Resume SAFE_EXIT
End Sub
Private Function WorksheetExists(ByVal sheetName As String) As Boolean
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = GetDataWorkbook().Worksheets(sheetName)
    WorksheetExists = Not ws Is Nothing
    On Error GoTo 0
End Function

Private Sub UserForm_Activate()
    ' Guard: only run once per form session.
    If mSettingsChecked Then Exit Sub
    mSettingsChecked = True

    ' License check
    If Not IsActivated() Then
        MsgCenter "Software is not activated or license is invalid." & vbCrLf & _
               "Please contact your vendor to activate.", _
               vbCritical, "License Error"
        Unload Me
        Exit Sub
    End If

    CheckProjectSettings
    ApplyTheme Me
    'UnregisterForm Me
End Sub

'================================================================
' INITIALIZE
' [MOD] lstPayment ColumnWidths: hien thi cot Paid (col 6)
'       Cau hinh: DN(25) | Date(55) | Description(150) |
'                 Actual(0-an) | Accepted(0-an) | Requested(0-an) |
'                 Paid(75) | Remaining(0-an) | Note(50)
'       De hien thi them cot Actual/Accepted/Requested/Remaining,
'       thay gia tri 0 pt tuong ung bang do rong mong muon (vd: 75 pt).
'================================================================
Private Sub UserForm_Initialize()
    ' ? Luôn detect l?i — không dùng "Is Nothing" guard
    ' vì defaultWorkbook có th? dã b? set b?i form khác tru?c dó
    Dim twb As Workbook
    Set twb = ActiveWorkbook
    If Not twb Is Nothing Then
        If Not twb.IsAddin And twb.Name <> ThisWorkbook.Name Then
            Set defaultWorkbook = twb
        End If
    End If
    If defaultWorkbook Is Nothing Then Set defaultWorkbook = GetUserWorkbook()
    
    OpenSession
    
    Dim wsCurrent As Worksheet
    Dim ws As Worksheet
    Dim NeedCreate As Boolean
    Application.ScreenUpdating = False
    
    Set wsCurrent = ActiveSheet

    'Ki?m tra 3 sheet h? th?ng
    If Not WorksheetExists("Contract_DB") Then
        EnsureContractDB
        NeedCreate = True
    End If
    
    If Not WorksheetExists("Payment_Ledger") Then
        EnsurePaymentLedger
        NeedCreate = True
    End If
    
    If Not WorksheetExists("Document_Tracker") Then
        EnsureDocumentTracker
        NeedCreate = True
    End If

    'Quay v? sheet ban d?u
    If NeedCreate Then wsCurrent.Activate

    Set ws = wsCurrent
    Application.ScreenUpdating = True
    
    With lstResult
        .ColumnCount = 6
        .ColumnWidths = "0 pt;45 pt;170 pt;85 pt;50 pt;0 pt"
    End With

    With lstDocument
        .ColumnCount = 8
        .ColumnWidths = "18 pt;50 pt;45 pt;55 pt;55 pt;75 pt;25 pt;0 pt"
    End With

    optAll.value = True
    optPayAllTime = True
    optAllTime = True

    'With txtDocDetail
    '    .Font.Name = "Lucida Console"
    '    .Font.Size = 9
    'End With

    ' [MOD] Hien thi cot Paid (col 6) va Note (col 8)
    ' Col: 0=DN, 1=Date, 2=Description, 3=Actual, 4=Accepted,
    '      5=Requested, 6=Paid, 7=Remaining, 8=Note
    With lstPayment
        .ColumnCount = 9
        .ColumnWidths = "25 pt;55 pt;150 pt;0 pt;0 pt;0 pt;75 pt;0 pt;0 pt"
    End With

    ' Thêm vào cu?i UserForm_Initialize (sau dòng lstPayment ColumnWidths)
    lstPayment.IntegralHeight = False
    lstDocument.IntegralHeight = False

    With txtExportPreview
        .Font.Name = "Lucida Console"
        .Font.Size = 9
    End With
    ' Khoi tao bo loc cboCategories (Contract Category - col R)
    On Error Resume Next
    With cboCategories
        .Clear
        .AddItem "(All)"
        .AddItem "Design & Build"
        .AddItem "Construction"
        .AddItem "Procurement"
        .AddItem "Consultancy"
        .AddItem "Design"
        .AddItem "Equipment"
        .AddItem "Service"
        .AddItem "Maintenance"
        .AddItem "Rental"
        .ListIndex = 0
    End With
    On Error GoTo 0
    
    'LoadProjectSettingLabels

    tabMain.value = 0
    gCurrentContractID = ""
    
    UpdateReminderButtonColor
    EnsureLibraryDB
    Dim sProjName As String, sLocation As String
    GetProjectInfo sProjName, sLocation
    lblDetailProject.Caption = IIf(sProjName <> "", sProjName, "")
    lblDetailLocation.Caption = IIf(sLocation <> "", sLocation, "")

End Sub

'================================================================
' CHECK PROJECT SETTINGS ON FORM OPEN
' Shows frmProjectinfo ONCE to capture both fields.
'================================================================
'================================================================
' CHECK PROJECT SETTINGS ON FORM OPEN
' Ð?c PROJ_NAME / Location t? PROJECT_SETTINGS và c?p nh?t labels.
' KHÔNG h?i l?i frmProjectInfo — d? li?u dã du?c ghi khi open project.
'================================================================
Private Sub CheckProjectSettings()

    Const SHEET_NAME As String = "PROJECT_SETTINGS"
    Const KEY_NAME   As String = "PROJ_NAME"
    Const KEY_LOC    As String = "LOCATION"

    Dim wsPS As Worksheet
    On Error Resume Next
    Set wsPS = GetDataSheet(SHEET_NAME)
    On Error GoTo 0
    If wsPS Is Nothing Then Exit Sub

    Dim i As Long, lastR As Long
    Dim sProjName As String, sLocation As String

    lastR = wsPS.Cells(wsPS.rows.count, 1).End(xlUp).Row
    For i = 1 To lastR
        Dim k As String
        k = UCase$(Trim$(CStr(wsPS.Cells(i, 1).value)))
        If k = KEY_NAME Then sProjName = Trim$(CStr(wsPS.Cells(i, 2).value))
        If k = KEY_LOC Then sLocation = Trim$(CStr(wsPS.Cells(i, 2).value))
    Next i

    lblDetailProject.Caption = sProjName
    lblDetailLocation.Caption = sLocation

End Sub

