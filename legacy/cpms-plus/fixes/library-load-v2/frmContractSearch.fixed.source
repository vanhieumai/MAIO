Attribute VB_Name = "frmContractSearch"
Attribute VB_Base = "0{B617FA83-4A42-4E33-8BC1-10E340AD5B32}{C067A94E-7C0E-4236-AE71-B395FDF3D106}"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Attribute VB_TemplateDerived = False
Attribute VB_Customizable = False

'================================================================
' FORM MODULE: frmContractSearch
'
' [PERFORMANCE FIX] Cac thay doi so voi ban goc:
'
'   1. LoadPaymentTabAllContracts — Pass 2:
'      Xay dictFirstDate (mapping contractID -> ngay dau tien co le)
'      truoc vong lap Pass 2, thay vi vong lap long For hh = 1 To UBound(...)
'      ben trong moi iteration. Do phuc tap giam tu O(n*m) xuong O(n+m).
'
'   2. btnExport_Click:
'      Them Application.Calculation = xlCalculationManual va
'      Application.EnableEvents = False de tang toc khi ghi nhieu o.
'      Them error handler CLEANUP_EXPORT dam bao Excel luon duoc
'      khoi phuc trang thai binh thuong ngay ca khi xay ra loi.
'
' [MOD] Cac thay doi moi:
'
'   3. lstPayment: Bo sung hien thi cot Paid (col 6) bang cach cap nhat
'      ColumnWidths trong UserForm_Initialize. Hien thi: DN, Date,
'      Description, Paid, Note.
'
'   4. Thay chkPaySelectAll bang 2 checkbox rieng: chkPayAllA (chon tat ca
'      hop dong nhom A) va chkPayAllB (chon tat ca hop dong nhom B).
'      Co the chon mot hoac ca hai cung luc.
'
'   5. Khi chon All A hoac All B: tu dong sap xep cac payment ledger
'      theo ngay tang dan (SortBufferByDate).
'
'   6. txtPayDetail: Bo sung dong hien thi so luong payment da loc duoc
'      theo tuy chon hien tai.
'================================================================
Option Explicit

Private Declare PtrSafe Function LibReleaseCapture Lib "user32" Alias "ReleaseCapture" () As Long
Private mLibMetaEditing As Boolean
Private mLibraryLoading As Boolean
Private mLibraryLabelsLoading As Boolean
Private mResultClickBusy As Boolean

' ---- API gia lap click chuot trai ----
Private Declare PtrSafe Sub mouse_event Lib "user32" ( _
    ByVal dwFlags As Long, ByVal dx As Long, ByVal dy As Long, _
    ByVal cButtons As Long, ByVal dwExtraInfo As LongPtr)
    
Private Const MOUSEEVENTF_LEFTDOWN As Long = &H2
Private Const MOUSEEVENTF_LEFTUP As Long = &H4

Private isLoading As Boolean
Private suppressListClick As Boolean
Private gCurrentContractID As String
Private mProgressLabelHandlers As Collection

Private mRightClickCount As Long
Private mRightClickTime  As Double

Private mDocEditForm As frmDocumentEdit
Private mSettingsChecked As Boolean

'================================================================
' REQUIRED CONTROLS IN FORM (tab Document):
'   lstDocument    ListBox   - document list
'   txtDocDetail   TextBox   - show detail (MultiLine=True, Locked=True)
'   fraDocDetail   Frame     - frame hien thi chi tiet (ScrollBars=2, KeepScrollBarsVisible=0)
'   btnDocAdd      CommandButton "Add"
'   btnDocEdit     CommandButton "Edit"
'   btnDocDelete   CommandButton "Delete"
'   btnDocOpenFile CommandButton "Open File"
'================================================================

' ---- Export Tab state variables ----
Private mExpMonth As Long
Private mExpYear  As Long

'================================================================
' PAYMENT TAB controls (tab Payment = tabMain index 2):
'   optPayAllTime / optPayMonthly / optPayYearly
'   btnPayThisMonth / btnPayMonthPrev / txtPayMonth / btnPayMonthNext
'   btnPayThisYear  / btnPayYearPrev  / txtPayYear  / btnPayYearNext
'   lstPayment   ListBox (9 cols: DN, Date, Desc, Act, Acc, Req, Paid, Rem, Note)
'   txtPayDetail TextBox (MultiLine=True, Locked=True)
'   btnPaymentEntryTab CommandButton "Payment Entry"
'   [MOD] chkPayAllA   CheckBox "All A" - chon tat ca hop dong nhom A
'   [MOD] chkPayAllB   CheckBox "All B" - chon tat ca hop dong nhom B
'   (da xoa: chkPaySelectAll)
'================================================================

Private mPayMonth As Long
Private mPayYear  As Long
Private mPaySumPaidA As Double
Private mPaySumPaidB As Double
Private mPaySumActA  As Double
Private mPaySumAccA  As Double
Private mPaySumReqA  As Double
Private mPaySumRemA  As Double
Private mPaySumActB  As Double
Private mPaySumAccB  As Double
Private mPaySumReqB  As Double
Private mPaySumRemB  As Double

Private mPayRowContractID() As String
Private mReminderForm As frmReminder
Private mReminderRef As Object
'================================================================
' ==================  PROGRESS TAB  =============================
' Tien do thanh toan — tabMain index = 4
'
' Bieu do bar chart hien thi theo tung hop dong:
'   Bar 1 (xanh lam): KL Chap nhan / Gia tri HÐ
'   Bar 2 (xanh la):  Da thanh toan / KL Chap nhan
'   Badge cam:        Tam ung (payment khong co AcceptedVolume)
'================================================================

' ---- State variables (them vao phan khai bao dau module) ----
Private mPrgMonth As Long
Private mPrgYear  As Long

'================================================================
' InitProgressTab — Goi khi chuyen sang tab Progress
'================================================================
Public Sub InitProgressTab()
    On Error Resume Next
    If mPrgMonth = 0 Then mPrgMonth = Month(Now)
    If mPrgYear = 0 Then mPrgYear = Year(Now)
    'txtPrgMonth.Text = CStr(mPrgMonth)
    'txtPrgYear.Text = CStr(mPrgYear)
    'optPrgAllTime.value = True
    UpdatePrgControlState
    On Error GoTo 0
    LoadProgressTab
End Sub

'----------------------------------------------------------------
Private Sub UpdatePrgControlState()
    On Error Resume Next
    'Dim useM As Boolean: useM = optPrgMonthly.value
   ' Dim useY As Boolean: useY = optPrgYearly.value
    'btnPrgThisMonth.Enabled = useM
    'btnPrgMonthPrev.Enabled = useM
    'txtPrgMonth.Enabled = useM
    'btnPrgMonthNext.Enabled = useM
    'btnPrgThisYear.Enabled = (useM Or useY)
    'btnPrgYearPrev.Enabled = (useM Or useY)
    'txtPrgYear.Enabled = (useM Or useY)
    'btnPrgYearNext.Enabled = (useM Or useY)
    On Error GoTo 0
End Sub

'================================================================
' EVENT HANDLERS
'================================================================
Private Sub chkPrgAllA_Click():    LoadProgressTab: End Sub
Private Sub chkPrgAllB_Click():    LoadProgressTab: End Sub
Private Sub optPrgAllTime_Click(): UpdatePrgControlState: LoadProgressTab: End Sub
Private Sub optPrgMonthly_Click(): UpdatePrgControlState: LoadProgressTab: End Sub
Private Sub optPrgYearly_Click():  UpdatePrgControlState: LoadProgressTab: End Sub

Private Sub btnPrgThisMonth_Click()
    mPrgMonth = Month(Now): mPrgYear = Year(Now)
    On Error Resume Next
    txtPrgMonth.Text = CStr(mPrgMonth): txtPrgYear.Text = CStr(mPrgYear)
    On Error GoTo 0
    LoadProgressTab
End Sub
Private Sub btnPrgMonthPrev_Click()
    mPrgMonth = mPrgMonth - 1
    If mPrgMonth < 1 Then mPrgMonth = 12: mPrgYear = mPrgYear - 1
    On Error Resume Next
    txtPrgMonth.Text = CStr(mPrgMonth): txtPrgYear.Text = CStr(mPrgYear)
    On Error GoTo 0
    LoadProgressTab
End Sub
Private Sub btnPrgMonthNext_Click()
    mPrgMonth = mPrgMonth + 1
    If mPrgMonth > 12 Then mPrgMonth = 1: mPrgYear = mPrgYear + 1
    On Error Resume Next
    txtPrgMonth.Text = CStr(mPrgMonth): txtPrgYear.Text = CStr(mPrgYear)
    On Error GoTo 0
    LoadProgressTab
End Sub
Private Sub btnPrgThisYear_Click()
    mPrgYear = Year(Now)
    On Error Resume Next: txtPrgYear.Text = CStr(mPrgYear): On Error GoTo 0
    LoadProgressTab
End Sub
Private Sub btnPrgYearPrev_Click()
    mPrgYear = mPrgYear - 1
    On Error Resume Next: txtPrgYear.Text = CStr(mPrgYear): On Error GoTo 0
    LoadProgressTab
End Sub
Private Sub btnPrgYearNext_Click()
    mPrgYear = mPrgYear + 1
    On Error Resume Next: txtPrgYear.Text = CStr(mPrgYear): On Error GoTo 0
    LoadProgressTab
End Sub
Private Sub txtPrgMonth_Change()
    On Error Resume Next
    If IsNumeric(txtPrgMonth.Text) Then
        Dim mo As Long: mo = CLng(txtPrgMonth.Text)
        If mo >= 1 And mo <= 12 Then mPrgMonth = mo: LoadProgressTab
    End If
    On Error GoTo 0
End Sub
Private Sub txtPrgYear_Change()
    On Error Resume Next
    If IsNumeric(txtPrgYear.Text) Then
        Dim yr As Long: yr = CLng(txtPrgYear.Text)
        If yr >= 2000 And yr <= 2100 Then mPrgYear = yr: LoadProgressTab
    End If
    On Error GoTo 0
End Sub

'================================================================
' LoadProgressTab — Main: doc du lieu, tinh toan, ve bieu do
'================================================================
Public Sub LoadProgressTab()
    On Error Resume Next
    If tabMain.value <> 4 Then Exit Sub
    On Error GoTo 0

    If Not gPaymentLoaded Then BuildPaymentCache
    If IsEmpty(gArrPayment) Then ClearProgressChart: Exit Sub

    '---- Doc trang thai filter ----
    Dim useMonthly As Boolean, useYearly As Boolean
    Dim useAllA    As Boolean, useAllB    As Boolean
    On Error Resume Next
    'useMonthly = optPrgMonthly.value
    'useYearly = optPrgYearly.value
    useAllA = chkPrgAllA.value
    useAllB = chkPrgAllB.value
    On Error GoTo 0

    Dim scopeSingle As Boolean
    scopeSingle = Not useAllA And Not useAllB

    ' --- Bo loc cboCategories (doc 1 lan, dung cho ca PASS 1) ---
    Dim filterCatPrg As String: filterCatPrg = ""
    On Error Resume Next
    If cboCategories.ListIndex > 0 Then filterCatPrg = Trim$(cboCategories.value)
    On Error GoTo 0

    '---- Cau truc ket qua ----
    Const MAX_C As Long = 300
    Dim cidArr(1 To MAX_C)  As String
    Dim seqArr(1 To MAX_C)  As String
    Dim grpArr(1 To MAX_C)  As String
    Dim cvalArr(1 To MAX_C) As Double   ' Gia tri HÐ
    Dim accArr(1 To MAX_C)  As Double   ' KL Chap nhan (tong)
    Dim paidArr(1 To MAX_C) As Double   ' Da TT (payment co AccVol > 0)
    Dim tamuArr(1 To MAX_C) As Double   ' Tam ung  (payment AccVol = 0)
    Dim reqArr(1 To MAX_C)  As Double
    Dim sortArr(1 To MAX_C) As Long
    Dim cCount As Long: cCount = 0

    Dim dictCIdx As Object
    Set dictCIdx = CreateObject("Scripting.Dictionary")

    '==========================================================
    ' PASS 1: Doc contract HEADER rows -> danh sach hop dong
    '==========================================================
    Dim i As Long
    For i = 1 To UBound(gArrPayment, 1)

        Dim cellC As String
        cellC = Trim$(CStr(gArrPayment(i, 3)))
        If cellC = "" Then GoTo NEXT_H
        If Trim$(CStr(gArrPayment(i, 2))) <> "" Then GoTo NEXT_H  ' bo payment row

        ' Chi lay A-/B- (bo GROUP- header)
        Dim hGrp As String: hGrp = ""
        If Left$(cellC, 2) = "A-" Then
            hGrp = "A"
        ElseIf Left$(cellC, 2) = "B-" Then
            hGrp = "B"
        Else
            GoTo NEXT_H
        End If

        ' Scope filter
        Dim include As Boolean: include = False
        If scopeSingle Then
            include = (cellC = gCurrentContractID)
        Else
            If useAllA And hGrp = "A" Then include = True
            If useAllB And hGrp = "B" Then include = True
        End If
        If Not include Then GoTo NEXT_H


        ' --- Bo loc cboCategories (col 18 cua gArrContract) ---
        ' (giong Payment tab: filterCat duoc doc 1 lan truoc vong lap)
        If filterCatPrg <> "" Then
            If Not gDictContract Is Nothing Then
                If gDictContract.exists(cellC) Then
                    If Trim$(CStr(gArrContract(gDictContract(cellC), 18))) <> filterCatPrg Then GoTo NEXT_H
                Else
                    GoTo NEXT_H    ' khong tim thay trong cache -> bo qua
                End If
            End If
        End If

        
        ' Bo qua CANCEL
        If Not gDictContract Is Nothing Then
            If gDictContract.exists(cellC) Then
                If UCase$(Trim$(CStr(gArrContract(gDictContract(cellC), 6)))) = "CANCEL" Then GoTo NEXT_H
            End If
        End If

        ' Them vao danh sach
        If Not dictCIdx.exists(cellC) And cCount < MAX_C Then
            cCount = cCount + 1
            dictCIdx(cellC) = cCount
            cidArr(cCount) = cellC
            grpArr(cCount) = hGrp

            ' Sequence (col X = 24) va sort order (col Y = 25) tu gArrContract
            If Not gDictContract Is Nothing Then
                If gDictContract.exists(cellC) Then
                    Dim rC As Long: rC = gDictContract(cellC)
                    seqArr(cCount) = Trim$(CStr(gArrContract(rC, 24)))
                    If IsNumeric(gArrContract(rC, 25)) Then
                        sortArr(cCount) = CLng(gArrContract(rC, 25))
                    Else
                        sortArr(cCount) = 99999
                    End If
                End If
            End If
            If seqArr(cCount) = "" Then seqArr(cCount) = cellC

            ' Gia tri hop dong: lay tu gArrContract col 15 (nhat quan voi lstResult)
            ' gArrPayment col 9 co the bi lech - khong dung lam contract value
            Dim exRH As Double
            exRH = val(CStr(gArrPayment(i, 7)))
            If exRH <= 0 Then exRH = 1

            If Not gDictContract Is Nothing Then
                If gDictContract.exists(cellC) Then
                    cvalArr(cCount) = val(CStr(gArrContract(gDictContract(cellC), 15))) * exRH
                Else
                    cvalArr(cCount) = val(CStr(gArrPayment(i, 9))) * exRH
                End If
            Else
                cvalArr(cCount) = val(CStr(gArrPayment(i, 9))) * exRH
            End If

            ' [FIX 2] Neu single mode va hop dong co appendix:
            ' tinh lai cvalArr = tong leaf descendants (giong dspCval trong All A)
            If scopeSingle Then
                Dim oDesc As Object
                Set oDesc = CreateObject("Scripting.Dictionary")
                Dim jj As Long
                For jj = 1 To UBound(gArrPayment, 1)
                    If Trim$(CStr(gArrPayment(jj, 2))) = "" Then
                        Dim dC As String: dC = Trim$(CStr(gArrPayment(jj, 3)))
                        If dC <> "" And dC <> cellC Then
                            If Left$(dC, Len(cellC) + 1) = cellC & "-" Or _
                               Left$(dC, Len(cellC) + 1) = cellC & "." Then
                                If Not oDesc.exists(dC) Then oDesc.Add dC, jj
                            End If
                        End If
                    End If
                Next jj

                If oDesc.count > 0 Then
                    Dim leafSum As Double: leafSum = 0
                    Dim dk As Variant
                    For Each dk In oDesc.keys
                        Dim isLf As Boolean: isLf = True
                        Dim dk2 As Variant
                        For Each dk2 In oDesc.keys
                            If Left$(CStr(dk2), Len(CStr(dk)) + 1) = CStr(dk) & "-" Or _
                               Left$(CStr(dk2), Len(CStr(dk)) + 1) = CStr(dk) & "." Then
                                isLf = False: Exit For
                            End If
                        Next dk2
                        If isLf Then
                            Dim dRow As Long: dRow = oDesc(dk)
                            Dim dExR As Double: dExR = val(CStr(gArrPayment(dRow, 7)))
                            If dExR <= 0 Then dExR = 1
                            If Not gDictContract Is Nothing Then
                                If gDictContract.exists(CStr(dk)) Then
                                    leafSum = leafSum + _
                                        val(CStr(gArrContract(gDictContract(CStr(dk)), 15))) * dExR
                                Else
                                    leafSum = leafSum + val(CStr(gArrPayment(dRow, 9))) * dExR
                                End If
                            Else
                                leafSum = leafSum + val(CStr(gArrPayment(dRow, 9))) * dExR
                            End If
                        End If
                    Next dk
                    If leafSum > 0 Then cvalArr(cCount) = leafSum
                End If
                Set oDesc = Nothing
            End If

            End If



NEXT_H:
    Next i

    If cCount = 0 Then Set dictCIdx = Nothing: ClearProgressChart: Exit Sub

    '==========================================================
    ' POST-PASS 1: Zero out cvalArr cua parent co appendix trong list
    ' Tranh double-count khi All A / All B:
    '   A-1   co A-1.1, A-1.2, ... -> cvalArr(A-1)   = 0
    '   A-1.2 co A-1.2.1, A-1.2.2  -> cvalArr(A-1.2) = 0
    '   Leaf (khong co con trong list) -> giu nguyen cvalArr
    '==========================================================
    Dim ppI As Long, ppJ As Long
    For ppI = 1 To cCount
        For ppJ = 1 To cCount
            If ppI <> ppJ Then
                If Left$(cidArr(ppJ), Len(cidArr(ppI)) + 1) = cidArr(ppI) & "-" Or _
                   Left$(cidArr(ppJ), Len(cidArr(ppI)) + 1) = cidArr(ppI) & "." Then
                    cvalArr(ppI) = 0
                    Exit For
                End If
            End If
        Next ppJ
    Next ppI

    '==========================================================
    ' PASS 2: Doc PAYMENT rows -> tinh AccVol, Paid, TamUng
    '==========================================================
    For i = 1 To UBound(gArrPayment, 1)
        cellC = Trim$(CStr(gArrPayment(i, 3)))
        If cellC = "" Then GoTo NEXT_P
        If Trim$(CStr(gArrPayment(i, 2))) = "" Then GoTo NEXT_P  ' header row

        ' [FIX] Ancestor lookup: xu ly ca single mode (cellC = appendix cua contract trong list)
        Dim ci As Long: ci = 0
        If dictCIdx.exists(cellC) Then
            ci = dictCIdx(cellC)
        Else
            ' Kiem tra xem cellC co phai la descendant cua bat ky contract nao trong list khong
            ' Vi du: A-1.2.1 va A-1.2.2 la descendant cua A-1.2 (ngan cach bang "-" hoac ".")
            Dim ai As Long
            For ai = 1 To cCount
                If Left$(cellC, Len(cidArr(ai)) + 1) = cidArr(ai) & "-" Or _
                   Left$(cellC, Len(cidArr(ai)) + 1) = cidArr(ai) & "." Then
                    ci = ai
                    Exit For
                End If
            Next ai
        End If
        If ci = 0 Then GoTo NEXT_P

        ' Time filter
        If useMonthly Or useYearly Then
            Dim pdV As Variant: pdV = gArrPayment(i, 17)
            Dim skipPay As Boolean: skipPay = True
            Dim pdDate As Date
            If IsValidDMY(pdV) Then
                pdDate = ParseDMY(pdV)
                If useMonthly Then
                    skipPay = (Month(pdDate) <> mPrgMonth Or Year(pdDate) <> mPrgYear)
                Else
                    skipPay = (Year(pdDate) <> mPrgYear)
                End If
            ElseIf IsDate(pdV) Then
                pdDate = CDate(pdV)
                If useMonthly Then
                    skipPay = (Month(pdDate) <> mPrgMonth Or Year(pdDate) <> mPrgYear)
                Else
                    skipPay = (Year(pdDate) <> mPrgYear)
                End If
            End If
            If skipPay Then GoTo NEXT_P
        End If

        Dim exRP As Double: exRP = val(CStr(gArrPayment(i, 7)))
        If exRP <= 0 Then exRP = 1

        Dim rowAcc  As Double: rowAcc = val(CStr(gArrPayment(i, 11))) * exRP
        Dim rowPaid As Double: rowPaid = val(CStr(gArrPayment(i, 13))) * exRP
        Dim rowReq  As Double: rowReq = val(CStr(gArrPayment(i, 12))) * exRP

        If rowAcc > 0 Then
            accArr(ci) = accArr(ci) + rowAcc
            reqArr(ci) = reqArr(ci) + rowReq
            paidArr(ci) = paidArr(ci) + rowPaid
        Else
            tamuArr(ci) = tamuArr(ci) + rowPaid
            reqArr(ci) = reqArr(ci) + rowReq    ' Cong ca Req cua tam ung vao tong Requested
        End If

NEXT_P:
    Next i

    Set dictCIdx = Nothing

    '==========================================================
    ' SAP XEP: GROUP-A truoc, GROUP-B sau; trong nhom sort theo Y
    '==========================================================
    Dim r1 As Long, r2 As Long
    For r1 = 1 To cCount - 1
        For r2 = r1 + 1 To cCount
            Dim doSwap As Boolean: doSwap = False
            If grpArr(r1) = grpArr(r2) Then
                If sortArr(r1) > sortArr(r2) Then doSwap = True
            ElseIf grpArr(r1) = "B" And grpArr(r2) = "A" Then
                doSwap = True
            End If
            If doSwap Then
                Dim tS As String
                tS = cidArr(r1):  cidArr(r1) = cidArr(r2):   cidArr(r2) = tS
                tS = seqArr(r1):  seqArr(r1) = seqArr(r2):   seqArr(r2) = tS
                tS = grpArr(r1):  grpArr(r1) = grpArr(r2):   grpArr(r2) = tS
                Dim tD As Double
                tD = cvalArr(r1): cvalArr(r1) = cvalArr(r2): cvalArr(r2) = tD
                tD = accArr(r1):  accArr(r1) = accArr(r2):   accArr(r2) = tD
                tD = paidArr(r1): paidArr(r1) = paidArr(r2): paidArr(r2) = tD
                tD = tamuArr(r1): tamuArr(r1) = tamuArr(r2): tamuArr(r2) = tD
                tD = reqArr(r1):  reqArr(r1) = reqArr(r2):   reqArr(r2) = tD
                Dim tL As Long
                tL = sortArr(r1): sortArr(r1) = sortArr(r2): sortArr(r2) = tL
            End If
        Next r2
    Next r1

    Dim dspCval(1 To MAX_C) As Double
    Dim dspAcc(1 To MAX_C)  As Double
    Dim dspPaid(1 To MAX_C) As Double
    Dim dspTamu(1 To MAX_C) As Double
    Dim dspReq(1 To MAX_C)  As Double

    Dim ri As Long, rj As Long
    For rj = 1 To cCount
        For ri = 1 To cCount
            Dim isDesc As Boolean
            isDesc = (ri = rj)
            If Not isDesc Then
                isDesc = (Left$(cidArr(rj), Len(cidArr(ri)) + 1) = cidArr(ri) & "-") Or _
                         (Left$(cidArr(rj), Len(cidArr(ri)) + 1) = cidArr(ri) & ".")
            End If
            If isDesc Then
                dspCval(ri) = dspCval(ri) + cvalArr(rj)
                dspAcc(ri) = dspAcc(ri) + accArr(rj)
                dspPaid(ri) = dspPaid(ri) + paidArr(rj)
                dspTamu(ri) = dspTamu(ri) + tamuArr(rj)
                dspReq(ri) = dspReq(ri) + reqArr(rj)
            End If
        Next ri
    Next rj

    '==========================================================
    ' VE BIEU DO
    '==========================================================
    DrawProgressBars cidArr, seqArr, grpArr, _
                     cvalArr, accArr, reqArr, paidArr, tamuArr, _
                     dspCval, dspAcc, dspReq, dspPaid, dspTamu, _
                     cCount

End Sub

'================================================================
' DrawProgressBars — v7 (GOP THANH 1 BAR / hop dong)
'
' THAY DOI SO VOI v6:
'   - Moi hop dong chi con 1 bar duy nhat (truoc la 2 bar).
'   - Nen bar = Contract Value (100%), do dai bar (so voi cac dong
'     khac) van ty le theo maxScale nhu cu.
'   - Trong long bar, xep chong lien tiep: Advance (TU, cam) roi
'     Paid (xanh) - vi 2 khoan nay loai tru nhau (khong chong len).
'   - Accepted Volume KHONG ve thanh vung to mau rieng (vi no la
'     "nguong da nghiem thu", khong phai tien da chi ra cung loai
'     voi Paid/Advance) -> ve thanh 1 VACH MOC (marker) dam mau
'     de len bar, kieu "bullet graph".
'   - Duoi bar: 1 dong text hien 3 ty le: TU/HD, TT/HD (Paid+TU/HD),
'     NT/HD (Accepted/HD).
'   - Neu Advance+Paid > Contract Value (vuot han muc) -> bar bi
'     cap lai o dung 100% do rong va dong ty le hien mau do canh bao.
'
' Cach ap dung: thay TOAN BO Sub DrawProgressBars(...) cu trong
' frmContractSearch bang code ben duoi. KHONG can sua LoadProgressTab
' hay ClearProgressChart - signature va logic goi ham giu nguyen.
'================================================================

Private Sub DrawProgressBars( _
    ByRef cidArr() As String, _
    ByRef seqArr() As String, _
    ByRef grpArr() As String, _
    ByRef cvalArr() As Double, _
    ByRef accArr() As Double, _
    ByRef reqArr() As Double, _
    ByRef paidArr() As Double, _
    ByRef tamuArr() As Double, _
    ByRef dspCval() As Double, _
    ByRef dspAcc() As Double, _
    ByRef dspReq() As Double, _
    ByRef dspPaid() As Double, _
    ByRef dspTamu() As Double, _
    ByVal cCount As Long)

    On Error GoTo ERR_DRAW
    ClearProgressChart
    If cCount = 0 Then Exit Sub

    Dim frm As MSForms.Frame
    Set frm = fraProgressChart

    '---- Layout ----
    Const L_SEQ     As Single = 2
    Const W_SEQ     As Single = 38
    Const L_BAR     As Single = 42
    Const BAR_H     As Single = 14
    Const RATIO_H   As Single = 11
    Const ROW_GAP   As Single = 2
    Const C_GAP     As Single = 8
    Const GRP_GAP   As Single = 8
    Const W_VAL     As Single = 82
    Const SB_W      As Single = 0
    Const MARK_W    As Single = 1.5
    Const MARK_OVER As Single = 2
    Const SUM_H     As Single = 13   ' chieu cao moi dong summary

    Dim wBar As Single
    wBar = frm.InsideWidth - L_BAR - W_VAL - 6 - SB_W
    If wBar < 40 Then wBar = 40

    Dim wFooter As Single
    wFooter = frm.InsideWidth - 2 - SB_W
    If wFooter < 60 Then wFooter = 60

    '---- Scale: dung dsp* de parent bar co scale dung ----
    Dim maxScale As Double: maxScale = 0
    Dim k As Long
    For k = 1 To cCount
        If dspCval(k) > maxScale Then maxScale = dspCval(k)
        If dspTamu(k) > maxScale Then maxScale = dspTamu(k)
        If dspAcc(k) > maxScale Then maxScale = dspAcc(k)
        If dspReq(k) > maxScale Then maxScale = dspReq(k)
    Next k
    If maxScale = 0 Then Exit Sub

    '---- Bien vong lap ----
    Dim wHD      As Single
    Dim wAdv     As Single
    Dim wPd      As Single
    Dim xAcc     As Single
    Dim pctTU    As Double
    Dim pctTT    As Double
    Dim pctNT    As Double
    Dim isOver   As Boolean
    Dim seqH     As Single
    Dim effCval  As Double

    '==================================================================
    '  PRE-PASS: Tinh tong GROUP dung mang GOC (khong double-count parent)
    '==================================================================
    Dim totCvalA As Double, totAccA  As Double
    Dim totReqA  As Double, totPaidA As Double, totTamuA As Double
    Dim totCvalB As Double, totAccB  As Double
    Dim totReqB  As Double, totPaidB As Double, totTamuB As Double
    Dim hasA As Boolean, hasB As Boolean

    For k = 1 To cCount
        If grpArr(k) = "A" Then
            hasA = True
            totCvalA = totCvalA + cvalArr(k)
            totAccA = totAccA + accArr(k)
            totReqA = totReqA + reqArr(k)
            totPaidA = totPaidA + paidArr(k)
            totTamuA = totTamuA + tamuArr(k)
        Else
            hasB = True
            totCvalB = totCvalB + cvalArr(k)
            totAccB = totAccB + accArr(k)
            totReqB = totReqB + reqArr(k)
            totPaidB = totPaidB + paidArr(k)
            totTamuB = totTamuB + tamuArr(k)
        End If
    Next k

    '---- Ty le Group A ----
    Dim aPctTU As Double, aPctTT As Double, aPctNT As Double
    Dim aSumPd As Double, aRem   As Double
    Dim effCvalA As Double
    effCvalA = IIf(totCvalA > 0, totCvalA, totAccA)
    If effCvalA > 0 Then
        aPctTU = totTamuA / effCvalA * 100
        aPctTT = (totTamuA + totPaidA) / effCvalA * 100
        aPctNT = totAccA / effCvalA * 100
    End If
    aSumPd = totTamuA + totPaidA
    aRem = totReqA - aSumPd:   If aRem < 0 Then aRem = 0

    '---- Ty le Group B ----
    Dim bPctTU As Double, bPctTT As Double, bPctNT As Double
    Dim bSumPd As Double, bRem   As Double
    Dim effCvalB As Double
    effCvalB = IIf(totCvalB > 0, totCvalB, totAccB)
    If effCvalB > 0 Then
        bPctTU = totTamuB / effCvalB * 100
        bPctTT = (totTamuB + totPaidB) / effCvalB * 100
        bPctNT = totAccB / effCvalB * 100
    End If
    bSumPd = totTamuB + totPaidB
    bRem = totReqB - bSumPd:   If bRem < 0 Then bRem = 0

    Dim Y As Single: Y = 1

    If hasA Then
    '==================================================================
    '  SUMMARY BLOCK A -- Hien thi tren cung (truoc cac bar)
    '==================================================================
    Dim lSA_HDR As MSForms.Label
    Set lSA_HDR = frm.Controls.Add("Forms.Label.1", "DYN_SA_HDR")
    With lSA_HDR
        .Caption = "  GROUP A  -  Contracts with Owner"
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(255, 255, 255)
        .BackColor = RGB(31, 73, 125): .BackStyle = 1
    End With
    Y = Y + SUM_H

    Dim lSA1 As MSForms.Label
    Set lSA1 = frm.Controls.Add("Forms.Label.1", "DYN_SA1")
    With lSA1
        .Caption = "    Contract Val: " & IIf(totCvalA = 0, "0", FastVN(totCvalA)) & _
                    "   |   Accepted Vol: " & IIf(totAccA = 0, "0", FastVN(totAccA))
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(31, 56, 100)
        .BackColor = RGB(220, 235, 255): .BackStyle = 1
    End With
    Y = Y + SUM_H

    Dim lSA2 As MSForms.Label
    Set lSA2 = frm.Controls.Add("Forms.Label.1", "DYN_SA2")
    With lSA2
        .Caption = "    Advance: " & IIf(totTamuA = 0, "0", FastVN(totTamuA)) & _
                    "   |   Paid: " & IIf(totPaidA = 0, "0", FastVN(totPaidA))
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(31, 56, 100)
        .BackColor = RGB(210, 228, 255): .BackStyle = 1
    End With
    Y = Y + SUM_H

    Dim lSA3 As MSForms.Label
    Set lSA3 = frm.Controls.Add("Forms.Label.1", "DYN_SA3")
    With lSA3
        .Caption = "    SumPaid: " & IIf(aSumPd = 0, "0", FastVN(aSumPd)) & _
                    "   |   Remaining: " & IIf(aRem = 0, "0", FastVN(aRem))
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(31, 56, 100)
        .BackColor = RGB(205, 224, 255): .BackStyle = 1
    End With
    Y = Y + SUM_H

    Dim lSA4 As MSForms.Label
    Set lSA4 = frm.Controls.Add("Forms.Label.1", "DYN_SA4")
    With lSA4
        .Caption = "    Advance: " & Format(aPctTU, "0.00") & "%" & _
                    "   |   Paid: " & Format(aPctTT, "0.00") & "%" & _
                    "   |   Accepted: " & Format(aPctNT, "0.00") & "%"
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(31, 56, 100)
        .BackColor = RGB(200, 220, 255): .BackStyle = 1
    End With
    Y = Y + SUM_H + 6

    End If   ' hasA

    If hasB Then
    '==================================================================
    '  SUMMARY BLOCK B -- Ngay duoi khoi A
    '==================================================================
    Dim lSB_HDR As MSForms.Label
    Set lSB_HDR = frm.Controls.Add("Forms.Label.1", "DYN_SB_HDR")
    With lSB_HDR
        .Caption = "  GROUP B  -  Contracts with Subcontractor"
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(255, 255, 255)
        .BackColor = RGB(120, 40, 40): .BackStyle = 1
    End With
    Y = Y + SUM_H

    Dim lSB1 As MSForms.Label
    Set lSB1 = frm.Controls.Add("Forms.Label.1", "DYN_SB1")
    With lSB1
        .Caption = "    Contract Val: " & IIf(totCvalB = 0, "0", FastVN(totCvalB)) & _
                    "   |   Accepted Vol: " & IIf(totAccB = 0, "0", FastVN(totAccB))
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(100, 31, 31)
        .BackColor = RGB(255, 230, 230): .BackStyle = 1
    End With
    Y = Y + SUM_H

    Dim lSB2 As MSForms.Label
    Set lSB2 = frm.Controls.Add("Forms.Label.1", "DYN_SB2")
    With lSB2
        .Caption = "    Advance: " & IIf(totTamuB = 0, "0", FastVN(totTamuB)) & _
                    "   |   Paid: " & IIf(totPaidB = 0, "0", FastVN(totPaidB))
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(100, 31, 31)
        .BackColor = RGB(255, 220, 220): .BackStyle = 1
    End With
    Y = Y + SUM_H

    Dim lSB3 As MSForms.Label
    Set lSB3 = frm.Controls.Add("Forms.Label.1", "DYN_SB3")
    With lSB3
        .Caption = "    SumPaid: " & IIf(bSumPd = 0, "0", FastVN(bSumPd)) & _
                    "   |   Remaining: " & IIf(bRem = 0, "0", FastVN(bRem))
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(100, 31, 31)
        .BackColor = RGB(255, 210, 210): .BackStyle = 1
    End With
    Y = Y + SUM_H

    Dim lSB4 As MSForms.Label
    Set lSB4 = frm.Controls.Add("Forms.Label.1", "DYN_SB4")
    With lSB4
        .Caption = "    Advance: " & Format(bPctTU, "0.00") & "%" & _
                    "   |   Paid: " & Format(bPctTT, "0.00") & "%" & _
                    "   |   Accepted: " & Format(bPctNT, "0.00") & "%"
        .Left = 1: .Top = Y: .Width = wFooter: .Height = SUM_H
        .Font.Size = 8: .Font.Bold = True
        .ForeColor = RGB(100, 31, 31)
        .BackColor = RGB(255, 200, 200): .BackStyle = 1
    End With
    Y = Y + SUM_H + 10

    End If   ' hasB

    '==================================================================
    '  BARS — dung dsp* (rollup) de hien thi parent co du lieu dung
    '==================================================================
    Dim lastGrp As String: lastGrp = ""

    For k = 1 To cCount

        '==== Reset bien moi iteration ====
        wHD = 0: wAdv = 0: wPd = 0: xAcc = 0
        pctTU = 0: pctTT = 0: pctNT = 0
        isOver = False
        effCval = IIf(dspCval(k) > 0, dspCval(k), dspAcc(k))

        '==== Group header ====
        If grpArr(k) <> lastGrp Then
            If lastGrp <> "" Then Y = Y + GRP_GAP
            Dim lblGH As MSForms.Label
            Set lblGH = frm.Controls.Add("Forms.Label.1", "DYN_GH_" & k)
            With lblGH
                If grpArr(k) = "A" Then
                    .Caption = "  GROUP A  -  Contracts with Owner"
                    .ForeColor = RGB(31, 73, 125)
                    .BackColor = RGB(225, 238, 255)
                Else
                    .Caption = "  GROUP B  -  Contracts with Subcontractor"
                    .ForeColor = RGB(120, 40, 40)
                    .BackColor = RGB(255, 232, 232)
                End If
                .Left = 1: .Top = Y
                .Width = frm.InsideWidth - SB_W: .Height = 14
                .Font.Bold = True: .Font.Size = 8
                .BackStyle = 1
            End With
            Y = Y + 16
            lastGrp = grpArr(k)
        End If

        '==== Sequence label ====
        seqH = BAR_H + ROW_GAP + RATIO_H
        Dim lblSeq As MSForms.Label
        Set lblSeq = frm.Controls.Add("Forms.Label.1", "DYN_SEQ_" & k)
        With lblSeq
            .Caption = seqArr(k)
            .Left = L_SEQ: .Top = Y
            .Width = W_SEQ - 2: .Height = seqH
            .Font.Bold = True: .Font.Size = 8
            .TextAlign = fmTextAlignRight
            .BackStyle = 0: .WordWrap = False
            .ForeColor = IIf(grpArr(k) = "A", RGB(31, 73, 125), RGB(120, 40, 40))
        End With
        RegisterProgressChartLabel lblSeq, cidArr(k), "SELECT"

        '==== Bar nen xam = Contract Value (dung dspCval) ====
        If dspCval(k) > 0 Then
            wHD = CSng(dspCval(k) / maxScale) * wBar
        ElseIf dspTamu(k) > 0 Or dspAcc(k) > 0 Then
            wHD = CSng(IIf(dspTamu(k) > dspAcc(k), dspTamu(k), dspAcc(k)) / maxScale) * wBar
        Else
            wHD = 4
        End If
        If wHD > wBar Then wHD = wBar
        If wHD < 2 Then wHD = 2

        Dim lBg As MSForms.Label
        Set lBg = frm.Controls.Add("Forms.Label.1", "DYN_BG_" & k)
        With lBg
            .Caption = "": .Left = L_BAR: .Top = Y
            .Width = wHD: .Height = BAR_H
            .BackColor = RGB(200, 200, 200): .BackStyle = 1
        End With

        If effCval > 0 Then
            wAdv = CSng(dspTamu(k) / effCval) * wHD
            wPd = CSng(dspPaid(k) / effCval) * wHD
        End If
        If wAdv < 0 Then wAdv = 0
        If wPd < 0 Then wPd = 0

        If wAdv + wPd > wHD Then
            isOver = True
            If wAdv > wHD Then
                wAdv = wHD: wPd = 0
            Else
                wPd = wHD - wAdv
            End If
        End If

        If wAdv >= 1 Then
            Dim lAdv As MSForms.Label
            Set lAdv = frm.Controls.Add("Forms.Label.1", "DYN_ADV_" & k)
            With lAdv
                .Caption = "": .Left = L_BAR: .Top = Y
                .Width = wAdv: .Height = BAR_H
                .BackColor = RGB(220, 130, 20): .BackStyle = 1
            End With
        End If

        If wPd >= 1 Then
            Dim lPd As MSForms.Label
            Set lPd = frm.Controls.Add("Forms.Label.1", "DYN_PD_" & k)
            With lPd
                .Caption = "": .Left = L_BAR + wAdv: .Top = Y
                .Width = wPd: .Height = BAR_H
                .BackColor = RGB(35, 160, 70): .BackStyle = 1
            End With
        End If

        '==== Vach moc Accepted Volume ====
        If effCval > 0 And dspAcc(k) > 0 Then
            xAcc = CSng(dspAcc(k) / effCval) * wHD
            If xAcc > wHD Then xAcc = wHD
            If xAcc < 0 Then xAcc = 0
            Dim lMark As MSForms.Label
            Set lMark = frm.Controls.Add("Forms.Label.1", "DYN_MK_" & k)
            With lMark
                .Caption = "": .Left = L_BAR + xAcc - (MARK_W / 2)
                .Top = Y - MARK_OVER
                .Width = MARK_W: .Height = BAR_H + MARK_OVER * 2
                .BackColor = RGB(20, 20, 20): .BackStyle = 1
            End With
        End If

        '==== Gia tri ben phai bar (dspCval) ====
        Dim lVal As MSForms.Label
        Set lVal = frm.Controls.Add("Forms.Label.1", "DYN_VAL_" & k)
        With lVal
            .Caption = IIf(dspCval(k) > 0, FastVN(dspCval(k)), IIf(dspAcc(k) > 0, FastVN(dspAcc(k)), "0"))
            .Left = L_BAR + wHD + 3: .Top = Y
            .Width = (frm.InsideWidth - SB_W - 2) - (L_BAR + wHD + 3)
            If .Width < W_VAL Then .Width = W_VAL
            .Height = BAR_H
            .Font.Size = 8: .BackStyle = 0
            .ForeColor = RGB(90, 90, 90)
            .TextAlign = fmTextAlignLeft
        End With
        RegisterProgressChartLabel lVal, cidArr(k), "PAYMENT"

        '==== Dong ty le duoi bar (dung dsp*) ====
        If effCval > 0 Then
            pctTU = dspTamu(k) / effCval * 100
            pctTT = (dspPaid(k) + dspTamu(k)) / effCval * 100
            pctNT = dspAcc(k) / effCval * 100
        End If

        Dim lRatio As MSForms.Label
        Set lRatio = frm.Controls.Add("Forms.Label.1", "DYN_RT_" & k)
        With lRatio
            .Caption = "Adv: " & Format(pctTU, "0.00") & "%" & _
                        "   Pad: " & Format(pctTT, "0.00") & "%" & _
                        "   Acc: " & Format(pctNT, "0.00") & "%"
            .Left = L_BAR: .Top = Y + BAR_H + ROW_GAP
            .Width = (frm.InsideWidth - SB_W - 2) - L_BAR
            .Height = RATIO_H
            .Font.Size = 8
            .ForeColor = IIf(isOver, RGB(200, 0, 0), _
                         IIf(pctTT >= 100, RGB(0, 130, 0), RGB(80, 80, 80)))
            .Font.Bold = isOver Or (pctTT >= 100)
            .BackStyle = 0
            .TextAlign = fmTextAlignLeft
        End With

        Y = Y + BAR_H + ROW_GAP + RATIO_H + C_GAP
    Next k

    '==== Legend ====
    Y = Y + 6
    Dim legCap(0 To 3) As String
    Dim legClr(0 To 3) As Long
    legCap(0) = "     Contract Value":  legClr(0) = RGB(200, 200, 200)
    legCap(1) = "     Advance":         legClr(1) = RGB(220, 130, 20)
    legCap(2) = "     Paid":            legClr(2) = RGB(35, 160, 70)
    legCap(3) = "     Accepted":        legClr(3) = RGB(20, 20, 20)

    Dim li As Long
    Dim legX As Single, legY As Single
    For li = 0 To 3
        legX = 36 + (li Mod 2) * 120
        legY = Y + (li \ 2) * 12

        Dim lLB As MSForms.Label
        Set lLB = frm.Controls.Add("Forms.Label.1", "DYN_LC_" & li)
        With lLB
            .Caption = "": .Left = legX + 6: .Top = legY
            .Width = 12: .Height = 10
            .BackColor = legClr(li): .BackStyle = 1
            .BorderStyle = IIf(li = 0, 1, 0)
        End With

        Dim lLT As MSForms.Label
        Set lLT = frm.Controls.Add("Forms.Label.1", "DYN_LT_" & li)
        With lLT
            .Caption = legCap(li): .Left = legX + 15: .Top = legY
            .Width = 120: .Height = 10
            .Font.Size = 7: .BackStyle = 0
        End With
    Next li

    Y = Y + 26

    '==== ScrollHeight ====
    On Error Resume Next
    fraProgressChart.ScrollHeight = Y + 20
    On Error GoTo 0

    Exit Sub
ERR_DRAW:
    Debug.Print "DrawProgressBars error: " & Err.Description
End Sub




'================================================================
' ClearProgressChart — Xoa tat ca Label dong (DYN_*)
'================================================================
Private Sub ClearProgressChart()
    On Error Resume Next
    Set mProgressLabelHandlers = Nothing

    Dim ctrl As MSForms.Control
    Dim toDel() As String
    Dim nDel    As Long: nDel = 0
    ReDim toDel(0 To fraProgressChart.Controls.count)

    For Each ctrl In fraProgressChart.Controls
        If Left$(ctrl.Name, 3) = "DYN" Then
            toDel(nDel) = ctrl.Name
            nDel = nDel + 1
        End If
    Next ctrl

    Dim j As Long
    For j = 0 To nDel - 1
        fraProgressChart.Controls.Remove toDel(j)
    Next j
    On Error GoTo 0
End Sub

'================================================================
' PROGRESS CHART LABEL EVENTS
'================================================================
' Dynamic controls created with Controls.Add do not expose their
' DblClick events directly in this UserForm module.  The handler
' collection keeps one WithEvents wrapper alive for each clickable
' label until the chart is redrawn.
Private Sub RegisterProgressChartLabel(ByVal lbl As MSForms.Label, _
                                       ByVal contractID As String, _
                                       ByVal actionName As String)

    If mProgressLabelHandlers Is Nothing Then
        Set mProgressLabelHandlers = New Collection
    End If

    Dim handler As clsProgressChartLabel
    Set handler = New clsProgressChartLabel
    handler.Initialize Me, lbl, contractID, actionName
    mProgressLabelHandlers.Add handler

End Sub

Public Sub ProgressChartLabelDblClick(ByVal contractID As String, _
                                      ByVal actionName As String)

    On Error GoTo ERR_HANDLER

    contractID = Trim$(contractID)
    If contractID = "" Or contractID = "0" Then Exit Sub

    ' Keep the main list and the detail panel in sync first.
    gCurrentContractID = contractID
    SelectContract contractID

    If UCase$(Trim$(actionName)) <> "PAYMENT" Then Exit Sub

    ' Same open/refresh sequence as the Payment Summary button.
    Unload frmPaymentSummary
    Set frmPaymentSummary = Nothing

    frmPaymentSummary.Show vbModeless
    frmPaymentSummary.InitFast
    DoEvents
    frmPaymentSummary.SelectContract contractID

    Exit Sub

ERR_HANDLER:
    ShowMsgCenter "Cannot open contract " & contractID & ": " & _
                  Err.Description, vbExclamation

End Sub

'==========================================================
' btnHome — Quay l?i frmHomePage
'==========================================================
Private Sub btnHome_Click()

    Application.ScreenUpdating = False
    Application.Cursor = xlDefault

    Me.Hide

    On Error Resume Next
    Unload frmHomePage
    On Error GoTo 0

    frmHomePage.Show vbModeless
    frmHomePage.RefreshList

    Application.Cursor = xlDefault
    Application.ScreenUpdating = True

End Sub

'================================================================
' MO FORM NHAC VIEC (Pending Documents)
'================================================================
Private Sub btnReminder_Click()

    On Error Resume Next
    If Not gContractLoaded Then BuildGlobalContractCache
    If Not gPaymentLoaded Then BuildPaymentCache
    On Error GoTo 0

    ' Neu form dang an thi chi Show lai va refresh
    If Not mReminderForm Is Nothing Then
        mReminderForm.LoadPendingList
        mReminderForm.Show vbModeless
        Exit Sub
    End If

    ' Tao moi hoan toan (chay lai UserForm_Initialize)
    Set mReminderForm = New frmReminder
    mReminderForm.SetContractSearchRef Me
    mReminderForm.Show vbModeless

End Sub
'================================================================
' PUBLIC — g?i t? Ribbon khi frmContractSearch dang m?
' Dùng chung mReminderForm thay vì t?o instance m?i
'================================================================
Public Sub OpenReminderForm()

    On Error Resume Next
    If Not gContractLoaded Then BuildGlobalContractCache
    If Not gPaymentLoaded Then BuildPaymentCache
    On Error GoTo 0

    If Not mReminderForm Is Nothing Then
        mReminderForm.LoadPendingList
        mReminderForm.Show vbModeless
        Exit Sub
    End If

    Set mReminderForm = New frmReminder
    mReminderForm.SetContractSearchRef Me
    mReminderForm.Show vbModeless

End Sub
'================================================================
' Duoc goi boi frmReminder khi form do bi Unload
' -> Clear zombie reference de lan bam thu 2 tao moi duoc
'================================================================
Public Sub ClearReminderRef()
    Set mReminderForm = Nothing
End Sub

Private Sub btnAskAI_Click()
    frmAskAI.Show vbModeless
End Sub

'================================================================
Private Sub txtKeyword_MouseDown( _
    ByVal Button As Integer, _
    ByVal Shift As Integer, _
    ByVal X As Single, _
    ByVal Y As Single)

    If Button <> 2 Then Exit Sub

    Dim t As Double
    t = Timer

    If mRightClickCount >= 1 And (t - mRightClickTime) < 0.5 Then
        mRightClickCount = 0
        mRightClickTime = 0
        txtKeyword.value = ""
        LoadContractList
    Else
        mRightClickCount = 1
        mRightClickTime = t
    End If
    UpdateExportPreview
    LoadPaymentTab gCurrentContractID

End Sub

Private Sub InitPaymentTab()
    If mPayMonth = 0 Then mPayMonth = Month(Now)
    If mPayYear = 0 Then mPayYear = Year(Now)
    On Error Resume Next
    txtPayMonth.Text = CStr(mPayMonth)
    txtPayYear.Text = CStr(mPayYear)
    On Error GoTo 0
    On Error Resume Next
    If Not optPayMonthly.value And Not optPayYearly.value Then
        optPayAllTime.value = True
    End If
    On Error GoTo 0
    UpdatePaymentControlState
    LoadPaymentTab gCurrentContractID
End Sub

Private Sub UpdatePaymentControlState()
    Dim useMonthly As Boolean, useYearly As Boolean
    On Error Resume Next
    useMonthly = optPayMonthly.value
    useYearly = optPayYearly.value
    btnPayThisMonth.Enabled = useMonthly
    btnPayMonthPrev.Enabled = useMonthly
    txtPayMonth.Enabled = useMonthly
    btnPayMonthNext.Enabled = useMonthly
    btnPayThisYear.Enabled = (useMonthly Or useYearly)
    btnPayYearPrev.Enabled = (useMonthly Or useYearly)
    txtPayYear.Enabled = (useMonthly Or useYearly)
    btnPayYearNext.Enabled = (useMonthly Or useYearly)
    On Error GoTo 0
End Sub

'================================================================
' [MOD] LoadPaymentTab: Thay chkPaySelectAll bang chkPayAllA + chkPayAllB
'================================================================
Public Sub LoadPaymentTab(ByVal contractID As String)
    Erase mPayRowContractID  ' Discard mappings from the previous All A/B list.
    On Error Resume Next
    lstPayment.Clear
    ClearPayDetail
    On Error GoTo 0

    ' [MOD] Doc trang thai 2 checkbox rieng
    Dim selectAllA As Boolean, selectAllB As Boolean
    On Error Resume Next
    selectAllA = chkPayAllA.value
    selectAllB = chkPayAllB.value
    On Error GoTo 0

    ' Neu chon it nhat 1 nhom All -> goi LoadPaymentTabAllContracts
    If selectAllA Or selectAllB Then
        LoadPaymentTabAllContracts selectAllA, selectAllB
        Exit Sub
    End If

    If Trim(contractID) = "" Then Exit Sub
    If Not gPaymentLoaded Then BuildPaymentCache
    If gDictPaymentRows Is Nothing Then Exit Sub
    If Not gDictPaymentRows.exists(contractID) Then Exit Sub
    If IsEmpty(gArrPayment) Then Exit Sub

    ' --- Ap dung bo loc cboCategories ---
    Dim filterCatSingle As String: filterCatSingle = ""
    On Error Resume Next
    If cboCategories.ListIndex > 0 Then filterCatSingle = Trim$(cboCategories.value)
    On Error GoTo 0
    If filterCatSingle <> "" Then
        If Not gContractLoaded Then BuildGlobalContractCache
        If gDictContract.exists(contractID) Then
            Dim rSingle As Long: rSingle = gDictContract(contractID)
            If Trim$(CStr(gArrContract(rSingle, 18))) <> filterCatSingle Then Exit Sub
        End If
    End If

    Dim useMonthly As Boolean, useYearly As Boolean
    On Error Resume Next
    useMonthly = optPayMonthly.value
    useYearly = optPayYearly.value
    On Error GoTo 0

    Dim rows As Collection
    Set rows = gDictPaymentRows(contractID)

    Dim arrList() As Variant
    ReDim arrList(0 To rows.count + 5, 0 To 8)
    Dim total As Long: total = 0
    Dim idx As Variant

    For Each idx In rows
        If Trim(CStr(gArrPayment(idx, 2))) = "" Then
            arrList(total, 0) = "DN"
            arrList(total, 1) = "Date"
            arrList(total, 2) = "Description"
            Dim exRateHdrTab As Double
            exRateHdrTab = val(gArrPayment(idx, 7))
            If exRateHdrTab <= 0 Then exRateHdrTab = 1
            arrList(total, 3) = FastVN(val(gArrPayment(idx, 10)) * exRateHdrTab)
            arrList(total, 4) = FastVN(val(gArrPayment(idx, 11)) * exRateHdrTab)
            arrList(total, 5) = FastVN(val(gArrPayment(idx, 12)) * exRateHdrTab)
            arrList(total, 6) = FastVN(val(gArrPayment(idx, 13)) * exRateHdrTab)
            arrList(total, 7) = FastVN(val(gArrPayment(idx, 14)) * exRateHdrTab)
            arrList(total, 8) = ""
            total = total + 1
            arrList(total, 2) = "--------------------------"
            total = total + 1
        Else
            If useMonthly Or useYearly Then
                Dim payDate As Variant
                payDate = gArrPayment(idx, 17)
                Dim SkipRow As Boolean: SkipRow = False
                If IsValidDMY(payDate) Then
                    Dim pd As Date
                    pd = ParseDMY(payDate)
                    If useMonthly Then
                        If Month(pd) <> mPayMonth Or Year(pd) <> mPayYear Then SkipRow = True
                    ElseIf useYearly Then
                        If Year(pd) <> mPayYear Then SkipRow = True
                    End If
                Else
                    SkipRow = True
                End If
                If SkipRow Then GoTo NEXT_IDX
            End If

            arrList(total, 0) = gArrPayment(idx, 16)
            If IsDate(gArrPayment(idx, 17)) Then
                arrList(total, 1) = Format(gArrPayment(idx, 17), "dd/mm/yyyy")
            ElseIf IsValidDMY(gArrPayment(idx, 17)) Then
                arrList(total, 1) = Format(ParseDMY(gArrPayment(idx, 17)), "dd/mm/yyyy")
            End If
            arrList(total, 2) = gArrPayment(idx, 15)
            Dim exRatePayTab As Double
            exRatePayTab = val(gArrPayment(idx, 7))
            If exRatePayTab <= 0 Then exRatePayTab = 1
            arrList(total, 3) = FastVN(val(gArrPayment(idx, 10)) * exRatePayTab)
            arrList(total, 4) = FastVN(val(gArrPayment(idx, 11)) * exRatePayTab)
            arrList(total, 5) = FastVN(val(gArrPayment(idx, 12)) * exRatePayTab)
            arrList(total, 6) = FastVN(val(gArrPayment(idx, 13)) * exRatePayTab)
            arrList(total, 7) = FastVN(val(gArrPayment(idx, 14)) * exRatePayTab)
            arrList(total, 8) = Trim$(CStr(gArrPayment(idx, 21)))
            total = total + 1
        End If
NEXT_IDX:
    Next idx

    If total <= 0 Then Exit Sub

    Dim finalArr() As Variant
    ReDim finalArr(0 To total - 1, 0 To 8)
    Dim rr As Long, cc As Long
    For rr = 0 To total - 1
        For cc = 0 To 8
            finalArr(rr, cc) = arrList(rr, cc)
        Next cc
    Next rr

    On Error Resume Next
    lstPayment.List = finalArr
    On Error GoTo 0

    Dim autoSel As Long: autoSel = -1
    Dim k As Long
    For k = 0 To lstPayment.ListCount - 1
        Dim c0 As String
        c0 = Trim$(CStr(lstPayment.List(k, 0)))
        If c0 <> "" Then autoSel = k
    Next k

    If autoSel >= 0 Then
        lstPayment.ListIndex = autoSel
        lstPayment_Click
    End If
End Sub

'================================================================
' PAYMENT TAB — SELECT ALL (All A / All B)
'
' [MOD] Them tham so showA, showB de chi hien thi nhom duoc chon.
' [MOD] Them sap xep theo ngay (SortBufferByDate) truoc khi hien thi.
' [MOD] Hien thi so luong payment da loc trong txtPayDetail.
'
' [PERFORMANCE FIX] Pass 2: Xay dictFirstDate truoc vong lap
' thay vi vong lap long For hh = 1 To UBound(gArrPayment,1) ben trong
'================================================================
Private Sub LoadPaymentTabAllContracts(ByVal showA As Boolean, ByVal showB As Boolean)
    If Not gPaymentLoaded Then BuildPaymentCache
    If gDictPaymentRows Is Nothing Then Exit Sub

    ' --- Doc bo loc cboCategories ---
    Dim filterCat As String: filterCat = ""
    On Error Resume Next
    If cboCategories.ListIndex > 0 Then filterCat = Trim$(cboCategories.value)
    On Error GoTo 0

    Dim useMonthly As Boolean, useYearly As Boolean
    On Error Resume Next
    useMonthly = optPayMonthly.value
    useYearly = optPayYearly.value
    On Error GoTo 0

    mPaySumPaidA = 0: mPaySumPaidB = 0
    mPaySumActA = 0: mPaySumAccA = 0: mPaySumReqA = 0: mPaySumRemA = 0
    mPaySumActB = 0: mPaySumAccB = 0: mPaySumReqB = 0: mPaySumRemB = 0

    '==================================================================
    ' PRE-SCAN
    '==================================================================
    Dim dictHasLedger As Object: Set dictHasLedger = CreateObject("Scripting.Dictionary")
    Dim dictHasPaid   As Object: Set dictHasPaid = CreateObject("Scripting.Dictionary")
    Dim sc As Long
    For sc = 1 To UBound(gArrPayment, 1)
        Dim scCID As String: scCID = Trim$(CStr(gArrPayment(sc, 3)))
        If scCID = "" Then GoTo SCAN_NEXT
        If Trim$(CStr(gArrPayment(sc, 2))) = "" Then GoTo SCAN_NEXT
        If Not dictHasLedger.exists(scCID) Then dictHasLedger(scCID) = 1
        If val(CStr(gArrPayment(sc, 13))) > 0 Then
            If Not dictHasPaid.exists(scCID) Then dictHasPaid(scCID) = 1
        End If
SCAN_NEXT:
    Next sc

    '==================================================================
    ' [FIX] Build dictFirstDate: contractID -> ngay LedgerID row dau tien
    '==================================================================
    Dim dictFirstDate As Object: Set dictFirstDate = CreateObject("Scripting.Dictionary")
    Dim fd As Long
    For fd = 1 To UBound(gArrPayment, 1)
        Dim fdCID As String: fdCID = Trim$(CStr(gArrPayment(fd, 3)))
        If fdCID = "" Then GoTo FD_NEXT
        If Trim$(CStr(gArrPayment(fd, 2))) = "" Then GoTo FD_NEXT
        If dictFirstDate.exists(fdCID) Then GoTo FD_NEXT
        If IsValidDMY(gArrPayment(fd, 17)) Then
            dictFirstDate(fdCID) = ParseDMY(gArrPayment(fd, 17))
        End If
FD_NEXT:
    Next fd

    '==================================================================
    ' BUFFERS cho Group A va Group B (10 cols: 0-8 = data, 9 = contractID)
    ' [MOD] Them mang sortKeyA/sortKeyB de sap xep theo ngay
    '==================================================================
    Dim bufA() As Variant: ReDim bufA(0 To 5000, 0 To 9)
    Dim cidA() As String:  ReDim cidA(0 To 5000)
    Dim sortKeyA() As Double: ReDim sortKeyA(0 To 5000)
    Dim bufB() As Variant: ReDim bufB(0 To 5000, 0 To 9)
    Dim cidB() As String:  ReDim cidB(0 To 5000)
    Dim sortKeyB() As Double: ReDim sortKeyB(0 To 5000)
    Dim cntA As Long: cntA = 0
    Dim cntB As Long: cntB = 0

    '==================================================================
    ' PASS 1 — LedgerID rows (logic goc — KHONG THAY DOI logic loc)
    ' [MOD] Chi xu ly nhom A neu showA=True, nhom B neu showB=True
    '==================================================================
    Dim cid As Variant
    For Each cid In gDictPaymentRows.keys
        Dim cidStr As String: cidStr = CStr(cid)

        Dim grp As String
        If Left$(cidStr, 2) = "A-" Then
            grp = "A"
        ElseIf Left$(cidStr, 2) = "B-" Then
            grp = "B"
        Else
            grp = GetGroupFromContractArr(cidStr)
            If grp = "" Then GoTo NEXT_CID1
        End If

        ' [MOD] Bo qua nhom khong duoc chon
        If grp = "A" And Not showA Then GoTo NEXT_CID1
        If grp = "B" And Not showB Then GoTo NEXT_CID1

        ' --- Ap dung bo loc cboCategories ---
        If filterCat <> "" Then
            If Not gContractLoaded Then BuildGlobalContractCache
            If gDictContract.exists(cidStr) Then
                Dim rCatP1 As Long: rCatP1 = gDictContract(cidStr)
                If Trim$(CStr(gArrContract(rCatP1, 18))) <> filterCat Then GoTo NEXT_CID1
            Else
                GoTo NEXT_CID1
            End If
        End If

        Dim rows As Collection
        Set rows = gDictPaymentRows(cidStr)
        Dim idx As Variant
        For Each idx In rows
            If Trim(CStr(gArrPayment(idx, 2))) = "" Then GoTo NEXT_P1

            Dim SkipRow As Boolean: SkipRow = False
            If useMonthly Or useYearly Then
                Dim payDateV As Variant: payDateV = gArrPayment(idx, 17)
                If IsValidDMY(payDateV) Then
                    Dim pd As Date: pd = ParseDMY(payDateV)
                    If useMonthly Then
                        If Month(pd) <> mPayMonth Or Year(pd) <> mPayYear Then SkipRow = True
                    ElseIf useYearly Then
                        If Year(pd) <> mPayYear Then SkipRow = True
                    End If
                Else
                    SkipRow = True
                End If
            End If
            If SkipRow Then GoTo NEXT_P1

            Dim exRateP1 As Double
            exRateP1 = val(gArrPayment(idx, 7))
            If exRateP1 <= 0 Then exRateP1 = 1
            Dim paidVal As Double: paidVal = val(gArrPayment(idx, 13)) * exRateP1
            Dim dateStr As String
            If IsDate(gArrPayment(idx, 17)) Then
                dateStr = Format(gArrPayment(idx, 17), "dd/mm/yyyy")
            ElseIf IsValidDMY(gArrPayment(idx, 17)) Then
                dateStr = Format(ParseDMY(gArrPayment(idx, 17)), "dd/mm/yyyy")
            Else
                dateStr = ""
            End If

            ' [MOD] Tinh sort key tu ngay (so ngay tu 01/01/1900)
            Dim sKey As Double: sKey = 0
            If dateStr <> "" Then
                On Error Resume Next
                sKey = CDbl(CDate(dateStr))
                On Error GoTo 0
            End If

            If grp = "A" Then
                If cntA > UBound(bufA, 1) - 1 Then
                    ReDim Preserve bufA(0 To UBound(bufA, 1) + 2000, 0 To 9)
                    ReDim Preserve cidA(0 To UBound(cidA) + 2000)
                    ReDim Preserve sortKeyA(0 To UBound(sortKeyA) + 2000)
                End If
                bufA(cntA, 0) = gArrPayment(idx, 16)
                bufA(cntA, 1) = dateStr
                bufA(cntA, 2) = gArrPayment(idx, 15)
                bufA(cntA, 3) = FastVN(val(gArrPayment(idx, 10)) * exRateP1)
                bufA(cntA, 4) = FastVN(val(gArrPayment(idx, 11)) * exRateP1)
                bufA(cntA, 5) = FastVN(val(gArrPayment(idx, 12)) * exRateP1)
                bufA(cntA, 6) = FastVN(val(gArrPayment(idx, 13)) * exRateP1)
                bufA(cntA, 7) = FastVN(val(gArrPayment(idx, 14)) * exRateP1)
                bufA(cntA, 8) = Trim$(CStr(gArrPayment(idx, 21)))
                cidA(cntA) = cidStr
                sortKeyA(cntA) = sKey
                mPaySumActA = mPaySumActA + val(gArrPayment(idx, 10)) * exRateP1
                mPaySumAccA = mPaySumAccA + val(gArrPayment(idx, 11)) * exRateP1
                mPaySumReqA = mPaySumReqA + val(gArrPayment(idx, 12)) * exRateP1
                mPaySumPaidA = mPaySumPaidA + paidVal
                mPaySumRemA = mPaySumRemA + val(gArrPayment(idx, 14)) * exRateP1
                cntA = cntA + 1
            Else
                If cntB > UBound(bufB, 1) - 1 Then
                    ReDim Preserve bufB(0 To UBound(bufB, 1) + 2000, 0 To 9)
                    ReDim Preserve cidB(0 To UBound(cidB) + 2000)
                    ReDim Preserve sortKeyB(0 To UBound(sortKeyB) + 2000)
                End If
                bufB(cntB, 0) = gArrPayment(idx, 16)
                bufB(cntB, 1) = dateStr
                bufB(cntB, 2) = gArrPayment(idx, 15)
                bufB(cntB, 3) = FastVN(val(gArrPayment(idx, 10)) * exRateP1)
                bufB(cntB, 4) = FastVN(val(gArrPayment(idx, 11)) * exRateP1)
                bufB(cntB, 5) = FastVN(val(gArrPayment(idx, 12)) * exRateP1)
                bufB(cntB, 6) = FastVN(val(gArrPayment(idx, 13)) * exRateP1)
                bufB(cntB, 7) = FastVN(val(gArrPayment(idx, 14)) * exRateP1)
                bufB(cntB, 8) = Trim$(CStr(gArrPayment(idx, 21)))
                cidB(cntB) = cidStr
                sortKeyB(cntB) = sKey
                mPaySumActB = mPaySumActB + val(gArrPayment(idx, 10)) * exRateP1
                mPaySumAccB = mPaySumAccB + val(gArrPayment(idx, 11)) * exRateP1
                mPaySumReqB = mPaySumReqB + val(gArrPayment(idx, 12)) * exRateP1
                mPaySumPaidB = mPaySumPaidB + paidVal
                mPaySumRemB = mPaySumRemB + val(gArrPayment(idx, 14)) * exRateP1
                cntB = cntB + 1
            End If
NEXT_P1:
        Next idx
NEXT_CID1:
    Next cid

    '==================================================================
    ' PASS 2 — Fallback cho B-CPB va tuong tu
    ' [MOD] Chi xu ly nhom A/B tuong ung neu duoc chon
    '==================================================================
    Dim dictP2Done As Object: Set dictP2Done = CreateObject("Scripting.Dictionary")
    Dim p2 As Long
    For p2 = 1 To UBound(gArrPayment, 1)
        Dim hCID As String: hCID = Trim$(CStr(gArrPayment(p2, 3)))
        If hCID = "" Then GoTo NEXT_P2
        If Trim$(CStr(gArrPayment(p2, 2))) <> "" Then GoTo NEXT_P2
        If Not dictHasLedger.exists(hCID) Then GoTo NEXT_P2
        If dictHasPaid.exists(hCID) Then GoTo NEXT_P2
        If dictP2Done.exists(hCID) Then GoTo NEXT_P2

        Dim hPaid As Double: hPaid = val(CStr(gArrPayment(p2, 13)))
        If hPaid = 0 Then GoTo NEXT_P2

        Dim hGrp As String
        If Left$(hCID, 2) = "A-" Then
            hGrp = "A"
        ElseIf Left$(hCID, 2) = "B-" Then
            hGrp = "B"
        Else
            hGrp = GetGroupFromContractArr(hCID)
            If hGrp = "" Then GoTo NEXT_P2
        End If

        ' [MOD] Bo qua nhom khong duoc chon
        If hGrp = "A" And Not showA Then GoTo NEXT_P2
        If hGrp = "B" And Not showB Then GoTo NEXT_P2

        ' --- Ap dung bo loc cboCategories ---
        If filterCat <> "" Then
            If Not gContractLoaded Then BuildGlobalContractCache
            If gDictContract.exists(hCID) Then
                Dim rCatP2 As Long: rCatP2 = gDictContract(hCID)
                If Trim$(CStr(gArrContract(rCatP2, 18))) <> filterCat Then GoTo NEXT_P2
            Else
                GoTo NEXT_P2
            End If
        End If

        Dim hDate As Date
        Dim hDateFound As Boolean: hDateFound = False
        If dictFirstDate.exists(hCID) Then
            hDate = dictFirstDate(hCID)
            hDateFound = True
        End If

        If useMonthly Or useYearly Then
            If Not hDateFound Then GoTo NEXT_P2
            If useMonthly Then
                If Month(hDate) <> mPayMonth Or Year(hDate) <> mPayYear Then GoTo NEXT_P2
            ElseIf useYearly Then
                If Year(hDate) <> mPayYear Then GoTo NEXT_P2
            End If
        End If

        Dim hExRate As Double: hExRate = val(CStr(gArrPayment(p2, 7)))
        Dim hPaidVND As Double
        If hExRate > 1 Then
            hPaidVND = hPaid * hExRate
        Else
            hPaidVND = hPaid
            hExRate = 0
        End If

        Dim hDateStr As String
        hDateStr = IIf(hDateFound, Format(hDate, "dd/mm/yyyy"), "")

        Dim hSortKey As Double: hSortKey = 0
        If hDateFound Then
            On Error Resume Next
            hSortKey = CDbl(hDate)
            On Error GoTo 0
        End If

        If hGrp = "B" Then
            If cntB > UBound(bufB, 1) - 1 Then
                ReDim Preserve bufB(0 To UBound(bufB, 1) + 2000, 0 To 9)
                ReDim Preserve cidB(0 To UBound(cidB) + 2000)
                ReDim Preserve sortKeyB(0 To UBound(sortKeyB) + 2000)
            End If
            bufB(cntB, 0) = hCID
            bufB(cntB, 1) = hDateStr
            bufB(cntB, 2) = Trim$(CStr(gArrPayment(p2, 15)))
            bufB(cntB, 6) = FastVN(hPaidVND)
            cidB(cntB) = hCID
            sortKeyB(cntB) = hSortKey
            mPaySumPaidB = mPaySumPaidB + hPaidVND
            cntB = cntB + 1
        Else
            If cntA > UBound(bufA, 1) - 1 Then
                ReDim Preserve bufA(0 To UBound(bufA, 1) + 2000, 0 To 9)
                ReDim Preserve cidA(0 To UBound(cidA) + 2000)
                ReDim Preserve sortKeyA(0 To UBound(sortKeyA) + 2000)
            End If
            bufA(cntA, 0) = hCID
            bufA(cntA, 1) = hDateStr
            bufA(cntA, 2) = Trim$(CStr(gArrPayment(p2, 15)))
            bufA(cntA, 6) = FastVN(hPaidVND)
            cidA(cntA) = hCID
            sortKeyA(cntA) = hSortKey
            mPaySumPaidA = mPaySumPaidA + hPaidVND
            cntA = cntA + 1
        End If

        dictP2Done(hCID) = 1
NEXT_P2:
    Next p2

    ' [MOD] Kiem tra co du lieu khong
    Dim hasData As Boolean
    hasData = (showA And cntA > 0) Or (showB And cntB > 0)

    If Not hasData Then
        Dim periodLbl As String: periodLbl = GetPayPeriodLabel()
        Dim grpLbl As String
        If showA And showB Then
            grpLbl = "A + B"
        ElseIf showA Then
            grpLbl = "A"
        Else
            grpLbl = "B"
        End If

        Exit Sub
    End If

    '==================================================================
    ' [MOD] SAP XEP THEO NGAY tang dan truoc khi xay final array
    '==================================================================
    If showA And cntA > 1 Then
        SortBufferByDate bufA, cidA, sortKeyA, cntA
    End If
    If showB And cntB > 1 Then
        SortBufferByDate bufB, cidB, sortKeyB, cntB
    End If

    '==================================================================
    ' XAY DUNG FINAL ARRAY
    ' [MOD] Chi them nhom A neu showA, chi them nhom B neu showB
    '==================================================================
    Dim totalRows As Long
    totalRows = 2  ' header row + separator

    If showA Then totalRows = totalRows + 1 + cntA  ' label A + rows A
    If showB Then totalRows = totalRows + 1 + cntB  ' label B + rows B

    Dim finalArr() As Variant
    ReDim finalArr(0 To totalRows - 1, 0 To 8)
    ReDim mPayRowContractID(0 To totalRows - 1)

    ' Dong header tong
    Dim sumActAll As Double, sumAccAll As Double, sumReqAll As Double
    Dim sumPaidAll As Double, sumRemAll As Double
    If showA Then
        sumActAll = sumActAll + mPaySumActA
        sumAccAll = sumAccAll + mPaySumAccA
        sumReqAll = sumReqAll + mPaySumReqA
        sumPaidAll = sumPaidAll + mPaySumPaidA
        sumRemAll = sumRemAll + mPaySumRemA
    End If
    If showB Then
        sumActAll = sumActAll + mPaySumActB
        sumAccAll = sumAccAll + mPaySumAccB
        sumReqAll = sumReqAll + mPaySumReqB
        sumPaidAll = sumPaidAll + mPaySumPaidB
        sumRemAll = sumRemAll + mPaySumRemB
    End If

    finalArr(0, 0) = "DN"
    finalArr(0, 1) = "Date"
    finalArr(0, 2) = "Description"
    finalArr(0, 3) = FastVN(sumActAll)
    finalArr(0, 4) = FastVN(sumAccAll)
    finalArr(0, 5) = FastVN(sumReqAll)
    If showA And showB Then
        finalArr(0, 6) = FastVN(mPaySumPaidA - mPaySumPaidB)
    Else
        finalArr(0, 6) = FastVN(sumPaidAll)
    End If
    finalArr(0, 7) = FastVN(sumRemAll)
    mPayRowContractID(0) = ""

    finalArr(1, 2) = "----------------------------"
    mPayRowContractID(1) = ""

    Dim NextRow As Long: NextRow = 2
    Dim r As Long, c As Long

    If showA Then
        finalArr(NextRow, 2) = "====  GROUP A  (" & cntA & ")  ===="
        mPayRowContractID(NextRow) = "GRP-LABEL-A"
        NextRow = NextRow + 1
        For r = 0 To cntA - 1
            For c = 0 To 8
                finalArr(NextRow, c) = bufA(r, c)
            Next c
            mPayRowContractID(NextRow) = cidA(r)
            NextRow = NextRow + 1
        Next r
    End If

    If showB Then
        finalArr(NextRow, 2) = "====  GROUP B  (" & cntB & ")  ===="
        mPayRowContractID(NextRow) = "GRP-LABEL-B"
        NextRow = NextRow + 1
        For r = 0 To cntB - 1
            For c = 0 To 8
                finalArr(NextRow, c) = bufB(r, c)
            Next c
            mPayRowContractID(NextRow) = cidB(r)
            NextRow = NextRow + 1
        Next r
    End If

    On Error Resume Next
    lstPayment.List = finalArr
    On Error GoTo 0

    lstPayment.ListIndex = 0
    lstPayment_Click
End Sub

'================================================================
' [MOD] SortBufferByDate: Sap xep mang buffer theo sort key tang dan
' Su dung Insertion Sort (hieu qua voi du lieu gan sap xep san)
'================================================================
Private Sub SortBufferByDate(buf() As Variant, cidArr() As String, _
                              keyArr() As Double, ByVal cnt As Long)
    Dim i As Long, j As Long
    Dim tempKey As Double
    Dim tempCid As String
    Dim tempRow(0 To 9) As Variant
    Dim k As Long

    For i = 1 To cnt - 1
        tempKey = keyArr(i)
        tempCid = cidArr(i)
        For k = 0 To 9: tempRow(k) = buf(i, k): Next k

        j = i - 1
        Do While j >= 0
            If keyArr(j) <= tempKey Then Exit Do
            keyArr(j + 1) = keyArr(j)
            cidArr(j + 1) = cidArr(j)
            For k = 0 To 9: buf(j + 1, k) = buf(j, k): Next k
            j = j - 1
        Loop

        keyArr(j + 1) = tempKey
        cidArr(j + 1) = tempCid
        For k = 0 To 9: buf(j + 1, k) = tempRow(k): Next k
    Next i
End Sub


Private Function GetPayPeriodLabel() As String
    On Error Resume Next
    If optPayAllTime.value Then
        GetPayPeriodLabel = "All Time"
    ElseIf optPayMonthly.value Then
        GetPayPeriodLabel = "Month " & mPayMonth & "/" & mPayYear
    ElseIf optPayYearly.value Then
        GetPayPeriodLabel = "Year " & mPayYear
    Else
        GetPayPeriodLabel = "All Time"
    End If
    On Error GoTo 0
End Function

'================================================================
' [MOD] Thay chkPaySelectAll_Click bang 2 handler rieng
'================================================================
Private Sub chkPayAllA_Click()
    LoadPaymentTab gCurrentContractID
End Sub

Private Sub chkPayAllB_Click()
    LoadPaymentTab gCurrentContractID
End Sub


'================================================================
' ClearPayDetail — Xóa toàn b? controls DYN_PD_* trong fraPayDetail
'================================================================
Private Sub ClearPayDetail()
    On Error Resume Next
    Dim ctrl As MSForms.Control
    Dim toDel() As String
    ReDim toDel(0 To fraPayDetail.Controls.count)
    Dim nDel As Long: nDel = 0
    For Each ctrl In fraPayDetail.Controls
        If Left$(ctrl.Name, 7) = "DYN_PD_" Then
            toDel(nDel) = ctrl.Name
            nDel = nDel + 1
        End If
    Next ctrl
    Dim j As Long
    For j = 0 To nDel - 1
        fraPayDetail.Controls.Remove toDel(j)
    Next j
    fraPayDetail.ScrollHeight = fraPayDetail.Height
    On Error GoTo 0
End Sub
'================================================================
' DrawPayDetail_Single — V? chi ti?t 1 dòng payment lên fraPayDetail
'================================================================
Private Sub DrawPayDetail_Single( _
    ByVal pNo As String, _
    ByVal pDate As String, _
    ByVal pDesc As String, _
    ByVal pActual As String, _
    ByVal pAccepted As String, _
    ByVal pRequested As String, _
    ByVal pPaid As String, _
    ByVal pRemaining As String, _
    ByVal pNote As String, _
    ByVal pPartyB As String, _
    ByVal pScope As String)

    On Error GoTo ERR_PD_SINGLE
    ClearPayDetail

    Dim frm As MSForms.Frame
    Set frm = fraPayDetail
    frm.ScrollTop = 0

    Dim sFontName As String
    sFontName = frm.Font.Name

    Dim wTotal As Single
    wTotal = frm.InsideWidth - 4
    If wTotal < 80 Then wTotal = 80
    frm.ScrollHeight = 2000

    Const PD_ROW_H As Single = 13
    Const PD_HDR_H As Single = 9
    Const PD_W_LBL As Single = 72
    Const PD_GAP   As Single = 1
    Const PD_GAP_S As Single = 2

    Dim wVal As Single:   wVal = wTotal - PD_W_LBL
    Dim Y As Single:      Y = 1
    Dim idxRow As Long:   idxRow = 0
    Dim useClr As Long

    ' Màu xanh navy (tr?ng thái neutral cho payment don l?)
    Dim clrHdr    As Long: clrHdr = RGB(31, 73, 125)
    Dim clrHdrTxt As Long: clrHdrTxt = RGB(255, 255, 255)
    Dim clrRow1   As Long: clrRow1 = RGB(220, 235, 255)
    Dim clrRow2   As Long: clrRow2 = RGB(205, 224, 255)

    '==============================================================
    ' SECTION 1: PAYMENT INFO
    '==============================================================
    Call ID_AddSectionHeader(frm, "DYN_PD_S0", "PAYMENT", _
                             Y, wTotal, PD_HDR_H, clrHdr, clrHdrTxt, sFontName)
    Y = Y + PD_HDR_H + PD_GAP_S

    If pNo <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " No", pNo, _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1
    End If

    If pDate <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Date", pDate, _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1
    End If

    ' Description: luôn hi?n th?, chi?u cao 1 dòng (không cao 2.5x)
    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Description", pDesc, _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    '==============================================================
    ' SECTION 2: AMOUNTS — luôn hi?n th? t?t c? label,
    '            giá tr? r?ng thì d? "0"
    '==============================================================
    Y = Y + PD_GAP_S
    Call ID_AddSectionHeader(frm, "DYN_PD_S1", "AMOUNTS", _
                             Y, wTotal, PD_HDR_H, clrHdr, clrHdrTxt, sFontName)
    Y = Y + PD_HDR_H + PD_GAP_S

    Dim dispActual As String:   dispActual = IIf(Trim$(pActual) <> "", pActual, "0")
    Dim dispAccepted As String: dispAccepted = IIf(Trim$(pAccepted) <> "", pAccepted, "0")
    Dim dispRequested As String: dispRequested = IIf(Trim$(pRequested) <> "", pRequested, "0")
    Dim dispPaid As String:     dispPaid = IIf(Trim$(pPaid) <> "", pPaid, "0")
    Dim dispRemaining As String: dispRemaining = IIf(Trim$(pRemaining) <> "", pRemaining, "0")

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Actual Vol", dispActual, _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Accepted Vol", dispAccepted, _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Requested", dispRequested, _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Paid", dispPaid, _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Remaining", dispRemaining, _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    '==============================================================
    ' SECTION 3: NOTES — luôn hi?n th? t?t c? label,
    '            ph?n nào không có n?i dung thì d? tr?ng ""
    '==============================================================
    Y = Y + PD_GAP_S
    Call ID_AddSectionHeader(frm, "DYN_PD_S2", "NOTES", _
                             Y, wTotal, PD_HDR_H, clrHdr, clrHdrTxt, sFontName)
    Y = Y + PD_HDR_H + PD_GAP_S

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Note", pNote, _
                   Y, PD_W_LBL, wVal, PD_ROW_H * 2, useClr, sFontName, 8)
    Y = Y + PD_ROW_H * 2 + PD_GAP: idxRow = idxRow + 1

    ' Ch? hi?n Party B và Scope of Work khi All A ho?c All B du?c check
    ' (khi không check c? hai, pPartyB = "" và pScope = "" ? ?n c? 2 dòng)
    If pPartyB <> "" Or pScope <> "" Then
        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Party B", pPartyB, _
                       Y, PD_W_LBL, wVal, PD_ROW_H * 1.5, useClr, sFontName, 8)
        Y = Y + PD_ROW_H * 1.5 + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Scope of Work", pScope, _
                       Y, PD_W_LBL, wVal, PD_ROW_H * 2, useClr, sFontName, 8)
        Y = Y + PD_ROW_H * 2 + PD_GAP: idxRow = idxRow + 1
    End If

    frm.ScrollHeight = Y + 4
    Exit Sub
ERR_PD_SINGLE:
    ShowMsgCenter "DrawPayDetail_Single Error: " & Err.Description
End Sub


'================================================================
' DrawPayDetail_SummaryPeriod — T?ng k?t theo k? l?c (không selectAll)
'================================================================
Private Sub DrawPayDetail_SummaryPeriod( _
    ByVal period As String, _
    ByVal rowCnt As Long, _
    ByVal sumAct As Double, _
    ByVal sumAcc As Double, _
    ByVal sumRq As Double, _
    ByVal sumPd As Double, _
    ByVal sumRm As Double)

    On Error GoTo ERR_PD_SUMP
    ClearPayDetail

    Dim frm As MSForms.Frame
    Set frm = fraPayDetail
    frm.ScrollTop = 0

    Dim sFontName As String
    sFontName = frm.Font.Name

    Dim wTotal As Single
    wTotal = frm.InsideWidth - 4
    If wTotal < 80 Then wTotal = 80

    Const PD_ROW_H As Single = 12
    Const PD_HDR_H As Single = 9
    Const PD_W_LBL As Single = 72
    Const PD_GAP   As Single = 1
    Const PD_GAP_S As Single = 2

    Dim wVal As Single:   wVal = wTotal - PD_W_LBL
    Dim Y As Single:      Y = 1
    Dim idxRow As Long:   idxRow = 0
    Dim useClr As Long

    ' Màu xám trung tính cho summary
    Dim clrHdr    As Long: clrHdr = RGB(80, 80, 80)
    Dim clrHdrTxt As Long: clrHdrTxt = RGB(255, 255, 255)
    Dim clrRow1   As Long: clrRow1 = RGB(240, 240, 240)
    Dim clrRow2   As Long: clrRow2 = RGB(228, 228, 228)

    ' Header = tên period
    Call ID_AddSectionHeader(frm, "DYN_PD_S0", period, _
                             Y, wTotal, PD_HDR_H, clrHdr, clrHdrTxt, sFontName)
    Y = Y + PD_HDR_H + PD_GAP_S

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Payments found", CStr(rowCnt), _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    '-- Amounts section --
    Y = Y + PD_GAP_S
    Call ID_AddSectionHeader(frm, "DYN_PD_S1", "AMOUNTS", _
                             Y, wTotal, PD_HDR_H, clrHdr, clrHdrTxt, sFontName)
    Y = Y + PD_HDR_H + PD_GAP_S

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Actual Vol", FastVN(sumAct), _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Accepted Vol", FastVN(sumAcc), _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Requested", FastVN(sumRq), _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Paid", FastVN(sumPd), _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    useClr = IIf(idxRow Mod 2 = 0, clrRow1, clrRow2)
    Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Remaining", FastVN(sumRm), _
                   Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
    Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

    frm.ScrollHeight = Y + 4
    Exit Sub
ERR_PD_SUMP:
    ShowMsgCenter "DrawPayDetail_SummaryPeriod Error: " & Err.Description
End Sub


'================================================================
' DrawPayDetail_SummaryAll — T?ng k?t Group A / Group B (chkPayAllA/B)
'================================================================
Private Sub DrawPayDetail_SummaryAll( _
    ByVal period As String, _
    ByVal showA As Boolean, ByVal cntA As Long, _
    ByVal actA As Double, ByVal accA As Double, _
    ByVal reqA As Double, ByVal paidA As Double, ByVal remA As Double, _
    ByVal showB As Boolean, ByVal cntB As Long, _
    ByVal actB As Double, ByVal accB As Double, _
    ByVal reqB As Double, ByVal paidB As Double, ByVal remB As Double)

    On Error GoTo ERR_PD_ALL
    ClearPayDetail

    Dim frm As MSForms.Frame
    Set frm = fraPayDetail
    frm.ScrollTop = 0

    Dim sFontName As String
    sFontName = frm.Font.Name

    Dim wTotal As Single
    wTotal = frm.InsideWidth - 4
    If wTotal < 80 Then wTotal = 80

    Const PD_ROW_H As Single = 12
    Const PD_HDR_H As Single = 9
    Const PD_W_LBL As Single = 72
    Const PD_GAP   As Single = 1
    Const PD_GAP_S As Single = 2

    Dim wVal As Single:   wVal = wTotal - PD_W_LBL
    Dim Y As Single:      Y = 1
    Dim idxRow As Long:   idxRow = 0
    Dim useClr As Long

    ' Header xám: dòng period
    Dim clrGrey   As Long: clrGrey = RGB(80, 80, 80)
    Dim clrWhite  As Long: clrWhite = RGB(255, 255, 255)
    Dim clrG1     As Long: clrG1 = RGB(240, 240, 240)
    Dim clrG2     As Long: clrG2 = RGB(228, 228, 228)

    Call ID_AddSectionHeader(frm, "DYN_PD_P", period, _
                             Y, wTotal, PD_HDR_H, clrGrey, clrWhite, sFontName)
    Y = Y + PD_HDR_H + PD_GAP_S

    '==============================================================
    ' GROUP A — màu xanh navy
    '==============================================================
    If showA Then
        Dim clrA  As Long: clrA = RGB(31, 73, 125)
        Dim clrA1 As Long: clrA1 = RGB(220, 235, 255)
        Dim clrA2 As Long: clrA2 = RGB(205, 224, 255)

        Y = Y + PD_GAP_S
        Call ID_AddSectionHeader(frm, "DYN_PD_SA", "GROUP A", _
                                 Y, wTotal, PD_HDR_H, clrA, clrWhite, sFontName)
        Y = Y + PD_HDR_H + PD_GAP_S

        useClr = IIf(idxRow Mod 2 = 0, clrA1, clrA2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Payments (A)", CStr(cntA), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrA1, clrA2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Actual Vol", FastVN(actA), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrA1, clrA2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Accepted Vol", FastVN(accA), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrA1, clrA2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Requested", FastVN(reqA), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrA1, clrA2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Paid A", FastVN(paidA), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrA1, clrA2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Remaining", FastVN(remA), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1
    End If

    '==============================================================
    ' GROUP B — màu xanh lá
    '==============================================================
    If showB Then
        Dim clrB  As Long: clrB = RGB(13, 120, 54)
        Dim clrB1 As Long: clrB1 = RGB(229, 245, 229)
        Dim clrB2 As Long: clrB2 = RGB(210, 235, 210)

        Y = Y + PD_GAP_S
        Call ID_AddSectionHeader(frm, "DYN_PD_SB", "GROUP B", _
                                 Y, wTotal, PD_HDR_H, clrB, clrWhite, sFontName)
        Y = Y + PD_HDR_H + PD_GAP_S

        useClr = IIf(idxRow Mod 2 = 0, clrB1, clrB2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Payments (B)", CStr(cntB), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrB1, clrB2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Actual Vol", FastVN(actB), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrB1, clrB2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Accepted Vol", FastVN(accB), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrB1, clrB2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Requested", FastVN(reqB), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrB1, clrB2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Paid B", FastVN(paidB), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1

        useClr = IIf(idxRow Mod 2 = 0, clrB1, clrB2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Remaining", FastVN(remB), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1
    End If

    '==============================================================
    ' NET: Paid A - Paid B (ch? hi?n khi có c? 2 nhóm)
    '==============================================================
    If showA And showB Then
        Dim clrNet    As Long: clrNet = RGB(120, 60, 0)
        Dim clrNetTxt As Long: clrNetTxt = RGB(255, 255, 255)

        Y = Y + PD_GAP_S
        Call ID_AddSectionHeader(frm, "DYN_PD_SC", "NET", _
                                 Y, wTotal, PD_HDR_H, clrNet, clrNetTxt, sFontName)
        Y = Y + PD_HDR_H + PD_GAP_S

        useClr = IIf(idxRow Mod 2 = 0, clrG1, clrG2)
        Call ID_AddRow(frm, "DYN_PD_R" & idxRow, " Paid A  -  Paid B", FastVN(paidA - paidB), _
                       Y, PD_W_LBL, wVal, PD_ROW_H, useClr, sFontName, 8)
        Y = Y + PD_ROW_H + PD_GAP: idxRow = idxRow + 1
    End If

    frm.ScrollHeight = Y + 4
    Exit Sub
ERR_PD_ALL:
    ShowMsgCenter "DrawPayDetail_SummaryAll Error: " & Err.Description
End Sub


'================================================================
' lstPayment_Click — [REWRITTEN] dùng fraPayDetail thay txtPayDetail
' Xóa toàn b? sub cu và thay b?ng sub này.
'================================================================
Private Sub lstPayment_Click()
    On Error GoTo SAFE_EXIT
    Dim idx As Long
    idx = lstPayment.ListIndex
    If idx < 0 Then Exit Sub
    If Trim$(CStr(lstPayment.List(idx, 0))) = "" Then Exit Sub

    Dim c0 As String
    c0 = Trim$(CStr(lstPayment.List(idx, 0)))

    If c0 = "DN" Then
        '--------------------------------------------------------------
        ' Dòng t?ng h?p (DN)
        '--------------------------------------------------------------
        Dim period As String
        On Error Resume Next
        period = GetPayPeriodLabel()
        On Error GoTo SAFE_EXIT

        Dim selectAllA As Boolean, selectAllB As Boolean
        On Error Resume Next
        selectAllA = chkPayAllA.value
        selectAllB = chkPayAllB.value
        On Error GoTo SAFE_EXIT
        Dim selectAll As Boolean
        selectAll = (selectAllA Or selectAllB)

        Dim useAllTime As Boolean
        On Error Resume Next
        useAllTime = optPayAllTime.value
        On Error GoTo SAFE_EXIT

        If Not selectAll And Not useAllTime Then
            '----------------------------------------------------------
            ' T?ng k?t theo k? l?c (không selectAll, không AllTime)
            '----------------------------------------------------------
            Dim sumAct As Double, sumAcc As Double
            Dim sumRq  As Double, sumPd  As Double, sumRm As Double
            Dim rowCnt As Long
            Dim k As Long
            For k = 0 To lstPayment.ListCount - 1
                Dim rKey As String
                rKey = Trim$(CStr(lstPayment.List(k, 0)))
                If rKey <> "" And rKey <> "DN" Then
                    rowCnt = rowCnt + 1
                    On Error Resume Next
                    sumAct = sumAct + ParseFormattedNumber(CStr(lstPayment.List(k, 3)))
                    sumAcc = sumAcc + ParseFormattedNumber(CStr(lstPayment.List(k, 4)))
                    sumRq = sumRq + ParseFormattedNumber(CStr(lstPayment.List(k, 5)))
                    sumPd = sumPd + ParseFormattedNumber(CStr(lstPayment.List(k, 6)))
                    sumRm = sumRm + ParseFormattedNumber(CStr(lstPayment.List(k, 7)))
                    On Error GoTo SAFE_EXIT
                End If
            Next k
            If rowCnt = 0 Then
                ClearPayDetail
            Else
                Call DrawPayDetail_SummaryPeriod(period, rowCnt, sumAct, sumAcc, sumRq, sumPd, sumRm)
            End If
        Else
            '----------------------------------------------------------
            ' selectAll = True: t?ng k?t Group A / Group B
            '----------------------------------------------------------
            Dim v3 As String, v4 As String, v5 As String, v6 As String, v7 As String
            v3 = Trim$(CStr(lstPayment.List(idx, 3)))
            v4 = Trim$(CStr(lstPayment.List(idx, 4)))
            v5 = Trim$(CStr(lstPayment.List(idx, 5)))
            v6 = Trim$(CStr(lstPayment.List(idx, 6)))
            v7 = Trim$(CStr(lstPayment.List(idx, 7)))

            If Not selectAll And (v3 & v4 & v5 & v6 & v7) = "" Then
                ClearPayDetail
            Else
                If selectAll Then
                    ' Ð?m s? dòng c?a t?ng nhóm hi?n th?
                    Dim cntDispA As Long: cntDispA = 0
                    Dim cntDispB As Long: cntDispB = 0
                    Dim kA As Long, kB As Long
                    For kA = 0 To lstPayment.ListCount - 1
                        Dim rKeyA As String: rKeyA = Trim$(CStr(lstPayment.List(kA, 0)))
                        If rKeyA <> "" And rKeyA <> "DN" Then
                            Dim cidCkA As String: cidCkA = ""
                            On Error Resume Next
                            If kA <= UBound(mPayRowContractID) Then cidCkA = mPayRowContractID(kA)
                            On Error GoTo SAFE_EXIT
                            If Left$(cidCkA, 2) = "A-" Or GetGroupFromContractArr(cidCkA) = "A" Then
                                cntDispA = cntDispA + 1
                            End If
                        End If
                    Next kA
                    For kB = 0 To lstPayment.ListCount - 1
                        Dim rKeyB As String: rKeyB = Trim$(CStr(lstPayment.List(kB, 0)))
                        If rKeyB <> "" And rKeyB <> "DN" Then
                            Dim cidCkB As String: cidCkB = ""
                            On Error Resume Next
                            If kB <= UBound(mPayRowContractID) Then cidCkB = mPayRowContractID(kB)
                            On Error GoTo SAFE_EXIT
                            If Left$(cidCkB, 2) = "B-" Or GetGroupFromContractArr(cidCkB) = "B" Then
                                cntDispB = cntDispB + 1
                            End If
                        End If
                    Next kB

                    Call DrawPayDetail_SummaryAll( _
                        period, _
                        selectAllA, cntDispA, mPaySumActA, mPaySumAccA, mPaySumReqA, mPaySumPaidA, mPaySumRemA, _
                        selectAllB, cntDispB, mPaySumActB, mPaySumAccB, mPaySumReqB, mPaySumPaidB, mPaySumRemB)
                Else
                    ' useAllTime = True, không selectAll: hi?n th? summary 1 dòng
                    Call DrawPayDetail_SummaryPeriod(period, 1, _
                        ParseFormattedNumber(v3), ParseFormattedNumber(v4), _
                        ParseFormattedNumber(v5), ParseFormattedNumber(v6), _
                        ParseFormattedNumber(v7))
                End If
            End If
        End If

    Else
        '--------------------------------------------------------------
        ' Dòng payment don l? (không ph?i DN)
        '--------------------------------------------------------------
        Dim pNote As String
        pNote = Trim$(CStr(lstPayment.List(idx, 8)))

        Dim pPartyB As String, pScope As String
        pPartyB = "": pScope = ""

        Dim saRow As Boolean
        On Error Resume Next
        saRow = (chkPayAllA.value Or chkPayAllB.value)
        On Error GoTo SAFE_EXIT

        If saRow Then
            Dim cidRow As String
            cidRow = ResolvePayRowContractID(idx)
            If cidRow <> "" Then
                GetContractInfo cidRow, pPartyB, pScope
            End If
        End If

        Call DrawPayDetail_Single( _
            CStr(lstPayment.List(idx, 0)), _
            CStr(lstPayment.List(idx, 1)), _
            CStr(lstPayment.List(idx, 2)), _
            CStr(lstPayment.List(idx, 3)), _
            CStr(lstPayment.List(idx, 4)), _
            CStr(lstPayment.List(idx, 5)), _
            CStr(lstPayment.List(idx, 6)), _
            CStr(lstPayment.List(idx, 7)), _
            pNote, pPartyB, pScope)

        '------------------------------------------------------------
        ' T? d?ng ch?n contract tuong ?ng bên lstResult ngay khi click
        ' (không c?n double-click n?a). B? qua dòng group/separator.
        '------------------------------------------------------------
        Dim contractID As String
        contractID = ResolvePayRowContractID(idx)
        If contractID <> "" Then
            If Left$(UCase$(contractID), 4) <> "GRP-" Then
                SelectContract contractID, False
            End If
        End If
    End If

SAFE_EXIT:
End Sub

Private Function ResolvePayRowContractID(ByVal idx As Long) As String
    Dim cid As String
    cid = ""

    On Error Resume Next
    Err.Clear
    cid = Trim$(CStr(mPayRowContractID(idx)))
    If Err.Number <> 0 Then
        Err.Clear
        cid = ""
    End If
    On Error GoTo 0

    If cid = "" Then cid = Trim$(gCurrentContractID)

    ResolvePayRowContractID = cid
End Function



Private Function GetContractInfo(ByVal contractID As String, _
                                 ByRef compB As String, _
                                 ByRef scopeW As String) As Boolean
    On Error Resume Next
    compB = "": scopeW = ""
    If Not gContractLoaded Then BuildGlobalContractCache
    If gDictContract Is Nothing Then Exit Function
    If Not gDictContract.exists(contractID) Then Exit Function
    Dim r As Long
    r = gDictContract(contractID)
    compB = Trim$(CStr(gArrContract(r, 8)))
    scopeW = Trim$(CStr(gArrContract(r, 11)))
    GetContractInfo = True
    On Error GoTo 0
End Function

Private Function ParseFormattedNumber(ByVal s As String) As Double
    On Error Resume Next
    ParseFormattedNumber = CDbl(Replace(Trim$(s), ".", ""))
End Function

Private Sub btnPaymentEntryTab_Click()
    If gCurrentContractID = "" Then ShowMsgCenter "No contract selected!": Exit Sub
    On Error Resume Next
    Me.MousePointer = fmMousePointerHourGlass
    Unload frmPaymentEntry
    Set frmPaymentEntry = Nothing
    DoEvents
    frmPaymentEntry.Show vbModeless
    frmPaymentEntry.InitFromContractFast gCurrentContractID
    Me.MousePointer = fmMousePointerDefault
End Sub

