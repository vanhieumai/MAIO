'================================================================
' LOAD SUMMARY BOX
'================================================================
Private Sub LoadSummaryBox(ByVal contractID As String)

    btnSummary.Caption = ""

    If contractID = "" Or contractID = "0" Then
        btnSummary.BackColor = RGB(200, 200, 200)
        btnSummary.ForeColor = RGB(100, 100, 100)
        Exit Sub
    End If

    Dim companyName    As String
    Dim contractStatus As String
    Dim displayNo2     As String
    companyName = "": contractStatus = "": displayNo2 = ""

    ' ---- S? HÐ hi?n th? d?y d? (k? c? chu?i t? tiên, HÐ g?c APP-/PKG-) ----
    displayNo2 = BuildDisplayContractNo(contractID)

    If Not gDictContract Is Nothing Then
        If gDictContract.exists(contractID) Then
            Dim r As Long
            r = gDictContract(contractID)

            ' Col 8/9 = Party B
            If Trim(CStr(gArrContract(r, 9))) <> "" Then
                companyName = Trim(CStr(gArrContract(r, 8))) & " | " & _
                              Trim(CStr(gArrContract(r, 9)))
            Else
                companyName = Trim(CStr(gArrContract(r, 8)))
            End If

            contractStatus = UCase(Trim(CStr(gArrContract(r, 6))))
        End If
    End If

    If displayNo2 <> "" And companyName <> "" Then
        btnSummary.Caption = displayNo2 & Chr(10) & companyName
    ElseIf displayNo2 <> "" Then
        btnSummary.Caption = displayNo2
    ElseIf companyName <> "" Then
        btnSummary.Caption = companyName
    Else
        btnSummary.Caption = contractID
    End If


    ' --- Màu theo tr?ng thái ---
    Select Case contractStatus
        Case "ACTIVE"
            btnSummary.BackColor = RGB(31, 73, 125)   ' xanh navy
            btnSummary.ForeColor = RGB(255, 255, 255) ' tr?ng
        Case "COMPLETED"
            btnSummary.BackColor = RGB(13, 120, 54)   ' xanh lá
            btnSummary.ForeColor = RGB(255, 255, 255)
        Case "CANCEL"
            btnSummary.BackColor = RGB(192, 0, 0)     ' d?
            btnSummary.ForeColor = RGB(255, 255, 255)
        Case Else
            btnSummary.BackColor = RGB(230, 230, 230) ' xám nh?t
            btnSummary.ForeColor = RGB(50, 50, 50)
    End Select

End Sub

Private Sub btnSummary_Click()
    ' Intentionally empty — button ch? hi?n th?, không có action
End Sub


'================================================================
' PUBLIC: Jump to a specific contract in the list
'================================================================
Public Sub SelectContract(ByVal contractID As String, _
                          Optional ByVal refreshActiveTab As Boolean = True)
    contractID = Trim$(contractID)
    If contractID = "" Or contractID = "0" Then Exit Sub
    If lstResult.ListCount = 0 Then Exit Sub

    Dim previousSuppress As Boolean
    previousSuppress = suppressListClick
    On Error GoTo SelectFailed

    Dim i As Long
    For i = 0 To lstResult.ListCount - 1
        If CStr(lstResult.List(i, 0)) = contractID Then
            suppressListClick = True
            lstResult.ListIndex = i
            suppressListClick = previousSuppress
            LoadContractDetail contractID, refreshActiveTab
            Exit Sub
        End If
    Next i
    Exit Sub

SelectFailed:
    suppressListClick = previousSuppress
    MsgBox "SelectContract: " & Err.Description, vbExclamation, "CPMS"
End Sub

'================================================================
' NAVIGATE TO SPECIFIC CONTRACT + DOCUMENT
' Duoc goi tu frmReminder khi an "Open Document"
'================================================================
Public Sub NavigateToDocument(ByVal contractID As String, _
                               ByVal documentID As String, _
                               Optional ByVal docType As String = "")

    On Error Resume Next

    ' 1. Tim va chon contract trong lstResult
    Dim found As Boolean: found = False
    Dim i As Long
    For i = 0 To lstResult.ListCount - 1
        If CStr(lstResult.List(i, 0)) = contractID Then
            suppressListClick = True
            lstResult.ListIndex = i
            suppressListClick = False
            found = True
            Exit For
        End If
    Next i

    If Not found Then
        LoadContractList ""
        For i = 0 To lstResult.ListCount - 1
            If CStr(lstResult.List(i, 0)) = contractID Then
                suppressListClick = True
                lstResult.ListIndex = i
                suppressListClick = False
                found = True
                Exit For
            End If
        Next i
    End If

    ' 2. Set option button + cboDocType theo docType
    If docType <> "" Then
        Select Case UCase(Trim(docType))

            Case "IPC", "INTERIM PAYMENT CERTIFICATE"
                optIPC.value = True
                cboDocType.Enabled = False

            Case "CON", "APP"
                optAll.value = True
                cboDocType.Enabled = False

            Case Else
                ' Other type: set optPDR, nap combo, chon dung type
                optPDR.value = True
                cboDocType.Enabled = True
                LoadDocTypeComboCS contractID
                Dim ci As Long
                For ci = 0 To cboDocType.ListCount - 1
                    If UCase(Trim$(CStr(cboDocType.List(ci)))) = _
                       UCase(Trim$(docType)) Then
                        cboDocType.ListIndex = ci
                        Exit For
                    End If
                Next ci

        End Select
    End If

    ' 3. Load thong tin hop dong va document list, chon document
    gCurrentContractID = contractID
    LoadContractDetail contractID
    LoadDocumentList contractID, documentID

    ' 4. Chuyen sang tab Document (index 1)
    tabMain.value = 1

    ' 5. Dua form len truoc
    Me.Show vbModeless

    On Error GoTo 0

End Sub

'================================================================
' CAP NHAT MAU NUT REMINDER
' Do: co doc dang Checking/Processing => Do
'     khong co => Xanh
'================================================================
Private Sub UpdateReminderButtonColor()

    On Error Resume Next

    Dim ws As Worksheet
    Set ws = GetDataSheet("DOCUMENT_TRACKER")
    If ws Is Nothing Then
        'btnReminder.BackColor = RGB(0, 150, 0)
        On Error GoTo 0
        Exit Sub
    End If

    Dim lastRow As Long
    lastRow = ws.Cells(ws.rows.count, "A").End(xlUp).Row

    Dim hasPending As Boolean
    hasPending = False

    Dim i As Long
    For i = 2 To lastRow
        Dim st As String
        st = UCase(Trim(CStr(ws.Cells(i, "O").value)))
        If st = "CHECKING" Or st = "PROCESSING" Then
            hasPending = True
            Exit For
        End If
    Next i

    If hasPending Then
        'btnReminder.BackColor = RGB(192, 0, 0)      ' Do
        'btnReminder.ForeColor = RGB(255, 255, 255)  ' chu trang
    Else
        'btnReminder.BackColor = RGB(0, 150, 0)      ' Xanh
        'btnReminder.ForeColor = RGB(255, 255, 255)  ' chu trang
    End If

    On Error GoTo 0

End Sub

'================================================================
' THEM VAO: frmContractSearch — Library Page
'
' HUONG DAN TICH HOP:
'
' 1. Dan toan bo code nay vao cuoi module cua frmContractSearch
'
' 2. Them dong nay vao tabMain_Change():
'       If tabMain.Value = 4 Then LoadLibraryPage
'
' 3. Them dong nay vao UserForm_Initialize():
'       EnsureLibraryDB
'
' 4. Them cac control sau vao tab Library (tabMain index = 4):
'
'   --- Frame: Contract ---
'   Label: lblLibContract    Caption="Contract"
'   Label: lblLibVO          Caption="Variation Orders"
'   Label: lblLibAppendix    Caption="Appendix"
'
'   --- Frame: Payment ---
'   Label: lblLibIPC         Caption="IPC (Interim Payment Certificate)"
'
'   --- Frame: Quality (QA/QC) ---
'   Label: lblLibITP         Caption="ITP (Inspection and Test Plan)"
'   Label: lblLibMIR         Caption="MIR (Material Inspection Request)"
'   Label: lblLibWIR         Caption="WIR (Work Inspection Request)"
'   Label: lblLibMAR         Caption="MAR (Material Acceptance Record)"
'   Label: lblLibIAR         Caption="IAR (Inspection Acceptance Record)"
'
'   --- Frame: Technical ---
'   Label: lblLibRFA         Caption="RFA (Request for Approval)"
'   Label: lblLibRFC         Caption="RFC (Request for Change)"
'   Label: lblLibRFI         Caption="RFI (Request for Information)"
'   Label: lblLibSI          Caption="SI (Site Instruction)"
'   Label: lblLibNCR         Caption="NCR (Non-Conformity Report)"
'   Label: lblLibCAR         Caption="CAR (Corrective Action Request)"
'   Label: lblLibTRN         Caption="TRN (Transmittal)"
'
'   --- Frame: Document Control ---
'   Label: lblLibMOM         Caption="MOM (Minutes of Meeting)"
'   Label: lblLibCMT         Caption="CMT (Comment Sheet)"
'   Label: lblLibLTR         Caption="LTR (Letter)"
'   Label: lblLibSR          Caption="SR (Site Report)"
'
'   --- Frame: Drawings ---
'   Label: lblLibAD          Caption="AD (Approved Drawings)"
'   Label: lblLibSD          Caption="SD (Shop Drawings)"
'   Label: lblLibABD         Caption="ABD (As-Built Drawings)"
'
'   --- Checkboxes ---
'   CheckBox: chkLibContractDocs   Caption="Contract Documents"
'   CheckBox: chkLibPaymentRec     Caption="Payment Records"
'   CheckBox: chkLibQualityRec     Caption="Quality Records"
'   CheckBox: chkLibTechDocs       Caption="Technical Documents"
'   CheckBox: chkLibDrawings       Caption="Drawings"
'   CheckBox: chkLibDocControl     Caption="Document Control Records"
'
'   --- Button ---
'   CommandButton: btnBuildPackage  Caption="Build Package"
'
' 5. Tab Library = tabMain.Value = 4
'
' THEM VAO tabMain_Change():
'   If tabMain.Value = 4 Then LoadLibraryPage
'================================================================

'================================================================
' LOAD LIBRARY PAGE
' Goi khi chuyen sang tab Library (tabMain.Value = 4)
' - Kiem tra LIBRARY_DB cho tung loai ho so
' - Cap nhat mau sac label (xanh = co template, xam = chua co)
' - Set ControlTipText (tooltip) cho tung nhan
'================================================================
Public Sub LoadLibraryPage()
    If mLibraryLoading Or mLibMetaEditing Then Exit Sub
    mLibraryLoading = True
    On Error GoTo ErrLib
    LibraryTrace "LoadLibraryPage: begin"
    LibraryTrace "LoadLibraryPage: metadata begin"
    RefreshLibraryMeta
    LibraryTrace "LoadLibraryPage: metadata done"
    RefreshAllLibraryLabels
    LibraryTrace "LoadLibraryPage: complete"
CleanLib:
    mLibraryLoading = False
    Exit Sub
ErrLib:
    LibraryTrace "LoadLibraryPage ERROR " & Err.Number & ": " & Err.Description
    MsgBox "Library could not be loaded: " & Err.Description & vbCrLf & _
        "Diagnostic log: " & Environ$("TEMP") & "\CPMS_Library_trace.log", vbExclamation, "CPMS Library"
    Resume CleanLib
End Sub

'================================================================
' REFRESH META LABELS (Project Code, Client, Main Con, Sup Con, Sub Con)
' Doc tu gArrContract col Z, hien thi len cac label gia tri
'================================================================
Private Sub RefreshLibraryMeta()
    Dim cid As String
    cid = Trim$(gCurrentContractID)

    ' 4 truong GLOBAL (dung chung, doc tu PROJECT_SETTINGS)
    Dim vProj    As String: vProj = GetGlobalSetting("PROJ")
    Dim vClient  As String: vClient = GetGlobalSetting("CLIENT")
    Dim vMainCon As String: vMainCon = GetGlobalSetting("MAINCON")
    Dim vSupCon  As String: vSupCon = GetGlobalSetting("SUPCON")

    ' SUBCON: rieng tung contract (doc tu col Z CONTRACT_DB)
    Dim vSubCon As String
    vSubCon = IIf(cid <> "", GetContractMetaField(cid, "SUBCON"), "")

    On Error Resume Next
    lblValProjCode.Caption = "Project Code: " & IIf(vProj <> "", vProj, "(none)")
    lblValClient.Caption = "Client: " & IIf(vClient <> "", vClient, "(none)")
    lblValMainCon.Caption = "Main Contractor: " & IIf(vMainCon <> "", vMainCon, "(none)")
    lblValSupCon.Caption = "Supervision Consultant: " & IIf(vSupCon <> "", vSupCon, "(none)")
    lblValSubCon.Caption = "Subcontractor: " & IIf(vSubCon <> "", vSubCon, "(none)")

    lblValProjCode.ControlTipText = "Ctrl+Click to edit  [shared across all contracts]"
    lblValClient.ControlTipText = "Ctrl+Click to edit  [shared across all contracts]"
    lblValMainCon.ControlTipText = "Ctrl+Click to edit  [shared across all contracts]"
    lblValSupCon.ControlTipText = "Ctrl+Click to edit  [shared across all contracts]"
    lblValSubCon.ControlTipText = "Ctrl+Click to edit  [per contract]"
    On Error GoTo 0
End Sub

'================================================================
' SHARED HANDLER: Ctrl+Click tren label meta
' -> InputBox de nhap/chinh sua gia tri, luu vao col Z CONTRACT_DB
'================================================================
Private Sub LibMeta_CtrlClick( _
        ByVal fieldKey As String, _
        ByVal Prompt As String)

    If mLibMetaEditing Then Exit Sub
    Dim previousSuppress As Boolean
    previousSuppress = suppressListClick
    mLibMetaEditing = True
    suppressListClick = True
    On Error GoTo Failed
    ' MouseUp has occurred; do not carry a label mouse capture into a modal dialog.
    LibReleaseCapture
    Dim editWorkbook As Workbook
    Set editWorkbook = GetDataWorkbook()
    Dim editCID As String
    editCID = Trim$(gCurrentContractID)

    Dim isGlobal As Boolean
    isGlobal = (UCase$(fieldKey) <> "SUBCON")

    ' SUBCON can chon contract truoc
    If Not isGlobal And Trim$(gCurrentContractID) = "" Then
        MsgCenter "Please select a contract first.", vbInformation
        GoTo CleanExit
    End If

    If Not isGlobal Then
        If lstResult.ListIndex < 0 Then GoTo SelectionChanged
        If Trim$(CStr(lstResult.List(lstResult.ListIndex, 0))) <> editCID Then GoTo SelectionChanged
        BuildGlobalContractCache
        If gDictContract Is Nothing Then GoTo SelectionChanged
        If Not gDictContract.Exists(editCID) Then GoTo SelectionChanged
    End If

    ' Lay gia tri hien tai
    Dim curVal As String
    If isGlobal Then
        curVal = GetGlobalSetting(fieldKey)
    Else
        curVal = GetContractMetaField(editCID, fieldKey)
    End If

    ' Tao tieu de InputBox
    Dim boxTitle As String
    If isGlobal Then
        boxTitle = "Edit " & Prompt & "  [shared - all contracts]"
    Else
        ' Hien thi contractNo thay vi contractID
        Dim contractNo As String
        contractNo = gCurrentContractID
        If Not gDictContract Is Nothing Then
            If gDictContract.Exists(gCurrentContractID) Then
                Dim r As Long
                r = gDictContract(gCurrentContractID)
                Dim cn As String
                cn = Trim$(CStr(gArrContract(r, 2)))
                If cn <> "" Then contractNo = cn
            End If
        End If
        boxTitle = "Edit " & Prompt & "  [contract: " & contractNo & "]"
    End If

    Dim newVal As String
    newVal = InputBox(Prompt & ":", boxTitle, curVal)
    If StrPtr(newVal) = 0 Then GoTo CleanExit   ' bam Cancel

    newVal = Trim$(newVal)

    Dim currentWorkbook As Workbook
    Set currentWorkbook = GetDataWorkbook()
    If Not (currentWorkbook Is editWorkbook) Then GoTo SelectionChanged
    If Not isGlobal Then
        If gCurrentContractID <> editCID Then GoTo SelectionChanged
        If lstResult.ListIndex < 0 Then GoTo SelectionChanged
        If Trim$(CStr(lstResult.List(lstResult.ListIndex, 0))) <> editCID Then GoTo SelectionChanged
    End If
    If newVal = curVal Then GoTo CleanExit

    ' Luu vao dung noi
    If isGlobal Then
        SaveGlobalSetting fieldKey, newVal
    Else
        SaveContractMetaField editCID, fieldKey, newVal
    End If

    RefreshLibraryMeta
CleanExit:
    suppressListClick = previousSuppress
    mLibMetaEditing = False
    Exit Sub
SelectionChanged:
    MsgBox "The selected contract or project has changed. Select the contract and try again.", vbExclamation, "Library"
    GoTo CleanExit
Failed:
    MsgBox "Cannot edit Library code: " & Err.Description, vbExclamation, "Library"
    Resume CleanExit
End Sub
'================================================================
' EVENTS — Meta Labels (Project Code, Client, v.v.)
' Ctrl+Click: nhap/sua gia tri
