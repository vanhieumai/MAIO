'================================================================
' DELETE ROW FROM DOCUMENT_TRACKER
'================================================================
Private Sub DeleteDocumentRow(ByVal documentID As String)

    On Error GoTo ERR_HANDLER

    Dim ws As Worksheet
    On Error Resume Next
    Set ws = GetDataSheet("DOCUMENT_TRACKER")
    On Error GoTo ERR_HANDLER

    If ws Is Nothing Then Exit Sub

    Dim lastRow As Long
    lastRow = ws.Cells(ws.rows.count, "A").End(xlUp).Row

    Dim i As Long

    For i = lastRow To 2 Step -1
        If Trim(CStr(ws.Cells(i, "A").value)) = Trim(documentID) Then
            ws.rows(i).Delete
            Exit For
        End If
    Next i

    Exit Sub

ERR_HANDLER:
    ShowMsgCenter "DeleteDocumentRow Error: " & Err.Description

End Sub

'================================================================
' OPEN FILE BUTTON
'================================================================
Private Sub btnDocOpenFile_Click()

    If lstDocument.ListIndex < 0 Then
        ShowMsgCenter "Please select a document!"
        Exit Sub
    End If

    Dim documentID As String
    documentID = CStr(lstDocument.List(lstDocument.ListIndex, 7))

    Dim ws As Worksheet
    On Error Resume Next
    Set ws = GetDataSheet("DOCUMENT_TRACKER")
    On Error GoTo 0

    If ws Is Nothing Then Exit Sub

    Dim lastRow As Long
    lastRow = ws.Cells(ws.rows.count, "A").End(xlUp).Row

    Dim i As Long
    Dim lnk As String
    Dim sheetRow As Long
    sheetRow = 0

    For i = 2 To lastRow
        If Trim(CStr(ws.Cells(i, "A").value)) = Trim(documentID) Then
            lnk = Trim(CStr(ws.Cells(i, "F").value))
            sheetRow = i
            Exit For
        End If
    Next i

    If lnk = "" Then
        ShowMsgCenter "No link found for this document!"
        Exit Sub
    End If

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")

    Dim fileOK As Boolean
    fileOK = False

    On Error Resume Next
    fileOK = fso.FileExists(lnk)
    On Error GoTo 0

    If fileOK Then
        On Error Resume Next
        Shell "explorer.exe """ & lnk & """", vbNormalFocus
        If Err.Number <> 0 Then
            Err.Clear
            ActiveWorkbook.FollowHyperlink lnk
        End If
        On Error GoTo 0
        Exit Sub
    End If

    Dim ans As VbMsgBoxResult
    ans = MsgCenter( _
        "Cannot open file:" & vbCrLf & lnk & vbCrLf & vbCrLf & _
        "File not found. Do you want to browse and select a new file?", _
        vbQuestion + vbYesNo, "File Not Found")

    If ans = vbNo Then Exit Sub

    Dim startFolder As String
    startFolder = ""

    On Error Resume Next
    If fso.FileExists(lnk) Then
        startFolder = fso.GetParentFolderName(lnk)
    Else
        Dim lastSlash As Long
        lastSlash = 0
        Dim k As Long
        For k = Len(lnk) To 1 Step -1
            If mID$(lnk, k, 1) = "\" Or mID$(lnk, k, 1) = "/" Then
                lastSlash = k
                Exit For
            End If
        Next k
        If lastSlash > 1 Then
            Dim tryFolder As String
            tryFolder = Left$(lnk, lastSlash - 1)
            If fso.FolderExists(tryFolder) Then
                startFolder = tryFolder
            End If
        End If
    End If
    On Error GoTo 0

    Dim fd As Object
    Set fd = Application.FileDialog(msoFileDialogFilePicker)

    With fd
        .title = "Select new file to replace link"
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "All Files", "*.*"
        .Filters.Add "PDF", "*.pdf"
        .Filters.Add "Word", "*.doc;*.docx"
        .Filters.Add "Excel", "*.xls;*.xlsx"
        If startFolder <> "" Then
            .InitialFileName = startFolder & "\"
        End If

        If .Show <> True Then Exit Sub

        Dim newLnk As String
        newLnk = .SelectedItems(1)
    End With

    If sheetRow > 0 Then
        ws.Cells(sheetRow, "F").value = newLnk
    End If

    LoadDocumentDetail documentID

    If MsgCenter("Link updated. Open the new file now?", _
              vbQuestion + vbYesNo, "Success") = vbYes Then
        On Error Resume Next
        Shell "explorer.exe """ & newLnk & """", vbNormalFocus
        If Err.Number <> 0 Then
            Err.Clear
            ActiveWorkbook.FollowHyperlink newLnk
        End If
        On Error GoTo 0
    End If

End Sub

'================================================================
' OPEN FOLDER BUTTON
'================================================================
Private Sub btnDocOpenFolder_Click()

    If lstDocument.ListIndex < 0 Then
        ShowMsgCenter "Please select a document!"
        Exit Sub
    End If

    Dim documentID As String
    documentID = CStr(lstDocument.List(lstDocument.ListIndex, 7))

    Dim ws As Worksheet
    On Error Resume Next
    Set ws = GetDataSheet("DOCUMENT_TRACKER")

    If ws Is Nothing Then Exit Sub

    Dim lastRow As Long
    lastRow = ws.Cells(ws.rows.count, "A").End(xlUp).Row

    Dim i As Long
    Dim lnk As String

    For i = 2 To lastRow
        If Trim(CStr(ws.Cells(i, "A").value)) = Trim(documentID) Then
            lnk = Trim(CStr(ws.Cells(i, "F").value))
            Exit For
        End If
    Next i

    On Error GoTo 0

    If lnk = "" Then
        ShowMsgCenter "No link found for this document!"
        Exit Sub
    End If

    Dim folderPath As String

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")

    On Error Resume Next

    If fso.FileExists(lnk) Then
        folderPath = fso.GetParentFolderName(lnk)
    ElseIf fso.FolderExists(lnk) Then
        folderPath = lnk
    Else
        Dim lastSlash As Long
        lastSlash = 0
        Dim k As Long
        For k = Len(lnk) To 1 Step -1
            If mID$(lnk, k, 1) = "\" Or mID$(lnk, k, 1) = "/" Then
                lastSlash = k
                Exit For
            End If
        Next k

        If lastSlash > 1 Then
            folderPath = Left$(lnk, lastSlash - 1)
        Else
            folderPath = lnk
        End If
    End If

    On Error GoTo 0

    If Trim(folderPath) = "" Then
        ShowMsgCenter "Cannot determine folder path!"
        Exit Sub
    End If

    On Error Resume Next
    Shell "explorer.exe """ & folderPath & """", vbNormalFocus
    If Err.Number <> 0 Then
        Err.Clear
        ShowMsgCenter "Cannot open folder: " & folderPath
    End If
    On Error GoTo 0

End Sub

