'================================================================
' BUILD PACKAGE BUTTON
' Doc trang thai cac checkbox, goi BuildDocumentPackage trong module
'================================================================
Private Sub btnBuildPackage_Click()

    Dim inclContract       As Boolean
    Dim inclPayment        As Boolean
    Dim inclQuality        As Boolean
    Dim inclTechnical      As Boolean
    Dim inclDrawings       As Boolean
    Dim inclDocCtrl        As Boolean
    Dim selectAllContracts As Boolean

    On Error Resume Next
    inclContract = chkLibContractDocs.value
    inclPayment = chkLibPaymentRec.value
    inclQuality = chkLibQualityRec.value
    inclTechnical = chkLibTechDocs.value
    inclDrawings = chkLibDrawings.value
    inclDocCtrl = chkLibDocControl.value
    selectAllContracts = chkLibSelectAll.value
    On Error GoTo 0

    If Not (inclContract Or inclPayment Or inclQuality _
         Or inclTechnical Or inclDrawings Or inclDocCtrl) Then
        ShowMsgCenter "Please select at least one document category.", vbExclamation
        Exit Sub
    End If

    If Not selectAllContracts And Trim$(gCurrentContractID) = "" Then
        ShowMsgCenter _
            "Please select a contract first." & vbCrLf & _
            "Or check ""Select All"" to export all contracts.", _
            vbExclamation
        Exit Sub
    End If

    '========================
    ' CH?N THU M?C ÐÍCH
    '========================
    Dim outFolder As String
    With Application.FileDialog(msoFileDialogFolderPicker)
        .title = "Select output folder for package"
        .AllowMultiSelect = False
        If .Show <> -1 Then Exit Sub
        outFolder = .SelectedItems(1)
    End With
    If Right$(outFolder, 1) <> "\" Then outFolder = outFolder & "\"

    '========================
    ' BUILD MAP T? lstResult:
    ' contractID -> seqNo & "|||" & contractNo
    ' Gi? dúng th? t? hi?n th? trong lstResult
    '========================
    Dim lstOrderMap As Object
    Set lstOrderMap = CreateObject("Scripting.Dictionary")

    Dim i As Long
    Dim cid As String
    Dim cno As String

    For i = 0 To lstResult.ListCount - 1
        cid = Trim$(CStr(lstResult.List(i, 0)))
        If cid <> "" And cid <> "0" Then
            cno = Trim$(CStr(lstResult.List(i, 2)))
            lstOrderMap(cid) = CStr(i) & "|||" & cno
        End If
    Next i

    '========================
    ' CATEGORY FILTER
    '========================
    Dim catFilter As String
    On Error Resume Next
    If cboCategories.ListIndex > 0 Then
        catFilter = Trim$(cboCategories.value)
    End If
    On Error GoTo 0

    '========================
    ' G?I SHEET LIST (TÍNH NANG CU)
    '========================
    'BuildDocumentPackage gCurrentContractID, _
    '                     inclContract, inclPayment, inclQuality, _
    '                     inclTechnical, inclDrawings, inclDocCtrl

    '========================
    ' BUILD ZIP (TÍNH NANG M?I)
    '========================
    BuildDocumentZipPackage _
        outFolder, lstOrderMap, _
        selectAllContracts, gCurrentContractID, catFilter, _
        inclContract, inclPayment, inclQuality, _
        inclTechnical, inclDrawings, inclDocCtrl

    Set lstOrderMap = Nothing

End Sub

Private Function FormatDocListNumber( _
        ByVal docType As String, _
        ByVal docNum As String) As String

    Dim t As String
    t = UCase(Trim$(docType))
    Dim s As String
    s = Trim$(docNum)

    If s = "" Then
        FormatDocListNumber = ""
        Exit Function
    End If

    Select Case t
        Case "CON"
            ' Contract: giu nguyen so hop dong
            FormatDocListNumber = s
        Case Else
            ' Tat ca loai khac (APP, IPC, CMT, ...):
            ' Trich short code + pad 2 chu so neu <10
            FormatDocListNumber = ExtractDocShortNumber(s)
    End Select

End Function

'----------------------------------------------------------------
' Trich short code tu document number
' Ho tro ca dinh dang "A.B.C.D.NNN" lan "PL-N" lan "PHU LUC N"
' Neu phan so chi 1 chu so -> pad thanh 2 chu so
' Vi du: "3" -> "03", "3A" -> "03A", "12" -> "12", "001" -> "001"
'----------------------------------------------------------------
Private Function ExtractDocShortNumber(ByVal docNum As String) As String

    If docNum = "" Then
        ExtractDocShortNumber = ""
        Exit Function
    End If

    ' Tim dau "." cuoi cung
    Dim lastDot As Long
    lastDot = 0
    Dim p As Long
    For p = Len(docNum) To 1 Step -1
        If mID$(docNum, p, 1) = "." Then
            lastDot = p
            Exit For
        End If
    Next p

    Dim tail As String
    If lastDot > 0 Then
        tail = Trim$(mID$(docNum, lastDot + 1))
    Else
        ' Khong co dau ".", thu dau "-" cuoi
        Dim lastDash As Long
        lastDash = 0
        For p = Len(docNum) To 1 Step -1
            If mID$(docNum, p, 1) = "-" Then
                lastDash = p
                Exit For
            End If
        Next p
        If lastDash > 0 Then
            tail = Trim$(mID$(docNum, lastDash + 1))
        Else
            ' Khong co delimiter nao, thu khoang trang cuoi (vi du "PHU LUC 3")
            Dim lastSp As Long
            lastSp = 0
            For p = Len(docNum) To 1 Step -1
                If mID$(docNum, p, 1) = " " Then
                    lastSp = p
                    Exit For
                End If
            Next p
            If lastSp > 0 Then
                tail = Trim$(mID$(docNum, lastSp + 1))
            Else
                tail = docNum
            End If
        End If
    End If

    If tail = "" Then
        ExtractDocShortNumber = docNum
        Exit Function
    End If

    ' Kiem tra co version letter o cuoi (A-Z)
    Dim lastChar As String
    lastChar = Right$(tail, 1)
    Dim hasVersion As Boolean
    hasVersion = (lastChar >= "A" And lastChar <= "Z") Or _
                 (lastChar >= "a" And lastChar <= "z")

    Dim numPart As String
    Dim verPart As String
    If hasVersion Then
        numPart = Left$(tail, Len(tail) - 1)
        verPart = UCase(lastChar)
    Else
        numPart = tail
        verPart = ""
    End If

    ' Kiem tra numPart toan chu so -> short code hop le
    If IsNumericOnly(numPart) And Len(numPart) > 0 Then
        ' Pad len 2 chu so neu chi co 1 chu so
        If Len(numPart) = 1 Then numPart = "0" & numPart
        ExtractDocShortNumber = numPart & verPart
    Else
        ExtractDocShortNumber = docNum       ' fallback: giu nguyen
    End If

End Function

'----------------------------------------------------------------
' Kiem tra chuoi chi gom cac chu so 0-9
'----------------------------------------------------------------
Private Function IsNumericOnly(ByVal s As String) As Boolean
    IsNumericOnly = False
    If Len(s) = 0 Then Exit Function
    Dim i As Long
    Dim ch As String
    For i = 1 To Len(s)
        ch = mID$(s, i, 1)
        If ch < "0" Or ch > "9" Then Exit Function
    Next i
    IsNumericOnly = True
End Function

'================================================================
' MUC 6 — THEM MOI: cboDocType_Change
'================================================================

Private Sub cboDocType_Change()
    On Error Resume Next
    If optPDR.value And gCurrentContractID <> "" Then
        LoadDocumentList gCurrentContractID
    End If
    On Error GoTo 0
    UpdateExportPreview
End Sub


'================================================================
' MUC 7 — THEM MOI: LoadDocTypeComboCS
' Nap unique doc types (khong phai IPC) cua hop dong hien tai
' vao cboDocType. Giu nguyen lua chon cu neu van con trong list.
'================================================================

Private Sub LoadDocTypeComboCS(ByVal contractID As String)

    On Error Resume Next

    ' Luu gia tri dang chon
    Dim prevVal As String
    prevVal = ""
    If cboDocType.ListIndex >= 0 Then
        prevVal = UCase(Trim$(CStr(cboDocType.value)))
    End If

    cboDocType.Clear

    If contractID = "" Then Exit Sub

    Dim ws As Worksheet
    Set ws = GetDataSheet("DOCUMENT_TRACKER")
    If ws Is Nothing Then Exit Sub

    Dim lastRow As Long
    lastRow = ws.Cells(ws.rows.count, "A").End(xlUp).Row
    If lastRow < 2 Then Exit Sub

    Dim dictTypes As Object
    Set dictTypes = CreateObject("Scripting.Dictionary")
    dictTypes.CompareMode = 1   ' case-insensitive

    Dim i As Long
    For i = 2 To lastRow
        If UCase(Trim$(CStr(ws.Cells(i, "B").value))) = _
           UCase(Trim$(contractID)) Then
            Dim dTyp As String
            dTyp = Trim$(CStr(ws.Cells(i, "C").value))
            ' Bo qua IPC (da co optIPC rieng)
            If dTyp <> "" And UCase(dTyp) <> "IPC" Then
                If Not dictTypes.exists(dTyp) Then
                    dictTypes(dTyp) = 1
                End If
            End If
        End If
    Next i

    Dim k As Variant
    For Each k In dictTypes.keys
        cboDocType.AddItem CStr(k)
    Next k

    ' Khoi phuc lua chon cu neu con trong list
    If prevVal <> "" Then
        Dim ci As Long
        For ci = 0 To cboDocType.ListCount - 1
            If UCase(Trim$(CStr(cboDocType.List(ci)))) = prevVal Then
                cboDocType.ListIndex = ci
                Exit For
            End If
        Next ci
    End If

    ' Neu chua co gi duoc chon va co item -> chon item dau
    If cboDocType.ListIndex < 0 And cboDocType.ListCount > 0 Then
        cboDocType.ListIndex = 0
    End If

    On Error GoTo 0

End Sub


'================================================================
' MUC 8 — THEM MOI: DocPassFilter (ham giup don gian hoa filter)
' Dung trong LoadDocumentList cho 2 vong lap dem va nap du lieu
'================================================================

Private Function DocPassFilter(ByVal dTypC As String, _
                                ByVal showIPC As Boolean, _
                                ByVal showOther As Boolean, _
                                ByVal showSpecific As Boolean, _
                                ByVal filterSpecific As String) As Boolean

    Dim t As String
    t = UCase(Trim$(dTypC))

    If showIPC Then
        ' Chi hien IPC
        DocPassFilter = (t = "IPC")
    ElseIf showSpecific Then
        ' Chi hien type cu the tu cboDocType
        DocPassFilter = (t = UCase(Trim$(filterSpecific)))
    ElseIf showOther Then
        ' Hien tat ca tru IPC
        DocPassFilter = (t <> "IPC")
    Else
        ' Hien tat ca (optAll)
        DocPassFilter = True
    End If

End Function

Private Sub Form_Open(Cancel As Integer)
    If Not IsActivated() Then
        MsgCenter "Software is not activated or license is invalid." & vbCrLf & _
               "Please contact your vendor to activate.", _
               vbCritical, "License Error"
        Cancel = True
    End If
End Sub























Private Sub LibraryTrace(ByVal stage As String)
    ' Local diagnostic file: each stage is flushed before the next operation.
    Dim f As Integer, opened As Boolean, p As String
    On Error GoTo Done
    p = Environ$("TEMP") & "\CPMS_Library_trace.log"
    f = FreeFile
    If Len(Dir$(p)) > 0 Then
        If FileLen(p) > 262144 Then
            Open p For Output As #f
            Close #f
        End If
    End If
    Open p For Append As #f
    opened = True
    Print #f, Format$(Now, "yyyy-mm-dd hh:nn:ss") & " | " & Format$(Timer, "0.000") & " | " & stage
Done:
    On Error Resume Next
    If opened Then Close #f
End Sub

Private Function LibraryText(ByVal value As Variant) As String
    If IsError(value) Or IsNull(value) Or IsEmpty(value) Then Exit Function
    LibraryText = Trim$(CStr(value))
End Function

Private Sub ReadLibrarySnapshot(ByVal cid As String, ByRef counts As Object, ByRef templates As Object)
    Dim wb As Workbook, ws As Worksheet, data As Variant
    Dim lastRow As Long, r As Long, key As String
    Set counts = CreateObject("Scripting.Dictionary")
    Set templates = CreateObject("Scripting.Dictionary")
    counts.CompareMode = vbTextCompare
    templates.CompareMode = vbTextCompare
    LibraryTrace "snapshot: get workbook"
    Set wb = GetDataWorkbook()
    Set ws = wb.Worksheets("DOCUMENT_TRACKER")
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    LibraryTrace "snapshot: read DOCUMENT_TRACKER rows=" & lastRow
    If lastRow >= 2 Then
        data = ws.Range("A2:C" & lastRow).Value2
        For r = 1 To UBound(data, 1)
            If Not IsError(data(r, 2)) And Not IsError(data(r, 3)) Then
                If cid = "" Or LibraryText(data(r, 2)) = cid Then
                    key = UCase$(LibraryText(data(r, 3)))
                    ' Preserve IPC alias used by CountDocTrackerByType.
                    If key = "THANH TOAN" Then key = "IPC"
                    If key <> "" Then
                        If Not counts.Exists(key) Then counts.Add key, CLng(0)
                        counts(key) = CLng(counts(key)) + 1
                    End If
                End If
            End If
        Next r
    End If
    LibraryTrace "snapshot: document counts ready"
    Set ws = Nothing
    On Error Resume Next
    Set ws = wb.Worksheets("LIBRARY_DB")
    On Error GoTo 0
    If ws Is Nothing Then Exit Sub
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    LibraryTrace "snapshot: read LIBRARY_DB rows=" & lastRow
    If lastRow >= 2 Then
        data = ws.Range("A2:C" & lastRow).Value2
        For r = 1 To UBound(data, 1)
            key = UCase$(LibraryText(data(r, 1)))
            If key <> "" Then
                If Not templates.Exists(key) Then templates.Add key, LibraryText(data(r, 3))
            End If
        Next r
    End If
    LibraryTrace "snapshot: templates ready"
End Sub
