Private Sub tabMain_Change()
    If mLibMetaEditing Or mLibraryLoading Then Exit Sub
    LibraryTrace "tabMain_Change: page=" & tabMain.Value

    If tabMain.value = 1 Then

        If gCurrentContractID <> "" Then
            LoadDocumentList gCurrentContractID
        ElseIf lstResult.ListIndex >= 0 Then
            Dim cid As String
            cid = CStr(lstResult.List(lstResult.ListIndex, 0))
            If cid <> "0" Then
                LoadDocumentList cid
            End If
        End If

    End If
    If tabMain.value = 2 Then LoadLibraryPage 'InitPaymentTab
    If tabMain.value = 3 Then InitPaymentTab 'InitExportTab
    If tabMain.value = 4 Then InitProgressTab
    If tabMain.value = 5 Then InitExportTab 'LoadLibraryPage

End Sub

