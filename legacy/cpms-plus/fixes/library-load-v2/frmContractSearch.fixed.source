'================================================================
' REFRESH ALL LIBRARY LABELS
' [FIX] Caption hien thi so record neu > 0: "LTR (Letter):5"
'       Tooltip don gian: chi hien thi thong tin template
'================================================================
Private Sub RefreshAllLibraryLabels()
    If mLibraryLabelsLoading Then Exit Sub
    mLibraryLabelsLoading = True
    On Error GoTo Failed
    Dim counts As Object, templates As Object
    Dim i As Integer
    Dim cidFilter As String
    cidFilter = Trim$(gCurrentContractID)

    ReadLibrarySnapshot cidFilter, counts, templates

    For i = 0 To 24
        Dim dt As String
        Dim nm As String
        dt = LibDocType(i)
        nm = LibLabelName(i)
        If dt = "" Or nm = "" Then GoTo NEXT_LBL

        Dim ctl As Object
        On Error Resume Next
        Set ctl = Nothing
        Set ctl = Me.Controls(nm)
        On Error GoTo Failed
        If ctl Is Nothing Then GoTo NEXT_LBL

        ' Template path lay tu LIBRARY_DB (dung chung)
        Dim tplPath As String
        tplPath = ""
        If templates.Exists(dt) Then tplPath = CStr(templates(dt))

        ' So luong records tu DOCUMENT_TRACKER loc theo contract hien tai
        Dim recCount As Long
        recCount = 0
        If counts.Exists(dt) Then recCount = CLng(counts(dt))
        LibraryTrace "label: " & nm

        ' Mau sac: xanh dam = co template, xam = chua co
        'If tplPath <> "" Then
        '    ctl.ForeColor = RGB(0, 0, 139)
        'Else
        '    ctl.ForeColor = RGB(120, 120, 120)
        'End If
        ' Mau sac:
        '   Den        = co record (uu tien cao nhat)
        '   Xanh dam   = co template nhung chua co record
        '   Xam        = chua co template va chua co record
        ctl.ForeColor = RGB(120, 120, 120)
        If recCount > 0 Then
            ctl.ForeColor = RGB(135, 83, 11)            ' cam
            If tplPath <> "" Then
                ctl.ForeColor = RGB(40, 81, 184)          ' do
            End If
        Else
            If tplPath <> "" Then
                ctl.ForeColor = RGB(138, 39, 93)    ' xanh
            End If 'Else
        '    ctl.ForeColor = RGB(120, 120, 120)      ' Xam
        End If
        
        ctl.Font.Underline = True

        ' Pad abbrev sang trai den 4 ky tu de can chinh dot leaders
        Dim abbrev As String
        Dim abbrevPad As String
        abbrev = LibDocAbbrev(dt)
        abbrevPad = Left$(abbrev & "    ", 4)   ' max 4 chars
        ctl.Caption = abbrevPad & ": " & String(3, ".") & " " & Format(recCount, "00")
        
        ' Tooltip: hien thi ten day du khi hover chuot
        ctl.ControlTipText = GetDocTypeName(dt) & vbCrLf & _
                             "Template: " & IIf(tplPath <> "", tplPath, "(not set)") & vbCrLf & _
                             "Records: " & recCount

        Set ctl = Nothing
NEXT_LBL:
    Next i
    mLibraryLabelsLoading = False
    LibraryTrace "labels: complete"
    Exit Sub
Failed:
    Dim errorNumber As Long, errorDescription As String
    errorNumber = Err.Number
    errorDescription = Err.Description
    mLibraryLabelsLoading = False
    LibraryTrace "labels ERROR " & errorNumber & ": " & errorDescription
    Err.Raise errorNumber, "frmContractSearch.RefreshAllLibraryLabels", errorDescription
End Sub

'================================================================
' MAP DOCTYPE CODE -> VIET TAT HIEN THI TREN LABEL
' CONTRACT -> CON, APPENDIX -> APP, cac loai khac giu nguyen
'================================================================
Private Function LibDocAbbrev(ByVal docType As String) As String
    Select Case UCase$(Trim$(docType))
        Case "CON":       LibDocAbbrev = "CON"
        Case "APP":       LibDocAbbrev = "APP"
        Case "VO":        LibDocAbbrev = "VO"
        Case "IPC":       LibDocAbbrev = "IPC"
        Case "ITP":       LibDocAbbrev = "ITP"
        Case "MIR":       LibDocAbbrev = "MIR"
        Case "WIR":       LibDocAbbrev = "WIR"
        Case "MAR":       LibDocAbbrev = "MAR"
        Case "IAR":       LibDocAbbrev = "IAR"
        Case "RFA":       LibDocAbbrev = "RFA"
        Case "RFC":       LibDocAbbrev = "RFC"
        Case "RFI":       LibDocAbbrev = "RFI"
        Case "SI":        LibDocAbbrev = "SI"
        Case "NCR":       LibDocAbbrev = "NCR"
        Case "CAR":       LibDocAbbrev = "CAR"
        Case "TRN":       LibDocAbbrev = "TRN"
        Case "MOM":       LibDocAbbrev = "MOM"
        Case "CMT":       LibDocAbbrev = "CMT"
        Case "LTR":       LibDocAbbrev = "LTR"
        Case "SR":        LibDocAbbrev = "SR"
        Case "MOH":        LibDocAbbrev = "MOH"
        Case "AD":        LibDocAbbrev = "AD"
        Case "SD":        LibDocAbbrev = "SD"
        Case "ABD":       LibDocAbbrev = "ABD"
        Case "SPT":       LibDocAbbrev = "SPT"
        Case Else:        LibDocAbbrev = docType
    End Select
End Function
'================================================================
' MAP INDEX -> DOCTYPE CODE
'================================================================
Private Function LibDocType(ByVal idx As Integer) As String
    Select Case idx
        Case 0:  LibDocType = "CON"
        Case 1:  LibDocType = "APP"
        Case 2:  LibDocType = "VO"
        Case 3:  LibDocType = "IPC"
        Case 4:  LibDocType = "ITP"
        Case 5:  LibDocType = "MIR"
        Case 6:  LibDocType = "WIR"
        Case 7:  LibDocType = "MAR"
        Case 8:  LibDocType = "IAR"
        Case 9:  LibDocType = "RFA"
        Case 10: LibDocType = "RFC"
        Case 11: LibDocType = "RFI"
        Case 12: LibDocType = "SI"
        Case 13: LibDocType = "NCR"
        Case 14: LibDocType = "CAR"
        Case 15: LibDocType = "TRN"
        Case 16: LibDocType = "MOM"
        Case 17: LibDocType = "CMT"
        Case 18: LibDocType = "LTR"
        Case 19: LibDocType = "SR"
        Case 20: LibDocType = "AD"
        Case 21: LibDocType = "SD"
        Case 22: LibDocType = "ABD"
        Case 23: LibDocType = "MOH"
        Case 24: LibDocType = "SPT"
        Case Else: LibDocType = ""
    End Select
End Function

'================================================================
' MAP INDEX -> LABEL CONTROL NAME
'================================================================
Private Function LibLabelName(ByVal idx As Integer) As String
    Select Case idx
        Case 0:  LibLabelName = "lblLibContract"
        Case 1:  LibLabelName = "lblLibAppendix"
        Case 2:  LibLabelName = "lblLibVO"
        Case 3:  LibLabelName = "lblLibIPC"
        Case 4:  LibLabelName = "lblLibITP"
        Case 5:  LibLabelName = "lblLibMIR"
        Case 6:  LibLabelName = "lblLibWIR"
        Case 7:  LibLabelName = "lblLibMAR"
        Case 8:  LibLabelName = "lblLibIAR"
        Case 9:  LibLabelName = "lblLibRFA"
        Case 10: LibLabelName = "lblLibRFC"
        Case 11: LibLabelName = "lblLibRFI"
        Case 12: LibLabelName = "lblLibSI"
        Case 13: LibLabelName = "lblLibNCR"
        Case 14: LibLabelName = "lblLibCAR"
        Case 15: LibLabelName = "lblLibTRN"
        Case 16: LibLabelName = "lblLibMOM"
        Case 17: LibLabelName = "lblLibCMT"
        Case 18: LibLabelName = "lblLibLTR"
        Case 19: LibLabelName = "lblLibSR"
        Case 20: LibLabelName = "lblLibAD"
        Case 21: LibLabelName = "lblLibSD"
        Case 22: LibLabelName = "lblLibABD"
        Case 23: LibLabelName = "lblLibMOH"
        Case 24: LibLabelName = "lblLibSPT"
        Case Else: LibLabelName = ""
    End Select
End Function

'================================================================
' SHARED HANDLER: Double-click tren nhan Library
' -> Mo template (hoac chon moi neu chua co)
' -> Lam moi mau sac nhan sau khi luu
'================================================================
Private Sub LibLabel_DblClick(ByVal docType As String)
    OpenTemplate docType
    RefreshAllLibraryLabels   ' Cap nhat mau sau khi co the da luu template moi
End Sub

'================================================================
' SHARED HANDLER: Click chuot phai tren nhan Library
' -> Mo frmDocumentManagement voi contract hien tai + loai ho so
'================================================================
Private Sub LibLabel_RightClick(ByVal docType As String)
    OpenDocumentEditFromLibrary gCurrentContractID, docType
    'ShowDocumentManagement gCurrentContractID, docType
End Sub

'================================================================
' SHARED HANDLER: Ctrl+Click tren nhan Library
' -> Luon mo File Picker de chon lai / thay doi link template
'================================================================
Private Sub LibLabel_CtrlClick(ByVal docType As String)
    ForcePickTemplate docType
    RefreshAllLibraryLabels
End Sub

'================================================================
' SHARED HANDLER: Shift+Click tren nhan Library
' -> Xoa link template cua loai ho so nay (co xac nhan)
'================================================================
Private Sub LibLabel_ShiftClick(ByVal docType As String)

    Dim curPath As String
    curPath = GetTemplatePath(docType)

    If curPath = "" Then
        MsgCenter "No template has been assigned for: " & GetDocTypeName(docType), _
               vbInformation, "Template Not Found"
        Exit Sub
    End If

    Dim ans As Integer

    ans = MsgCenter("Remove the template link for [" & GetDocTypeName(docType) & "]?" & vbCrLf & vbCrLf & _
                 curPath, _
                 vbQuestion + vbYesNo, _
                 "Remove Template")

    If ans = vbYes Then
        SaveTemplatePath docType, ""
        RefreshAllLibraryLabels
    End If

End Sub

