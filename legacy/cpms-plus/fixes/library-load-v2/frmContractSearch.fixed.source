'================================================================
' ADD DOCUMENT BUTTON
'================================================================
Private Sub btnDocAdd_Click()

    If gCurrentContractID = "" Then
        If lstResult.ListIndex < 0 Then
            ShowMsgCenter "Please select a contract first!"
            Exit Sub
        End If
        gCurrentContractID = CStr(lstResult.List(lstResult.ListIndex, 0))
        If gCurrentContractID = "0" Then
            gCurrentContractID = ""
            ShowMsgCenter "Please select a valid contract!"
            Exit Sub
        End If
    End If

    Dim r As Long
    Dim contractNo As String, contractValue As String
    Dim company As String, hangMuc As String
    Dim fromDate As String, toDate As String

    If Not gDictContract Is Nothing Then
        If gDictContract.exists(gCurrentContractID) Then
            r = gDictContract(gCurrentContractID)
            contractNo = Trim(CStr(gArrContract(r, 2)))
            contractValue = FastVN(gArrContract(r, 15))
            company = Trim(CStr(gArrContract(r, 8)))
            hangMuc = Trim(CStr(gArrContract(r, 11)))
            If IsDate(gArrContract(r, 4)) Then fromDate = Format(gArrContract(r, 4), "dd/mm/yyyy")
            If IsDate(gArrContract(r, 5)) Then toDate = Format(gArrContract(r, 5), "dd/mm/yyyy")
        End If
    End If

    If Not mDocEditForm Is Nothing Then
        Unload mDocEditForm
        Set mDocEditForm = Nothing
    End If

    Set mDocEditForm = New frmDocumentEdit

    mDocEditForm.InitNew _
        contractID:=gCurrentContractID, _
        contractNo:=contractNo, _
        contractValue:=contractValue, _
        company:=company, _
        hangMuc:=hangMuc, _
        fromDate:=fromDate, _
        toDate:=toDate

    mDocEditForm.SetCallback Me, gCurrentContractID

    mDocEditForm.Show vbModeless

End Sub

