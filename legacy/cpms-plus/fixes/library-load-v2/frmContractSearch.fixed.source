    If IsNumeric(txtPayMonth.Text) Then
        Dim m As Long: m = CLng(txtPayMonth.Text)
        If m >= 1 And m <= 12 Then mPayMonth = m: LoadPaymentTab gCurrentContractID
    End If
    On Error GoTo 0
End Sub
Private Sub txtPayYear_Change()
    On Error Resume Next
    If IsNumeric(txtPayYear.Text) Then
        Dim Y As Long: Y = CLng(txtPayYear.Text)
        If Y >= 2000 And Y <= 2100 Then mPayYear = Y: LoadPaymentTab gCurrentContractID
    End If
    On Error GoTo 0
End Sub

'================================================================
' INIT TAB EXPORT
'================================================================
Private Sub InitExportTab()

    If mExpMonth = 0 Then mExpMonth = Month(Now)
    If mExpYear = 0 Then mExpYear = Year(Now)

    On Error Resume Next
    txtExpMonth.Text = CStr(mExpMonth)
    txtExpYear.Text = CStr(mExpYear)
    On Error GoTo 0

    On Error Resume Next
    If Not optMonthly.value And Not optYearly.value Then
        optAllTime.value = True
    End If
    On Error GoTo 0

    UpdateExportControlState
    UpdateExportPreview

End Sub

'================================================================
' UPDATE CONTROL ENABLE/DISABLE STATE
'================================================================
Private Sub UpdateExportControlState()

    Dim useMonthly As Boolean
    Dim useYearly  As Boolean

    On Error Resume Next
    useMonthly = optMonthly.value
    useYearly = optYearly.value
    On Error GoTo 0

    On Error Resume Next
    btnThisMonth.Enabled = useMonthly
    btnMonthPrev.Enabled = useMonthly
    txtExpMonth.Enabled = useMonthly
    btnMonthNext.Enabled = useMonthly

    btnThisYear.Enabled = (useMonthly Or useYearly)
    btnYearPrev.Enabled = (useMonthly Or useYearly)
    txtExpYear.Enabled = (useMonthly Or useYearly)
    btnYearNext.Enabled = (useMonthly Or useYearly)
    On Error GoTo 0

End Sub

'================================================================
' UPDATE PREVIEW TEXT
'================================================================
Private Sub UpdateExportPreview()

    On Error Resume Next

    Dim sb As String
    Dim NL As String: NL = vbCrLf
    'Dim T  As String: T = Chr(9)           ' <<< THEM DONG NAY

    sb = "=== EXPORT SUMMARY ===" & NL & NL

    Dim useAll As Boolean
    useAll = chkSelectAll.value
    Dim useManualPrev As Boolean
    useManualPrev = chkSelectManual.value

    If useAll Then
        Dim nList As Long
        nList = 0
        Dim ui2 As Long
        For ui2 = 0 To lstResult.ListCount - 1
            Dim cxp As String
            cxp = Trim(CStr(lstResult.List(ui2, 0)))
            If cxp <> "" And cxp <> "0" Then nList = nList + 1
        Next ui2
        If chkIncludeCancel.value Then
            sb = sb & "  " & Left$("Contract" & Space$(10), 10) & Chr(9) & ": All filtered contracts in list (" & nList & " contracts, incl. Cancelled)" & NL
        Else
            sb = sb & "  " & Left$("Contract" & Space$(10), 10) & Chr(9) & ": All filtered contracts in list (" & nList & " contracts, excl. Cancelled)" & NL
        End If
    ElseIf useManualPrev Then
        Dim nSel As Long
        nSel = 0
        Dim si2 As Long
        For si2 = 0 To lstResult.ListCount - 1
            If lstResult.Selected(si2) Then
                Dim csp As String
                csp = Trim(CStr(lstResult.List(si2, 0)))
                If csp <> "" And csp <> "0" Then nSel = nSel + 1
            End If
        Next si2
        sb = sb & "  " & Left$("Contract" & Space$(10), 10) & Chr(9) & ": Manually selected (" & nSel & " contract(s) selected)" & NL
    Else
        If gCurrentContractID <> "" Then
            Dim dispName As String
            dispName = ""
            If Not gDictContract Is Nothing Then
                If gDictContract.exists(gCurrentContractID) Then
                    Dim rr As Long
                    rr = gDictContract(gCurrentContractID)
                    Dim contractNo As String
                    contractNo = Trim$(CStr(gArrContract(rr, 2)))
                    If contractNo <> "" Then dispName = contractNo
                End If
            End If
            sb = sb & "  " & Left$("Contract" & Space$(10), 10) & Chr(9) & ": " & dispName & NL
        Else
            sb = sb & "  " & Left$("Contract" & Space$(10), 10) & Chr(9) & ": (no contract selected)" & NL
        End If
    End If

    Dim useMonthly As Boolean
    Dim useYearly  As Boolean
    useMonthly = optMonthly.value
    useYearly = optYearly.value

    If useMonthly Then
        sb = sb & "  " & Left$("Period" & Space$(10), 10) & Chr(9) & ": Month " & mExpMonth & "/" & mExpYear & NL
    ElseIf useYearly Then
        sb = sb & "  " & Left$("Period" & Space$(10), 10) & Chr(9) & ": Year " & mExpYear & NL
    Else
        sb = sb & "  " & Left$("Period" & Space$(10), 10) & Chr(9) & ": All Time (no time filter)" & NL
    End If

    sb = sb & NL & "Content to export:" & NL


    Dim hasAny As Boolean
    hasAny = False

    If chkContractInfo.value Then
        sb = sb & "  [v] Contract Information" & NL
        hasAny = True
    End If
    If chkDocTracking.value Then
        sb = sb & "  [v] Document Tracking" & NL
        hasAny = True
    End If
    If chkPayment.value Then
        sb = sb & "  [v] Payment Report" & NL
        hasAny = True
    End If
    If chkConsolidatedReport.value Then
        sb = sb & "  [v] Consolidated Contract Report (separate sheet)" & NL
        hasAny = True
    End If

    If Not hasAny Then
        sb = sb & "  (No content selected)" & NL
    End If



    txtExportPreview.Text = sb

    On Error GoTo 0

End Sub

'================================================================
' COUNT CONTRACTS IN EXPORT LIST
'================================================================
Private Function CountExportContracts(ByVal inclCancel As Boolean, _
                                       ByVal filterMode As String, _
                                       ByVal filterMonth As Long, _
                                       ByVal filterYear As Long, _
                                       ByVal byPayment As Boolean) As Long
    CountExportContracts = 0
    Dim contractList() As String
    Dim cCount As Long
    Dim bldFilterCat As String: bldFilterCat = ""
    On Error Resume Next
    If cboCategories.ListIndex > 0 Then bldFilterCat = Trim$(cboCategories.value)
    On Error GoTo 0
    BuildAllContractList contractList, cCount, inclCancel, bldFilterCat
    If filterMode <> "all" Then
        If byPayment Then
            FilterListByPayment contractList, cCount, filterMode, filterMonth, filterYear, inclCancel
        Else
            FilterListBySigningDate contractList, cCount, filterMode, filterMonth, filterYear
        End If
    End If
    CountExportContracts = cCount
End Function

'================================================================
' FILTER: Only keep contracts with payments in the period
'================================================================
Private Sub FilterListByPayment(contractList() As String, ByRef cCount As Long, _
                                 ByVal filterMode As String, ByVal filterMonth As Long, _
                                 ByVal filterYear As Long, ByVal inclCancel As Boolean)
    If Not gPaymentLoaded Then BuildPaymentCache
    If IsEmpty(gArrPayment) Then cCount = 0: Exit Sub

    Dim dictHasPay As Object
    Set dictHasPay = CreateObject("Scripting.Dictionary")
    Dim i As Long
    For i = 1 To UBound(gArrPayment, 1)
        Dim cid_p As String
        cid_p = Trim$(CStr(gArrPayment(i, 3)))
        If cid_p = "" Then GoTo NEXT_FP
        Dim payDate As Variant
        payDate = gArrPayment(i, 17)
        If Not IsValidDMY(payDate) Then GoTo NEXT_FP
        Dim paidAmt As Double
        paidAmt = val(CStr(gArrPayment(i, 13)))
        If paidAmt = 0 Then GoTo NEXT_FP
        Dim pd As Date
        pd = ParseDMY(payDate)
        If filterMode = "monthly" Then
            If Month(pd) <> filterMonth Or Year(pd) <> filterYear Then GoTo NEXT_FP
        ElseIf filterMode = "yearly" Then
            If Year(pd) <> filterYear Then GoTo NEXT_FP
        End If
        dictHasPay(cid_p) = True
NEXT_FP:
    Next i

    Dim newList() As String
    ReDim newList(0 To cCount - 1)
    Dim newCount As Long
    newCount = 0
    Dim j As Long
    For j = 0 To cCount - 1
        If dictHasPay.exists(contractList(j)) Then
            newList(newCount) = contractList(j)
            newCount = newCount + 1
        End If
    Next j
    contractList = newList
    cCount = newCount
End Sub

'================================================================
' FILTER: Only keep contracts signed in the period
'================================================================
Private Sub FilterListBySigningDate(contractList() As String, ByRef cCount As Long, _
                                     ByVal filterMode As String, ByVal filterMonth As Long, _
                                     ByVal filterYear As Long)
    If IsEmpty(gArrContract) Or gDictContract Is Nothing Then cCount = 0: Exit Sub
    Dim newList() As String
    ReDim newList(0 To cCount - 1)
    Dim newCount As Long
    newCount = 0
    Dim j As Long
    For j = 0 To cCount - 1
        Dim cid_s As String
        cid_s = contractList(j)
        If Not gDictContract.exists(cid_s) Then GoTo NEXT_SD
        Dim rIdx As Long
        rIdx = gDictContract(cid_s)
        Dim sigDate As Variant
        sigDate = gArrContract(rIdx, 4)
        If Not IsValidDMY(sigDate) Then GoTo NEXT_SD
        Dim sd As Date
        sd = ParseDMY(sigDate)
        Dim keep As Boolean
        keep = False
        If filterMode = "monthly" Then
            keep = (Month(sd) = filterMonth And Year(sd) = filterYear)
        ElseIf filterMode = "yearly" Then
            keep = (Year(sd) = filterYear)
        End If
        If keep Then
            newList(newCount) = cid_s
            newCount = newCount + 1
        End If
NEXT_SD:
    Next j
    contractList = newList
    cCount = newCount
End Sub

