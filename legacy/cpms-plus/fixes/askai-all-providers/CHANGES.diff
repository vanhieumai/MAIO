+Private Function GitHubRetirementMessage() As String
+    GitHubRetirementMessage = "GitHub Models retired on 30 July 2026. Its inference API and catalog are no longer available." & _
+        vbCrLf & "Your saved key and notes are retained. Choose another provider key to chat." & _
+        vbCrLf & "GitHub Copilot is a separate service." & vbCrLf & "https://docs.github.com/en/github-models"
+End Function
+
+Private Function CatalogChatModel(ByVal provider As String, ByVal modelId As String) As Boolean
+    Dim modelLower As String, excluded As Variant, word As Variant
+    modelLower = LCase$(modelId)
+    excluded = Array("embedding", "embed", "rerank", "reward", "guard", "safety", "whisper", _
+        "audio", "tts", "transcribe", "realtime", "live", "image", "moderation", "dall-e", _
+        "deep-research", "codex", "instruct-0914", "gpt-3.5-turbo-instruct")
+    For Each word In excluded
+        If InStr(1, modelLower, CStr(word), vbBinaryCompare) > 0 Then Exit Function
+    Next word
+    Select Case provider
+        Case "GROQ": CatalogChatModel = GroqChatModel(modelId)
+        Case "OPENAI"
+            If InStr(modelLower, "-pro") > 0 Then Exit Function
+            CatalogChatModel = (Left$(modelLower, 4) = "gpt-" Or modelLower = "chat-latest" Or _
+                Left$(modelLower, 3) = "o3-" Or modelLower = "o3" Or Left$(modelLower, 3) = "o4-")
+        Case "GEMINI"
+            CatalogChatModel = (Left$(modelLower, 7) = "gemini-" Or Left$(modelLower, 6) = "gemma-")
+        Case "NVIDIA"
+            CatalogChatModel = (InStr(modelLower, "nemotron") > 0 Or InStr(modelLower, "deepseek") > 0 Or _
+                InStr(modelLower, "llama") > 0 Or InStr(modelLower, "qwen") > 0 Or _
+                InStr(modelLower, "glm") > 0 Or InStr(modelLower, "gpt-oss") > 0 Or _
+                InStr(modelLower, "kimi") > 0 Or InStr(modelLower, "minimax") > 0 Or InStr(modelLower, "mistral") > 0)
+        Case "CEREBRAS"
+            CatalogChatModel = (InStr(modelLower, "gpt-oss") > 0 Or InStr(modelLower, "qwen") > 0 Or _
+                InStr(modelLower, "llama") > 0 Or InStr(modelLower, "glm") > 0)
+    End Select
+End Function
+
+Private Function KnownModelVision(ByVal provider As String, ByVal modelId As String) As Boolean
+    Select Case provider
+        Case "OPENAI"
+            KnownModelVision = (Left$(modelId, 6) = "gpt-6-" Or Left$(modelId, 8) = "gpt-6.1-" Or _
+                Left$(modelId, 7) = "gpt-4.1" Or Left$(modelId, 6) = "gpt-4o")
+        Case "GEMINI"
+            KnownModelVision = (Left$(modelId, 7) = "gemini-" And CatalogChatModel(provider, modelId))
+        Case "GROQ": KnownModelVision = (modelId = "qwen/qwen3.8-27b")
+        Case "OPENROUTER": KnownModelVision = (modelId = "openrouter/free")
+        ' Unknown model capabilities stay text-only; do not infer vision from a deployment name.
+    End Select
+End Function
+
+Private Function FetchModelEntries(ByVal provider As String, ByVal URL As String) As Collection
+    Dim result As New Collection, raw As String, doc As Object, entries As Object, entry As Object
+    Dim pageToken As String, seen As Object, pageNumber As Long, i As Long, detail As String
+    Set seen = CreateObject("Scripting.Dictionary")
+    Do
+        If mCancelled Then Err.Raise 5, "AskAI", "Request cancelled."
+        raw = RequestJson("GET", URL, GetApiKey(), "", 30)
+        detail = ApiErrorMessage(raw)
+        If detail <> "" Then Err.Raise 5, "AskAI", detail
+        Set doc = AIJsonParse(raw)
+        If provider = "GEMINI" Then
+            Set entries = AIJsonChild(doc, "models")
+        Else
+            Set entries = AIJsonChild(doc, "data")
+        End If
+        For i = 1 To AIJsonCount(entries)
+            Set entry = AIJsonChild(entries, i)
+            result.Add entry
+        Next i
+        pageToken = ""
+        If provider = "GEMINI" Then pageToken = AIJsonText(AIJsonChild(doc, "nextPageToken"))
+        If pageToken = "" Then Exit Do
+        pageNumber = pageNumber + 1
+        If pageNumber > 50 Or seen.Exists(pageToken) Then Err.Raise 5, "AskAI", "Invalid model catalog pagination."
+        seen.Add pageToken, True
+        URL = "https://generativelanguage.googleapis.com/v1beta/models?pageSize=1000&pageToken=" & _
+            Application.WorksheetFunction.EncodeURL(pageToken)
+    Loop
+    Set FetchModelEntries = result
+End Function
+
+Private Function ValidDeploymentName(ByVal deployment As String) As Boolean
+    Dim i As Long, ch As String
+    If Len(deployment) = 0 Or Len(deployment) > 128 Then Exit Function
+    For i = 1 To Len(deployment)
+        ch = Mid$(deployment, i, 1)
+        If InStr(1, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.", ch, vbBinaryCompare) = 0 Then Exit Function
+    Next i
+    ValidDeploymentName = True
+End Function
+
+Private Function NormalizeAzureChatEndpoint(ByVal endpoint As String, ByVal deployment As String) As String
+    Dim pos As Long, pathEnd As Long
+    endpoint = Trim$(endpoint)
+    If Left$(LCase$(endpoint), 8) <> "https://" Then Err.Raise 5, "AskAI", "Enter an HTTPS Azure endpoint."
+    If InStr(endpoint, "@") > 0 Or InStr(endpoint, "#") > 0 Then Err.Raise 5, "AskAI", "Invalid Azure endpoint."
+    If Not ValidDeploymentName(deployment) Then Err.Raise 5, "AskAI", "Invalid Azure deployment name."
+    If InStr(1, endpoint, "/responses", vbTextCompare) > 0 Then
+        Err.Raise 5, "AskAI", "This form uses Chat Completions. Enter the Azure resource base URL or a chat/completions endpoint."
+    End If
+    pos = InStr(1, endpoint, "/deployments/", vbTextCompare)
+    If pos > 0 Then
+        pathEnd = InStr(pos + 13, endpoint, "/")
+        If pathEnd = 0 Or InStr(1, endpoint, "/chat/completions", vbTextCompare) = 0 Then
+            Err.Raise 5, "AskAI", "Use a complete legacy chat/completions URL with api-version, or the resource base URL."
+        End If
+        endpoint = Left$(endpoint, pos + 12) & deployment & Mid$(endpoint, pathEnd)
+    ElseIf InStr(1, endpoint, "/chat/completions", vbTextCompare) = 0 Then
+        If InStr(endpoint, "?") > 0 Then Err.Raise 5, "AskAI", "Use a base URL without query parameters."
+        Do While Right$(endpoint, 1) = "/"
+            endpoint = Left$(endpoint, Len(endpoint) - 1)
+        Loop
+        If Right$(LCase$(endpoint), 10) = "/openai/v1" Then
+            endpoint = endpoint & "/chat/completions"
+        Else
+            endpoint = endpoint & "/openai/v1/chat/completions"
+        End If
+    End If
+    NormalizeAzureChatEndpoint = endpoint
+End Function
+
+Private Function AzureChatEndpoint(ByVal deployment As String) As String
+    AzureChatEndpoint = NormalizeAzureChatEndpoint(GetAzureEndpoint(), deployment)
+End Function
+
+Private Sub ConfigureAzureModels()
+    On Error GoTo Failed
+    Dim endpoint As String, listText As String, names As Variant, item As Variant
+    Dim cleaned As String, deployment As String, checkedURL As String, uniqueNames As Object
+    endpoint = Trim$(InputBox("Azure resource base URL, /openai/v1/, or full chat/completions endpoint:", _
+        "Azure endpoint", GetAzureEndpoint()))
+    If endpoint = "" Then Exit Sub
+    listText = Trim$(InputBox("Enter your DEPLOYMENT names, separated by | (not base model names)." & vbCrLf & _
+        "These must already exist in your Azure resource.", "Azure deployments", GetAppSetting("azure_deployments_v3")))
+    If listText = "" Then Exit Sub
+    Set uniqueNames = CreateObject("Scripting.Dictionary")
+    names = Split(listText, "|")
+    For Each item In names
+        deployment = Trim$(CStr(item))
+        If Not ValidDeploymentName(deployment) Then Err.Raise 5, "AskAI", "Invalid deployment name: " & deployment
+        checkedURL = NormalizeAzureChatEndpoint(endpoint, deployment)
+        If Not uniqueNames.Exists(deployment) Then
+            uniqueNames.Add deployment, True
+            If cleaned <> "" Then cleaned = cleaned & "|"
+            cleaned = cleaned & deployment
+        End If
+    Next item
+    If Len(cleaned) > 30000 Then Err.Raise 5, "AskAI", "Too many deployment names."
+    SaveAzureEndpoint endpoint
+    SaveAppSetting "azure_deployments_v3", cleaned
+    UpdateProviderUI
+    Exit Sub
+Failed:
+    MsgBox "Azure setup: " & Err.Description, vbExclamation
+End Sub
