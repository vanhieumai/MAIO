+' Unique, real contract only: exclude group separator records.
+Private Function AssignmentContractRow(ByVal wb As Workbook, ByVal newID As String) As Long
+    Dim ws As Worksheet, r As Long, found As Long, hits As Long, key As String
+    If Len(Trim$(newID)) = 0 Then Exit Function
+    If UCase$(Left$(Trim$(newID), 6)) = "GROUP-" Then Exit Function
+    Set ws = wb.Worksheets("CONTRACT_DB")
+    For r = 2 To ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
+        key = Trim$(CStr(ws.Cells(r, "A").Value2))
+        If StrComp(key, newID, vbTextCompare) = 0 Then
+            found = r
+            hits = hits + 1
+        End If
+    Next r
+    If hits = 1 Then AssignmentContractRow = found
+End Function
+
+Private Function AssignmentContractInfo(ByVal wb As Workbook, ByVal r As Long) As String
+    With wb.Worksheets("CONTRACT_DB")
+        AssignmentContractInfo = "ContractID: " & CStr(.Cells(r, "A").Value2) & vbCrLf & _
+            "Sequence: " & CStr(.Cells(r, "X").Value2) & vbCrLf & _
+            "Contract / appendix: " & CStr(.Cells(r, "B").Value2) & vbCrLf & _
+            "Type: " & CStr(.Cells(r, "C").Value2) & vbCrLf & _
+            "Party B: " & CStr(.Cells(r, "H").Value2) & vbCrLf & _
+            "Scope: " & CStr(.Cells(r, "K").Value2) & vbCrLf & _
+            "Status: " & CStr(.Cells(r, "F").Value2)
+    End With
+End Function
+
+Private Sub mAssignContract_Click()
+    Dim wb As Workbook, ws As Worksheet, contracts As Worksheet, rowNo As Long
+    Dim docID As String, oldID As String, newID As String, r As Long, n As Long
+    On Error GoTo Failed
+    If Not ResolveReminderSelection(wb, ws, rowNo, docID, oldID) Then GoTo Changed
+    If ReminderContractExists(wb, oldID) Then GoTo Changed
+    If wb.ReadOnly Or ws.ProtectContents Then GoTo Changed
+    CreateContractPicker
+    mAssignDocID = docID
+    mAssignOldCID = oldID
+    mContractChoice.Clear
+    mConfirmAssign.Enabled = False
+    Set contracts = wb.Worksheets("CONTRACT_DB")
+    For r = 2 To contracts.Cells(contracts.Rows.Count, "A").End(xlUp).Row
+        newID = Trim$(CStr(contracts.Cells(r, "A").Value2))
+        If AssignmentContractRow(wb, newID) = r Then
+            mContractChoice.AddItem newID
+            n = mContractChoice.ListCount - 1
+            mContractChoice.List(n, 1) = CStr(contracts.Cells(r, "X").Value2) & " | " & _
+                CStr(contracts.Cells(r, "B").Value2) & " | " & CStr(contracts.Cells(r, "H").Value2)
+        End If
+    Next r
+    mContractPreview.Text = "DocumentID: " & docID & vbCrLf & "Old ContractID: " & oldID & vbCrLf & vbCrLf & _
+        "Select the new contract above and review its information before confirming."
+    mAssignPanel.Visible = True
+    mAssignPanel.ZOrder 0
+    mContractChoice.SetFocus
+    Exit Sub
+Changed:
+    MsgBox "The document or project has changed, or the data file cannot be edited. Refresh and try again.", vbExclamation, "Reminders"
+    UpdateReminderActions
+    Exit Sub
+Failed:
+    MsgBox "Cannot open contract selection: " & Err.Description, vbExclamation, "Reminders"
+    CloseContractPicker
+End Sub
+
+Private Sub mContractChoice_Change()
+    Dim wb As Workbook, ws As Worksheet, rowNo As Long, r As Long
+    Dim docID As String, oldID As String, newID As String
+    On Error GoTo Failed
+    mConfirmAssign.Enabled = False
+    If mContractChoice.ListIndex < 0 Then Exit Sub
+    If Not ResolveReminderSelection(wb, ws, rowNo, docID, oldID) Then GoTo Failed
+    If docID <> mAssignDocID Or oldID <> mAssignOldCID Then GoTo Failed
+    newID = CStr(mContractChoice.List(mContractChoice.ListIndex, 0))
+    r = AssignmentContractRow(wb, newID)
+    If r = 0 Then GoTo Failed
+    mContractPreview.Text = "DocumentID: " & docID & vbCrLf & "Old ContractID: " & oldID & vbCrLf & vbCrLf & AssignmentContractInfo(wb, r)
+    mConfirmAssign.Enabled = True
+    Exit Sub
+Failed:
+    If Not mContractPreview Is Nothing Then mContractPreview.Text = "Selection is no longer valid. Cancel and refresh."
+End Sub
+
+Private Sub mCancelAssign_Click()
+    CloseContractPicker
+End Sub
+
+Private Sub mConfirmAssign_Click()
+    Dim wb As Workbook, ws As Worksheet, confirmedWB As Workbook
+    Dim rowNo As Long, r As Long, docID As String, oldID As String, newID As String
+    Dim info As String, docNo As String, changed As Boolean, saved As Boolean, errorText As String
+    On Error GoTo Failed
+    If mContractChoice.ListIndex < 0 Then Exit Sub
+    If Not ResolveReminderSelection(wb, ws, rowNo, docID, oldID) Then GoTo Stale
+    If docID <> mAssignDocID Or oldID <> mAssignOldCID Then GoTo Stale
+    If ReminderContractExists(wb, oldID) Then GoTo Stale
+    If wb.ReadOnly Or ws.ProtectContents Then GoTo Stale
+    newID = CStr(mContractChoice.List(mContractChoice.ListIndex, 0))
+    r = AssignmentContractRow(wb, newID)
+    If r = 0 Then GoTo Stale
+    info = AssignmentContractInfo(wb, r)
+    docNo = CStr(ws.Cells(rowNo, "D").Value2)
+    Set confirmedWB = wb
+    If MsgBox("Assign this document to the following contract?" & vbCrLf & _
+        "DocumentID: " & docID & vbCrLf & "Document: " & docNo & vbCrLf & _
+        "Old ContractID: " & oldID & vbCrLf & vbCrLf & info & vbCrLf & vbCrLf & _
+        "Only the contract link changes. Saving also saves other pending changes in this data file.", _
+        vbYesNo + vbQuestion + vbDefaultButton2, "Confirm contract assignment") <> vbYes Then Exit Sub
+    If Not ResolveReminderSelection(wb, ws, rowNo, docID, oldID) Then GoTo Stale
+    If Not (wb Is confirmedWB) Then GoTo Stale
+    If docID <> mAssignDocID Or oldID <> mAssignOldCID Then GoTo Stale
+    If CStr(ws.Cells(rowNo, "D").Value2) <> docNo Then GoTo Stale
+    If ReminderContractExists(wb, oldID) Then GoTo Stale
+    If wb.ReadOnly Or ws.ProtectContents Then GoTo Stale
+    r = AssignmentContractRow(wb, newID)
+    If r = 0 Then GoTo Stale
+    If AssignmentContractInfo(wb, r) <> info Then GoTo Stale
+    ws.Cells(rowNo, "B").Value2 = newID
+    changed = True
+    gDocLoaded = False
+    wb.Save
+    If Not wb.Saved Then Err.Raise vbObjectError + 2102, "frmReminder", "The data workbook was not saved."
+    saved = True
+    CloseContractPicker
+    BuildGlobalContractCache
+    BuildDocTrackerCache
+    LoadPendingList
+    ' Keep the repaired document selected if it still passes the current filters.
+    For r = 0 To lstPending.ListCount - 1
+        If CStr(lstPending.List(r, 7)) = docID Then
+            lstPending.ListIndex = r
+            lstPending_Click
+            Exit For
+        End If
+    Next r
+    MsgBox "Contract assigned and data file saved.", vbInformation, "Reminders"
+    Exit Sub
+Stale:
+    MsgBox "The document, contract or project has changed, or cannot be edited. Refresh and select again.", vbExclamation, "Reminders"
+    UpdateReminderActions
+    Exit Sub
+Failed:
+    errorText = Err.Description
+    On Error Resume Next
+    CloseContractPicker
+    If changed Then
+        gDocLoaded = False
+        BuildGlobalContractCache
+        BuildDocTrackerCache
+        LoadPendingList
+    End If
+    UpdateReminderActions
+    On Error GoTo 0
+    If saved Then
+        MsgBox "Assignment was saved, but refreshing failed: " & errorText, vbExclamation, "Reminders"
+    ElseIf changed Then
+        MsgBox "ContractID changed in memory but saving failed. Keep the data workbook open and resolve the save error: " & errorText, vbCritical, "Reminders"
+    Else
+        MsgBox "ContractID was not changed: " & errorText, vbExclamation, "Reminders"
+    End If
+End Sub
