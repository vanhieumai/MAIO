+Private Function ContractSearchText(ByVal value As Variant) As String
+    If IsError(value) Or IsNull(value) Or IsEmpty(value) Then Exit Function
+    ContractSearchText = LCase$(VN_NoSign(Trim$(CStr(value))))
+End Function
+
+Private Sub ClearFilteredContractDetails()
+    Dim oldSuppress As Boolean, ctrl As Object
+    oldSuppress = suppressPaymentSelect
+    suppressPaymentSelect = True
+    lstPayment.Clear
+    editingRow = 0: selectedLedgerRow = 0: lastPaymentIndex = -1
+    isEditMode = False
+    chkEditPayment.Value = False
+    btnUpdatePayment.Enabled = False
+    btnDeletePayment.Enabled = False
+    btnSave.Enabled = False
+    lblContractID.Caption = "": lblLedgerID.Caption = ""
+    lblCompany2.Caption = "": lblItemName.Caption = "": lblContractValue.Caption = ""
+    lblSumJ.Caption = "0": lblSumK.Caption = "0": lblSumL.Caption = "0"
+    lblSumM.Caption = "0": lblSumN.Caption = "0"
+    For Each ctrl In Me.Controls
+        If TypeName(ctrl) = "TextBox" Then
+            If ctrl.Name <> "txtSearch" Then ctrl.Value = ""
+        End If
+    Next ctrl
+    InitPlaceholders
+    suppressPaymentSelect = oldSuppress
+End Sub
+
+Private Sub txtSearch_KeyDown(ByVal KeyCode As MSForms.ReturnInteger, ByVal Shift As Integer)
+    If KeyCode = vbKeyReturn Then
+        KeyCode = 0
+        mContractKeyword = ContractSearchText(txtSearch.Value)
+        BuildContractComboAll
+    ElseIf KeyCode = vbKeyEscape Then
+        KeyCode = 0
+        txtSearch.Value = ""
+        mContractKeyword = ""
+        BuildContractComboAll
+    End If
+End Sub
+
+Private Sub txtSearch_MouseDown(ByVal Button As Integer, ByVal Shift As Integer, ByVal X As Single, ByVal Y As Single)
+    If Button <> 2 Then Exit Sub
+    Dim nowTime As Double, elapsed As Double
+    nowTime = Timer
+    elapsed = nowTime - mContractRightTime
+    If elapsed < 0 Then elapsed = elapsed + 86400
+    If mContractRightCount > 0 And elapsed < 0.5 Then
+        mContractRightCount = 0
+        txtSearch.Value = ""
+        mContractKeyword = ""
+        BuildContractComboAll
+    Else
+        mContractRightCount = 1
+        mContractRightTime = nowTime
+    End If
+End Sub
