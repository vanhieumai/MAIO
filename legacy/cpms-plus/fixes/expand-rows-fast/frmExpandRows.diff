+Private Sub ReleaseExpandMeasurement()
+    On Error Resume Next
+    If Not mMeasureShape Is Nothing Then mMeasureShape.Delete
+    Set mMeasureShape = Nothing
+    Set mHeightCache = Nothing
+    On Error GoTo 0
+End Sub
+
+Private Sub ExpandPulse(ByVal sheetName As String, ByVal rowNo As Long, ByVal lastRow As Long)
+    Dim nowTime As Double, delta As Double
+    nowTime = Timer
+    delta = nowTime - mLastYield
+    If delta < 0 Then delta = delta + 86400
+    If delta < 0.25 Then Exit Sub
+    Application.StatusBar = "Expand rows: " & sheetName & " | row " & rowNo & "/" & lastRow
+    mLastYield = nowTime
+    DoEvents
+End Sub
